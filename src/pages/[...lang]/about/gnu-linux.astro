---
import Layout from "../../../layouts/Layout.astro";
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";
import { languages, defaultLang } from "../../../i18n/ui";

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => {
    return {
      params: {
        lang: lang === defaultLang ? undefined : lang,
      },
    };
  });
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={`GNU/Linux - Swecha.org`}>
  <div
    class="pt-32 pb-16 px-6 sm:px-10 lg:px-16 container mx-auto min-h-[calc(100vh-4rem)]"
  >
    <div class="max-w-4xl">
      <div class="mb-10 inline-block">
        <a href={lang === defaultLang ? '/about' : `/${lang}/about`} class="btn btn-circle btn-ghost text-text-muted hover:text-primary-brand hover:bg-structural-borders/30" aria-label="Return to About">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
        </a>
      </div>
      <h1
        class="text-4xl md:text-6xl font-black text-text-main mb-6 tracking-tight"
      >
        GNU<span class="text-primary-brand">/Linux</span>
      </h1>
      <p class="text-xl text-text-muted mb-12 leading-relaxed">
        The core operating system that powers our vision of digital freedom and
        localized computing for everyone.
      </p>

      <div
        class="bg-secondary-bg border border-structural-borders p-8 rounded-2xl shadow-xl"
      >
        <h2 class="text-2xl font-bold text-text-main mb-4">
          Under Development
        </h2>
        <p class="text-text-muted">
          This section is currently being updated. Check back soon to learn more
          about our GNU/Linux initiatives, support, and resources.
        </p>
      </div>
    </div>
  </div>
</Layout>
