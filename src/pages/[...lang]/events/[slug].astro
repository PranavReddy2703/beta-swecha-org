---
// src/pages/[...lang]/events/[slug].astro
import Layout from "@layouts/Layout.astro";
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../../../i18n/utils";
import { languages, defaultLang } from "../../../i18n/ui";
import eventsData from "../../../data/events.json";

import Badge from "@components/atoms/Badge.astro";
import Button from "@components/atoms/Button.astro";
import EventInfoCard from "@components/molecules/EventInfoCard.astro";
import DiscussionTrackCard from "@components/molecules/DiscussionTrackCard.astro";
import HighlightCard from "@components/atoms/HighlightCard.astro";

export function getStaticPaths() {
  const paths = [];
  for (const lang of Object.keys(languages)) {
    for (const event of eventsData) {
      paths.push({
        params: {
          lang: lang === defaultLang ? undefined : lang,
          slug: event.slug,
        },
        props: { event },
      });
    }
  }
  return paths;
}

const { event } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// Split description into paragraphs
const aboutParagraphs = event.description.split("\n\n");

const infoCards = [
  { icon: "date" as const, label: "Date", value: event.date },
  { icon: "time" as const, label: "Time", value: event.time },
  { icon: "venue" as const, label: "Venue", value: event.venue },
  { icon: "mode" as const, label: "Mode", value: event.mode },
];
---

<Layout
  title={`${event.title} - Swecha.org`}
  description={event.shortDescription}
>
  <div
    class="relative min-h-screen text-text-main overflow-hidden pb-24 transition-colors duration-300"
  >
    <!-- DYNAMIC EVENT HERO SECTION -->
    <header
      class="relative w-full overflow-hidden bg-canvas-base border-b border-structural-borders/30"
    >
      <div class="absolute inset-0 pointer-events-none z-10 overflow-hidden">
        <div
          class="absolute -top-30 left-1/3 w-[500px] h-[350px] bg-primary-brand/15 blur-[130px] rounded-full"
        >
        </div>
        <div
          class="absolute bottom-0 right-1/4 w-[400px] h-[300px] bg-secondary-accent/10 blur-[110px] rounded-full"
        >
        </div>
      </div>

      <div
        class="relative w-full h-[60vh] min-h-[480px] md:h-[70vh] flex items-center justify-center"
      >
        <div class="absolute inset-0 z-0">
          {
            /*
            @CRITICAL: This component requests an above-the-fold 'fetchpriority="high"' override.
            NEVER render more than one instance of this component on a single page, and never copy 
            its fetchpriority attributes to secondary components.
          */
          }
          <img
            src={event.image}
            alt={event.title}
            fetchpriority="high"
            decoding="sync"
            class="w-full h-full object-cover object-center filter brightness-75 scale-102 transition-transform duration-[2000ms] group-hover:scale-100"
          />
          <div
            class="absolute inset-0 bg-gradient-to-b from-canvas-base/30 via-canvas-base/75 to-canvas-base z-10"
          >
          </div>
          <div
            class="absolute inset-0 bg-gradient-to-r from-canvas-base via-transparent to-canvas-base opacity-90 z-10"
          >
          </div>
        </div>

        <div
          class="relative z-20 max-w-5xl mx-auto px-4 text-center sm:px-6 lg:px-8 space-y-6 md:space-y-8 animate-fade-in"
        >
          <!-- Category Badge -->
          <div
            class="inline-flex justify-center transition-all duration-300 hover:scale-105"
          >
            <Badge label={`${event.category} EVENT`} variant="hero" />
          </div>

          <!-- Titles -->
          <div class="space-y-3">
            <h1
              class="text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight text-text-main leading-tight select-none"
            >
              {event.title}
            </h1>
            <p
              class="brand-gradient-text text-xl sm:text-2xl md:text-3xl font-semibold tracking-wide bg-gradient-to-r from-primary-brand via-hover-brand to-secondary-accent bg-clip-text text-transparent drop-shadow-[0_0_15px_rgba(0,212,255,0.4)]"
            >
              {event.subtitle}
            </p>
          </div>

          <!-- Short description -->
          <p
            class="max-w-2xl mx-auto text-base sm:text-lg text-text-muted leading-relaxed font-medium md:text-xl"
          >
            {event.shortDescription}
          </p>

          <!-- Action buttons -->
          <div
            class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2"
          >
            {
              !event.past && (
                <Button
                  href={event.registrationLink || "#"}
                  label="Register Now"
                  variant="primary"
                  class="w-full sm:w-auto px-8 py-4 shadow-[0_0_30px_rgba(0,212,255,0.25)] hover:shadow-[0_0_40px_rgba(0,212,255,0.4)]"
                />
              )
            }
            <Button
              href="#about-section"
              label="Read More About This Event"
              variant="secondary"
              class="w-full sm:w-auto px-8 py-4"
            />
          </div>
        </div>
      </div>
    </header>

    <!-- MAIN GRID LAYOUT -->
    <div
      class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-24 mt-12"
    >
      <!-- SECTION 2 — EVENT INFORMATION CARDS -->
      <section
        class="scroll-reveal-section opacity-0 translate-y-8 transition-all duration-700 ease-out"
      >
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {
            infoCards.map((card) => (
              <EventInfoCard
                icon={card.icon}
                label={card.label}
                value={card.value}
              />
            ))
          }
        </div>
      </section>

      <!-- SECTION 3 — ABOUT EVENT -->
      <section
        id="about-section"
        class="scroll-reveal-section opacity-0 translate-y-8 transition-all duration-700 ease-out"
      >
        <div
          class="rounded-3xl border border-structural-borders/60 bg-card-bg/25 backdrop-blur-md p-8 md:p-12 shadow-2xl relative overflow-hidden"
        >
          <div
            class="absolute -left-10 -bottom-10 w-48 h-48 bg-primary-brand/5 blur-3xl rounded-full pointer-events-none"
          >
          </div>

          <div class="max-w-4xl mx-auto space-y-8">
            <div class="space-y-4">
              <h2
                class="text-3xl md:text-4xl font-black text-text-main tracking-tight"
              >
                About The Event
              </h2>
              <div
                class="h-[2px] w-24 bg-gradient-to-r from-primary-brand via-hover-brand to-secondary-accent"
              >
              </div>
            </div>

            <div
              class="space-y-6 text-base md:text-lg text-text-muted leading-relaxed font-medium"
            >
              {aboutParagraphs.map((paragraph) => <p>{paragraph}</p>)}
            </div>
          </div>
        </div>
      </section>

      <!-- SECTION 4 — DISCUSSION TRACKS (AGENDA) -->
      {
        event.agenda && event.agenda.length > 0 && (
          <section class="scroll-reveal-section opacity-0 translate-y-8 transition-all duration-700 ease-out space-y-10">
            <div class="flex items-center space-x-4">
              <h2 class="text-2xl md:text-3xl font-black text-text-main">
                Discussion Tracks
              </h2>
              <span class="h-[1px] flex-grow bg-gradient-to-r from-structural-borders via-structural-borders/30 to-transparent" />
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              {event.agenda.map((track, index) => (
                <DiscussionTrackCard
                  title={track.title}
                  description={track.description}
                  index={index}
                />
              ))}
            </div>
          </section>
        )
      }

      <!-- SECTION 5 — EVENT HIGHLIGHTS -->
      {
        event.highlights && event.highlights.length > 0 && (
          <section class="scroll-reveal-section opacity-0 translate-y-8 transition-all duration-700 ease-out space-y-10">
            <div class="flex items-center space-x-4">
              <h2 class="text-2xl md:text-3xl font-black text-text-main">
                Event Highlights
              </h2>
              <span class="h-[1px] flex-grow bg-gradient-to-r from-structural-borders via-structural-borders/30 to-transparent" />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
              {event.highlights.map((highlight) => (
                <HighlightCard title={highlight} />
              ))}
            </div>
          </section>
        )
      }
    </div>
  </div>
</Layout>

<script>
  // --- Scroll Reveal Animations ---
  const scrollObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.remove("opacity-0", "translate-y-8");
          entry.target.classList.add("opacity-100", "translate-y-0");
          scrollObserver.unobserve(entry.target);
        }
      });
    },
    {
      threshold: 0.05,
    },
  );

  document.querySelectorAll(".scroll-reveal-section").forEach((section) => {
    scrollObserver.observe(section);
  });
</script>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>
