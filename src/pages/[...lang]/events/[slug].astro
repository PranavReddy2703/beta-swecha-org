---
// src/pages/[...lang]/events/[slug].astro
import Layout from '@layouts/Layout.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../../i18n/utils';
import { languages, defaultLang } from '../../../i18n/ui';
import eventsData from '../../../data/events.json';

import Badge from '@components/atoms/Badge.astro';
import Button from '@components/atoms/Button.astro';
import EventInfoCard from '@components/events/EventInfoCard.astro';
import DiscussionTrackCard from '@components/events/DiscussionTrackCard.astro';
import HighlightCard from '@components/events/HighlightCard.astro';

export function getStaticPaths() {
  const paths = [];
  for (const lang of Object.keys(languages)) {
    for (const event of eventsData) {
      paths.push({
        params: {
          lang: lang === defaultLang ? undefined : lang,
          slug: event.slug,
        },
        props: { event },
      });
    }
  }
  return paths;
}

const { event } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// Split description into paragraphs
const aboutParagraphs = event.description.split('\n\n');

const infoCards = [
  { icon: 'date' as const, label: 'Date', value: event.date },
  { icon: 'time' as const, label: 'Time', value: event.time },
  { icon: 'venue' as const, label: 'Venue', value: event.venue },
  { icon: 'mode' as const, label: 'Mode', value: event.mode },
];
---

<Layout title={`${event.title} - Swecha.org`} description={event.shortDescription}>
  <div class="relative min-h-screen text-text-main overflow-hidden pb-24 transition-colors duration-300">
    

    <!-- DYNAMIC EVENT HERO SECTION -->
    <header class="relative w-full overflow-hidden bg-canvas-base border-b border-structural-borders/30">
      <div class="absolute inset-0 pointer-events-none z-10 overflow-hidden">
        <div class="absolute -top-30 left-1/3 w-[500px] h-[350px] bg-primary-brand/15 blur-[130px] rounded-full"></div>
        <div class="absolute bottom-0 right-1/4 w-[400px] h-[300px] bg-secondary-accent/10 blur-[110px] rounded-full"></div>
      </div>

      <div class="relative w-full h-[60vh] min-h-[480px] md:h-[70vh] flex items-center justify-center">
        <div class="absolute inset-0 z-0">
          <img 
            src={event.image} 
            alt={event.title} 
            class="w-full h-full object-cover object-center filter brightness-75 scale-102 transition-transform duration-[2000ms] group-hover:scale-100"
          />
          <div class="absolute inset-0 bg-gradient-to-b from-canvas-base/30 via-canvas-base/75 to-canvas-base z-10"></div>
          <div class="absolute inset-0 bg-gradient-to-r from-canvas-base via-transparent to-canvas-base opacity-90 z-10"></div>
        </div>

        <div class="relative z-20 max-w-5xl mx-auto px-4 text-center sm:px-6 lg:px-8 space-y-6 md:space-y-8 animate-fade-in">
          <!-- Category Badge -->
          <div class="inline-flex justify-center transition-all duration-300 hover:scale-105">
            <Badge label={`${event.category} EVENT`} variant="hero" />
          </div>

          <!-- Titles -->
          <div class="space-y-3">
            <h1 class="text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight text-text-main leading-tight select-none">
              {event.title}
            </h1>
            <p class="text-xl sm:text-2xl md:text-3xl font-semibold tracking-wide bg-gradient-to-r from-primary-brand via-hover-brand to-secondary-accent bg-clip-text text-transparent drop-shadow-[0_0_15px_rgba(0,212,255,0.4)]">
              {event.subtitle}
            </p>
          </div>

          <!-- Short description -->
          <p class="max-w-2xl mx-auto text-base sm:text-lg text-text-muted leading-relaxed font-medium md:text-xl">
            {event.shortDescription}
          </p>

          <!-- Action buttons -->
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
            {!event.past && (
              <Button 
                href="#register-section" 
                label="Register Now" 
                variant="primary" 
                class="w-full sm:w-auto px-8 py-4 shadow-[0_0_30px_rgba(0,212,255,0.25)] hover:shadow-[0_0_40px_rgba(0,212,255,0.4)]"
              />
            )}
            <Button 
              href="#about-section" 
              label="Read More" 
              variant="secondary" 
              class="w-full sm:w-auto px-8 py-4"
            />
          </div>
        </div>
      </div>
    </header>

    <!-- MAIN GRID LAYOUT -->
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-24 mt-12">
      
      <!-- SECTION 2 — EVENT INFORMATION CARDS -->
      <section class="scroll-reveal-section opacity-0 translate-y-8 transition-all duration-700 ease-out">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {infoCards.map((card) => (
            <EventInfoCard icon={card.icon} label={card.label} value={card.value} />
          ))}
        </div>
      </section>

      <!-- SECTION 3 — ABOUT EVENT -->
      <section id="about-section" class="scroll-reveal-section opacity-0 translate-y-8 transition-all duration-700 ease-out">
        <div class="rounded-3xl border border-structural-borders/60 bg-card-bg/25 backdrop-blur-md p-8 md:p-12 shadow-2xl relative overflow-hidden">
          <div class="absolute -left-10 -bottom-10 w-48 h-48 bg-primary-brand/5 blur-3xl rounded-full pointer-events-none"></div>
          
          <div class="max-w-4xl mx-auto space-y-8">
            <div class="space-y-4">
              <h2 class="text-3xl md:text-4xl font-black text-text-main tracking-tight">
                About The Event
              </h2>
              <div class="h-[2px] w-24 bg-gradient-to-r from-primary-brand via-hover-brand to-secondary-accent"></div>
            </div>

            <div class="space-y-6 text-base md:text-lg text-text-muted leading-relaxed font-medium">
              {aboutParagraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- SECTION 4 — DISCUSSION TRACKS (AGENDA) -->
      {event.agenda && event.agenda.length > 0 && (
        <section class="scroll-reveal-section opacity-0 translate-y-8 transition-all duration-700 ease-out space-y-10">
          <div class="flex items-center space-x-4">
            <h2 class="text-2xl md:text-3xl font-black text-text-main">
              Discussion Tracks
            </h2>
            <span class="h-[1px] flex-grow bg-gradient-to-r from-structural-borders via-structural-borders/30 to-transparent"></span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {event.agenda.map((track, index) => (
              <DiscussionTrackCard title={track.title} description={track.description} index={index} />
            ))}
          </div>
        </section>
      )}

      <!-- SECTION 5 — EVENT HIGHLIGHTS -->
      {event.highlights && event.highlights.length > 0 && (
        <section class="scroll-reveal-section opacity-0 translate-y-8 transition-all duration-700 ease-out space-y-10">
          <div class="flex items-center space-x-4">
            <h2 class="text-2xl md:text-3xl font-black text-text-main">
              Event Highlights
            </h2>
            <span class="h-[1px] flex-grow bg-gradient-to-r from-structural-borders via-structural-borders/30 to-transparent"></span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {event.highlights.map((highlight) => (
              <HighlightCard title={highlight} />
            ))}
          </div>
        </section>
      )}

      <!-- SECTION 6 — REGISTRATION CTA -->
      {!event.past && (
        <section id="register-section" class="scroll-reveal-section opacity-0 translate-y-8 transition-all duration-700 ease-out">
          <div class="relative rounded-3xl border border-primary-brand/35 bg-gradient-to-b from-[#111827]/80 to-[#080B10]/95 p-8 md:p-16 text-center overflow-hidden shadow-[0_0_50px_rgba(0,212,255,0.08)]">
            <div class="absolute -top-20 left-1/2 -translate-x-1/2 w-[500px] h-[200px] bg-primary-brand/15 blur-[100px] rounded-full pointer-events-none"></div>

            <div class="relative z-10 max-w-2xl mx-auto space-y-6 md:space-y-8">
              <h2 class="text-3xl md:text-5xl font-black text-text-main tracking-tight">
                Join the Consultation
              </h2>
              <p class="text-base md:text-xl text-text-muted leading-relaxed">
                Be part of shaping the future of {event.category} innovation. Register to reserve your seat at {event.venue}.
              </p>

              <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
                <button 
                  id="cta-register-btn" 
                  class="w-full sm:w-auto inline-flex items-center justify-center rounded-lg bg-primary-brand px-8 py-4 text-base font-bold text-slate-950 shadow-lg shadow-primary-brand/20 transition-all duration-300 hover:bg-hover-brand hover:shadow-hover-brand/35 hover:-translate-y-0.5 active:translate-y-0 cursor-pointer"
                >
                  Register Now
                </button>
                <Button href="#about-section" label="Read More" variant="secondary" class="w-full sm:w-auto px-8 py-4" />
              </div>
            </div>
          </div>
        </section>
      )}

    </div>
  </div>

  <!-- INLINE DIALOG REGISTRATION MODAL -->
  {!event.past && (
    <dialog id="reg-dialog" class="fixed inset-0 z-50 bg-black/85 backdrop-blur-md p-4 w-full h-full flex items-center justify-center border-none hidden opacity-0 transition-opacity duration-300">
      <div class="relative w-full max-w-lg rounded-2xl border border-primary-brand/25 bg-[#1B2432]/95 p-6 md:p-10 shadow-2xl text-left scale-95 transition-transform duration-300" id="reg-modal-content">
        
        <button id="close-dialog" class="absolute top-4 right-4 text-text-muted hover:text-primary-brand transition-colors p-2 cursor-pointer" aria-label="Close modal">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>

        <div class="space-y-2 mb-6">
          <h3 class="text-2xl md:text-3xl font-black text-text-main">
            Register Now
          </h3>
          <p class="text-sm text-text-muted">
            {event.title} &mdash; {event.venue}
          </p>
        </div>

        <form id="event-reg-form" class="space-y-4">
          <div class="space-y-1.5">
            <label for="reg-name" class="text-xs font-semibold uppercase tracking-wider text-text-muted">Full Name</label>
            <input type="text" id="reg-name" required class="w-full rounded-lg bg-canvas-base border border-structural-borders px-4 py-3 text-text-main outline-none focus:border-primary-brand focus:ring-1 focus:ring-primary-brand/30 transition-all font-medium" placeholder="John Doe" />
          </div>

          <div class="space-y-1.5">
            <label for="reg-email" class="text-xs font-semibold uppercase tracking-wider text-text-muted">Email Address</label>
            <input type="email" id="reg-email" required class="w-full rounded-lg bg-canvas-base border border-structural-borders px-4 py-3 text-text-main outline-none focus:border-primary-brand focus:ring-1 focus:ring-primary-brand/30 transition-all font-medium" placeholder="john@example.com" />
          </div>

          <div class="space-y-1.5">
            <label for="reg-org" class="text-xs font-semibold uppercase tracking-wider text-text-muted">Organization / Institution</label>
            <input type="text" id="reg-org" required class="w-full rounded-lg bg-canvas-base border border-structural-borders px-4 py-3 text-text-main outline-none focus:border-primary-brand focus:ring-1 focus:ring-primary-brand/30 transition-all font-medium" placeholder="Institution / Company" />
          </div>

          <button type="submit" class="w-full mt-4 inline-flex items-center justify-center rounded-lg bg-primary-brand py-3.5 text-base font-bold text-slate-950 shadow-lg shadow-primary-brand/20 transition-all duration-300 hover:bg-hover-brand hover:shadow-hover-brand/30 hover:-translate-y-0.5 active:translate-y-0 cursor-pointer">
            Complete Registration
          </button>
        </form>

        <div id="success-message" class="hidden flex flex-col items-center justify-center py-8 text-center space-y-4">
          <div class="w-16 h-16 rounded-full bg-secondary-accent/15 text-secondary-accent flex items-center justify-center border border-secondary-accent/30 shadow-[0_0_20px_rgba(77,255,184,0.15)] animate-bounce">
            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <div class="space-y-2">
            <h4 class="text-2xl font-black text-text-main">Registration Confirmed!</h4>
            <p class="text-sm text-text-muted max-w-sm">
              Thank you for registering. A confirmation pass has been sent to your email. We look forward to seeing you at {event.venue}!
            </p>
          </div>
          <button id="success-done" class="inline-flex items-center justify-center rounded-lg bg-secondary-accent px-6 py-2.5 text-sm font-bold text-slate-950 transition duration-200 hover:bg-emerald-400 mt-4 cursor-pointer">
            Done
          </button>
        </div>
      </div>
    </dialog>
  )}
</Layout>

<script>
  // --- Scroll Reveal Animations ---
  const scrollObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.remove('opacity-0', 'translate-y-8');
        entry.target.classList.add('opacity-100', 'translate-y-0');
        scrollObserver.unobserve(entry.target);
      }
    });
  }, {
    threshold: 0.05
  });

  document.querySelectorAll('.scroll-reveal-section').forEach(section => {
    scrollObserver.observe(section);
  });

  // --- Registration Dialog Interaction ---
  const regDialog = document.getElementById('reg-dialog') as HTMLDialogElement | null;
  const modalContent = document.getElementById('reg-modal-content');
  const openHeroBtn = document.querySelector('header a[href="#register-section"]');
  const openCtaBtn = document.getElementById('cta-register-btn');
  const closeBtn = document.getElementById('close-dialog');
  const doneBtn = document.getElementById('success-done');
  const regForm = document.getElementById('event-reg-form') as HTMLFormElement | null;
  const successMsg = document.getElementById('success-message');

  function openModal(e: Event) {
    if (regDialog && modalContent) {
      e.preventDefault();
      if (regForm) regForm.style.display = 'block';
      if (successMsg) successMsg.classList.add('hidden');
      if (regForm) regForm.reset();

      regDialog.classList.remove('hidden');
      setTimeout(() => {
        regDialog.classList.remove('opacity-0');
        regDialog.classList.add('opacity-100');
        modalContent.classList.remove('scale-95');
        modalContent.classList.add('scale-100');
      }, 10);
    }
  }

  function closeModal() {
    if (regDialog && modalContent) {
      regDialog.classList.remove('opacity-100');
      regDialog.classList.add('opacity-0');
      modalContent.classList.remove('scale-100');
      modalContent.classList.add('scale-95');
      
      setTimeout(() => {
        regDialog.classList.add('hidden');
      }, 300);
    }
  }

  if (openHeroBtn) openHeroBtn.addEventListener('click', openModal);
  if (openCtaBtn) openCtaBtn.addEventListener('click', openModal);
  if (closeBtn) closeBtn.addEventListener('click', closeModal);
  if (doneBtn) doneBtn.addEventListener('click', closeModal);

  if (regForm) {
    regForm.addEventListener('submit', (e) => {
      e.preventDefault();
      regForm.style.display = 'none';
      if (successMsg) successMsg.classList.remove('hidden');
    });
  }

  if (regDialog) {
    regDialog.addEventListener('click', (e) => {
      if (e.target === regDialog) {
        closeModal();
      }
    });
  }
</script>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>
