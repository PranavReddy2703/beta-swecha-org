---
// src/pages/[...lang]/contact.astro
import Layout from "@layouts/Layout.astro";
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../../i18n/utils";
import { languages, defaultLang } from "../../i18n/ui";
import ContactCard from "@molecules/ContactCard.astro";
import OpenStreetMap from "@molecules/OpenStreetMap.astro";
import ContactForm from "@organisms/ContactForm.astro";
import contactData from "@data/organisms/contact.json";

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => {
    return {
      params: {
        lang: lang === defaultLang ? undefined : lang,
      },
    };
  });
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const rawAddress = contactData.address.raw;
---

<Layout
  title={`${t("nav.contact")} - Swecha.org`}
  description={t("contact.subtitle")}
>
  <!-- Content wrapper with Electric Cyan Tech Matrix background decorations directly at page level -->
  <div
    class="relative min-h-[calc(100vh-4rem)] text-text-main transition-colors duration-300 pt-10 pb-16 overflow-hidden"
  >
    <!-- Container Content -->
    <div
      class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-12"
    >
      <!-- TWO-COLUMN MAIN CONTENT (Desktop 50/50, Mobile Stacked) -->
      <section
        class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch scroll-reveal-section opacity-0 translate-y-8 transition-all duration-700 ease-out"
      >
        <!-- Left Side: Contact Form -->
        <div class="w-full h-full order-2 lg:order-1">
          <ContactForm
            title={t("contact.form.title")}
            subtitle={t("contact.form.subtitle")}
            nameLabel={t("contact.form.name")}
            emailLabel={t("contact.form.email")}
            reasonLabel={t("contact.form.reason")}
            reasonOptions={[
              {
                value: "general",
                label: t("contact.form.reason.general") as string,
              },
              {
                value: "donation",
                label: t("contact.form.reason.donation") as string,
              },
              {
                value: "volunteer",
                label: t("contact.form.reason.volunteer") as string,
              },
              {
                value: "support",
                label: t("contact.form.reason.support") as string,
              },
              {
                value: "feedback",
                label: t("contact.form.reason.feedback") as string,
              },
            ]}
            subjectLabel={t("contact.form.subject")}
            messageLabel={t("contact.form.message")}
            sendButtonText={t("contact.form.send")}
          />
        </div>

        <div
          class="glass-white-card group relative overflow-hidden rounded-2xl border border-structural-borders bg-card-bg/40 p-5 md:p-6 backdrop-blur-xl transition-all duration-300 hover:border-primary-brand/30 hover:shadow-[0_0_25px_rgba(0,212,255,0.05)] flex flex-col w-full h-full order-1 lg:order-2"
        >
          <!-- Header with Title and Ghost Copy Button -->
          <div class="flex items-center justify-between">
            <h3
              class="text-xl md:text-2xl font-extrabold text-text-main group-hover:text-primary-brand transition-colors duration-300"
            >
              {t("contact.map.title")}
            </h3>

            <!-- Copy button container with hover tooltip -->
            <div class="relative tooltip-container">
              <button
                id="copy-address-header-btn"
                type="button"
                data-address={rawAddress}
                class="group/btn inline-flex items-center justify-center p-2 rounded-lg bg-transparent text-text-muted hover:text-primary-brand hover:bg-primary-brand/5 hover:scale-[1.02] hover:shadow-[0_0_10px_rgba(0,212,255,0.12)] focus:outline-none transition-all duration-200 cursor-pointer"
                aria-label="Copy Address"
              >
                <svg
                  class="h-4.5 w-4.5 transition-transform duration-200 group-hover/btn:scale-105"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
                  <path
                    d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
                  ></path>
                </svg>
              </button>

              <span
                class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2.5 py-1 bg-secondary-bg border border-structural-borders/80 text-[10px] text-text-muted font-bold tracking-wider uppercase rounded shadow-lg opacity-0 pointer-events-none transition-opacity duration-200 tooltip-text"
              >
                Copy address
              </span>
            </div>
          </div>

          <!-- Horizontal wrapped address display -->
          <p
            class="text-xs md:text-sm text-text-muted leading-relaxed flex items-start gap-1.5 font-medium select-all mt-2.5"
          >
            <span>{contactData.address.display}</span>
          </p>

          <!-- OpenStreetMap (upstream Leaflet-based interactive map) -->
          <div class="mt-5 w-full flex-grow flex flex-col">
            <OpenStreetMap />
          </div>

          <!-- Map Action Buttons Split Grid -->
          <div class="grid grid-cols-2 gap-4 mt-5">
            <!-- Open in OSM Button -->
            <a
              href="https://www.openstreetmap.org/?mlat=17.4360775&mlon=78.3612286#map=19/17.4360775/78.3612286"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center rounded-lg border border-primary-brand/25 bg-card-bg/30 hover:bg-card-bg/60 py-3.5 px-4 text-sm font-bold text-text-main leading-none backdrop-blur-md transition-all duration-200 hover:border-primary-brand/50 hover:text-primary-brand select-none"
            >
              <span>{t("contact.map.open_osm")}</span>
              <svg
                class="ml-2 h-4 w-4 shrink-0 text-primary-brand transition-transform duration-300 group-hover:scale-105"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"
                ></polygon>
                <line x1="9" x2="9" y1="3" y2="18"></line>
                <line x1="15" x2="15" y1="6" y2="21"></line>
              </svg>
            </a>

            <!-- Navigate Button -->
            <a
              href="https://maps.app.goo.gl/gZhRDrBn7yVvupWY8"
              target="_blank"
              rel="noopener noreferrer"
              class="shine-button w-full inline-flex items-center justify-center rounded-lg bg-primary-brand py-3.5 px-4 text-sm font-black text-[var(--primary-btn-text)] leading-none shadow-md shadow-primary-brand/10 transition-all duration-300 hover:bg-hover-brand hover:shadow-lg hover:shadow-primary-brand/20 active:scale-[0.99] focus:outline-none focus:ring-2 focus:ring-primary-brand select-none"
            >
              <span>{t("contact.map.navigate")}</span>
              <svg
                class="ml-2 h-4 w-4 shrink-0 transform transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 translate-y-[1.5px]"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
              </svg>
            </a>
          </div>
        </div>
      </section>

      <!-- QUICK CONTACT CHANNELS (3 cards below layout) -->
      <section
        class="opacity-0 translate-y-8 transition-all duration-700 ease-out scroll-reveal-section pt-2"
      >
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          {
            contactData.channels.map((channel, index) => (
              <ContactCard
                title={t(
                  `contact.${channel.icon === "Mail" ? "email" : channel.icon === "Phone" ? "phone" : "internship"}.title` as Parameters<
                    typeof t
                  >[0],
                )}
                value={t(
                  `contact.${channel.icon === "Mail" ? "email" : channel.icon === "Phone" ? "phone" : "internship"}.value` as Parameters<
                    typeof t
                  >[0],
                )}
                icon={
                  channel.icon as "MapPin" | "Mail" | "Phone" | "GraduationCap"
                }
                link={channel.link}
                index={index}
              />
            ))
          }
        </div>
      </section>
    </div>
  </div>

  <!-- Toast Notification Overlay -->
  <div
    id="toast-notification"
    class="fixed bottom-6 right-6 z-50 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none"
  >
    <div
      class="flex items-center space-x-2 bg-secondary-bg/95 border border-secondary-accent/40 text-text-main px-4 py-3 rounded-xl shadow-2xl shadow-secondary-accent/5 backdrop-blur-md"
    >
      <span class="text-secondary-accent">
        <svg
          class="h-4.5 w-4.5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </span>
      <span class="text-xs font-bold uppercase tracking-wider"
        >Address copied successfully</span
      >
    </div>
  </div>
</Layout>

<style>
  .tooltip-container:hover .tooltip-text {
    opacity: 1;
  }

  /* Button shine animation settings */
  .shine-button {
    position: relative;
    overflow: hidden;
  }

  .shine-button::after {
    content: "";
    position: absolute;
    top: -50%;
    left: -70%;
    width: 30%;
    height: 200%;
    background: linear-gradient(
      to right,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0.4) 50%,
      rgba(255, 255, 255, 0) 100%
    );
    transform: rotate(25deg);
    transition: none;
    pointer-events: none;
  }

  .shine-button:hover::after {
    left: 130%;
    transition: left 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
</style>

<script>
  // Copy to clipboard scripts
  const copyBtn = document.getElementById("copy-address-header-btn");
  const toast = document.getElementById("toast-notification");

  if (copyBtn && toast) {
    const addressToCopy = copyBtn.getAttribute("data-address") || "";

    copyBtn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(addressToCopy);

        toast.classList.remove("translate-y-20", "opacity-0");
        toast.classList.add("translate-y-0", "opacity-100");

        setTimeout(() => {
          toast.classList.remove("translate-y-0", "opacity-100");
          toast.classList.add("translate-y-20", "opacity-0");
        }, 3000);
      } catch (err) {
        console.error("Failed to copy text: ", err);
      }
    });
  }

  // Scroll Reveal triggers
  const scrollObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.remove("opacity-0", "translate-y-8");
          entry.target.classList.add("opacity-100", "translate-y-0");
          scrollObserver.unobserve(entry.target);
        }
      });
    },
    {
      threshold: 0.1,
    },
  );

  document.querySelectorAll(".scroll-reveal-section").forEach((section) => {
    scrollObserver.observe(section);
  });
</script>
