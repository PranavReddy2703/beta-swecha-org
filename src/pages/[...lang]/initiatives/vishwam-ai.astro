---
import Layout from '../../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';
import { languages, defaultLang } from '../../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => {
    return {
      params: {
        lang: lang === defaultLang ? undefined : lang,
      },
    };
  });
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={`VISHWAM.ai - Swecha.org`}>
  <div class="pt-32 pb-16 px-6 sm:px-10 lg:px-16 container mx-auto">
    <div class="max-w-4xl">
      <h1 class="text-4xl md:text-6xl font-black text-text-main mb-6 tracking-tight">
        VISHWAM<span class="text-primary-brand">.ai</span>
      </h1>
      <p class="text-xl text-text-muted mb-12 leading-relaxed">
        Shaping India's open and community-driven AI ecosystem. Our initiative focuses on creating a Telugu Large Language Model and promoting digital freedom through open technology.
      </p>
      
      <div class="bg-secondary-bg border border-structural-borders p-8 rounded-2xl shadow-xl">
        <h2 class="text-2xl font-bold text-text-main mb-4">Under Development</h2>
        <p class="text-text-muted">
          This section is currently being updated. Check back soon for detailed information about our open-source AI projects, datasets, and community contributions.
        </p>
      </div>
    </div>
  </div>
</Layout>
