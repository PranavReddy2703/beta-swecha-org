---
import Layout from "../../../layouts/Layout.astro";
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../../../i18n/utils";
import { languages, defaultLang } from "../../../i18n/ui";

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => {
    return {
      params: {
        lang: lang === defaultLang ? undefined : lang,
      },
    };
  });
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<Layout title={`Voluntary Computing - Swecha.org`}>
  <div class="pt-32 pb-24 px-6 sm:px-10 lg:px-16 container mx-auto">
    <div class="max-w-4xl mx-auto">
      <!-- Main Heading -->
      <h1
        class="vc-title text-4xl md:text-6xl font-black text-white mb-6 tracking-tight leading-tight text-center mx-auto animate-fade-in-up"
      >
        Voluntary Computing
      </h1>

      <!-- Subheading -->
      <h2
        class="vc-subtitle text-xl md:text-2xl font-bold text-white/90 mb-6 tracking-wide leading-snug text-center mx-auto animate-fade-in-up"
      >
        Empower Community AI with Your Idle Compute Power
      </h2>

      <!-- Description -->
      <p
        class="vc-desc text-lg md:text-xl text-white/90 mb-16 leading-relaxed text-center mx-auto animate-fade-in-up"
      >
        Voluntary computing enables open-source enthusiasts and community
        members to donate their spare computer resources (CPU, GPU, and memory)
        to public-interest projects. By sharing your idle hardware capacity, you
        directly contribute to training localized AI models (like Telugu LLMs),
        indexing corpus datasets, and running distributed tasks without relying
        on expensive, centralized cloud infrastructure.
      </p>

      <!-- How it works cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-20">
        <div
          class="glass-card glass-white-card border border-structural-borders p-6 rounded-2xl bg-card-bg/20 backdrop-blur-xl"
        >
          <div
            class="w-12 h-12 rounded-xl bg-primary-brand/10 border border-primary-brand/20 flex items-center justify-center text-primary-brand mb-4"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><rect width="16" height="16" x="4" y="4" rx="2"></rect><rect
                width="6"
                height="6"
                x="9"
                y="9"
                rx="1"></rect></svg
            >
          </div>
          <h3 class="text-lg font-bold text-text-main mb-2">Spare Resources</h3>
          <p class="text-text-muted text-sm leading-relaxed">
            The background worker utilizes idle CPU/GPU cores, ensuring minimal
            impact on your normal daily activities.
          </p>
        </div>

        <div
          class="glass-card glass-white-card border border-structural-borders p-6 rounded-2xl bg-card-bg/20 backdrop-blur-xl"
        >
          <div
            class="w-12 h-12 rounded-xl bg-secondary-accent/10 border border-secondary-accent/20 flex items-center justify-center text-secondary-accent mb-4"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path
                d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"
              ></path><path d="m9 12 2 2 4-4"></path></svg
            >
          </div>
          <h3 class="text-lg font-bold text-text-main mb-2">
            Open Source & Secure
          </h3>
          <p class="text-text-muted text-sm leading-relaxed">
            All code for the client and backend is fully open source, audited by
            the community, and focused strictly on transparent data computation.
          </p>
        </div>

        <div
          class="glass-card glass-white-card border border-structural-borders p-6 rounded-2xl bg-card-bg/20 backdrop-blur-xl"
        >
          <div
            class="w-12 h-12 rounded-xl bg-primary-brand/10 border border-primary-brand/20 flex items-center justify-center text-primary-brand mb-4"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path
                d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"
              ></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"
              ></polyline><line x1="12" x2="12" y1="22.08" y2="12"></line></svg
            >
          </div>
          <h3 class="text-lg font-bold text-text-main mb-2">
            Decentralized Power
          </h3>
          <p class="text-text-muted text-sm leading-relaxed">
            By building a localized, peer-to-peer compute grid, we reduce
            dependencies on global corporations and retain sovereignty over AI
            models.
          </p>
        </div>
      </div>

      <!-- Installation Guide Title -->
      <div class="mt-20 mb-12">
        <h2
          class="vc-section-title text-3xl font-black text-white tracking-tight flex items-center gap-3"
        >
          <svg
            class="w-8 h-8 text-primary-brand"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
            ></path>
          </svg>
          Device Registration & Setup Guide
        </h2>
        <p class="text-lg text-white/80 mt-4 leading-relaxed">
          Follow the terminal setup guide below to register your device and
          start receiving volunteer computing tasks.
        </p>
      </div>

      <!-- Setup prerequisites / notice -->
      <div
        class="glass-card glass-white-card border border-structural-borders/80 p-6 rounded-2xl bg-card-bg/20 backdrop-blur-xl mb-8"
      >
        <h4
          class="text-base font-bold text-text-main flex items-center gap-2 mb-2"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-amber-400"
            ><path
              d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"
            ></path><line x1="12" x2="12" y1="9" y2="13"></line><line
              x1="12"
              x2="12.01"
              y1="17"
              y2="17"></line></svg
          >
          Prerequisite: Install Python & <span class="underline">uv</span>
        </h4>
        <p class="text-text-muted text-sm leading-relaxed">
          The client uses <strong>uv</strong>, an extremely fast Python package
          installer and resolver. If you don't have it installed, run:
          <code
            class="prereq-box flex mt-2 p-3 font-mono text-xs justify-between items-center"
          >
            <span>curl -LsSf https://astral.sh/uv/install.sh | sh</span>
            <button
              class="copy-btn code-box-btn px-2.5 py-1 text-[11px] font-bold transition-all"
              data-code="curl -LsSf https://astral.sh/uv/install.sh | sh"
              >Copy</button
            >
          </code>
        </p>
      </div>

      <!-- Step by Step CLI Guide -->
      <div class="space-y-6">
        <!-- Step 1 -->
        <div
          class="glass-card glass-white-card border border-structural-borders p-8 rounded-2xl bg-card-bg/20 backdrop-blur-xl transition-all duration-300"
        >
          <div class="flex items-start gap-4">
            <span
              class="w-8 h-8 rounded-full bg-primary-brand/10 border border-primary-brand text-primary-brand flex items-center justify-center font-bold text-sm shrink-0"
              >1</span
            >
            <div class="flex-grow">
              <h3 class="text-xl font-bold text-text-main mb-2">
                Clone the Client CLI Repository
              </h3>
              <p class="text-text-muted text-sm leading-relaxed mb-4">
                Clone the official Swecha corpus client utility from the
                self-hosted repository. If you have already cloned it in the
                past, navigate to the directory and ensure it is updated.
              </p>
              <div class="code-box-container">
                <div class="code-box-header">
                  <span>TERMINAL</span>
                  <button
                    class="copy-btn code-box-btn transition-all"
                    data-code="git clone https://code.swecha.org/corpus/corpus-client-cli"
                  >
                    <svg
                      class="w-3.5 h-3.5"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                      ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3"
                      ></path></svg
                    >
                    Copy
                  </button>
                </div>
                <code class="code-box-body"
                  >git clone https://code.swecha.org/corpus/corpus-client-cli</code
                >
              </div>
            </div>
          </div>
        </div>

        <!-- Step 2 -->
        <div
          class="glass-card glass-white-card border border-structural-borders p-8 rounded-2xl bg-card-bg/20 backdrop-blur-xl transition-all duration-300"
        >
          <div class="flex items-start gap-4">
            <span
              class="w-8 h-8 rounded-full bg-primary-brand/10 border border-primary-brand text-primary-brand flex items-center justify-center font-bold text-sm shrink-0"
              >2</span
            >
            <div class="flex-grow">
              <h3 class="text-xl font-bold text-text-main mb-2">
                Navigate & Pull Latest Updates
              </h3>
              <p class="text-text-muted text-sm leading-relaxed mb-4">
                Switch to the project directory and fetch the latest commits
                from the master repository.
              </p>
              <div class="code-box-container">
                <div class="code-box-header">
                  <span>TERMINAL</span>
                  <button
                    class="copy-btn code-box-btn transition-all"
                    data-code="cd corpus-client-cli && git pull"
                  >
                    <svg
                      class="w-3.5 h-3.5"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                      ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3"
                      ></path></svg
                    >
                    Copy
                  </button>
                </div>
                <code class="code-box-body"
                  >cd corpus-client-cli<br />git pull</code
                >
              </div>
            </div>
          </div>
        </div>

        <!-- Step 3 -->
        <div
          class="glass-card glass-white-card border border-structural-borders p-8 rounded-2xl bg-card-bg/20 backdrop-blur-xl transition-all duration-300"
        >
          <div class="flex items-start gap-4">
            <span
              class="w-8 h-8 rounded-full bg-primary-brand/10 border border-primary-brand text-primary-brand flex items-center justify-center font-bold text-sm shrink-0"
              >3</span
            >
            <div class="flex-grow">
              <h3 class="text-xl font-bold text-text-main mb-2">
                Sync Dependencies
              </h3>
              <p class="text-text-muted text-sm leading-relaxed mb-4">
                Install all Python project dependencies and configure the
                virtual environment seamlessly using <code
                  class="p-1 bg-black/30 rounded font-mono text-xs"
                  >uv sync</code
                >.
              </p>
              <div class="code-box-container">
                <div class="code-box-header">
                  <span>TERMINAL</span>
                  <button
                    class="copy-btn code-box-btn transition-all"
                    data-code="uv sync"
                  >
                    <svg
                      class="w-3.5 h-3.5"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                      ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3"
                      ></path></svg
                    >
                    Copy
                  </button>
                </div>
                <code class="code-box-body">uv sync</code>
              </div>
            </div>
          </div>
        </div>

        <!-- Step 4 -->
        <div
          class="glass-card glass-white-card border border-structural-borders p-8 rounded-2xl bg-card-bg/20 backdrop-blur-xl transition-all duration-300"
        >
          <div class="flex items-start gap-4">
            <span
              class="w-8 h-8 rounded-full bg-primary-brand/10 border border-primary-brand text-primary-brand flex items-center justify-center font-bold text-sm shrink-0"
              >4</span
            >
            <div class="flex-grow">
              <h3 class="text-xl font-bold text-text-main mb-2">
                Login to Register Device
              </h3>
              <p class="text-text-muted text-sm leading-relaxed mb-4">
                Register your device details and link them securely to your
                volunteer-compute profile by initiating the login sequence.
              </p>
              <div class="code-box-container">
                <div class="code-box-header">
                  <span>TERMINAL</span>
                  <button
                    class="copy-btn code-box-btn transition-all"
                    data-code="uv run corpus-client login"
                  >
                    <svg
                      class="w-3.5 h-3.5"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                      ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3"
                      ></path></svg
                    >
                    Copy
                  </button>
                </div>
                <code class="code-box-body">uv run corpus-client login</code>
              </div>
            </div>
          </div>
        </div>

        <!-- Step 5 -->
        <div
          class="glass-card glass-white-card border border-structural-borders p-8 rounded-2xl bg-card-bg/20 backdrop-blur-xl transition-all duration-300"
        >
          <div class="flex items-start gap-4">
            <span
              class="w-8 h-8 rounded-full bg-primary-brand/10 border border-primary-brand text-primary-brand flex items-center justify-center font-bold text-sm shrink-0"
              >5</span
            >
            <div class="flex-grow">
              <h3 class="text-xl font-bold text-text-main mb-2">
                Start Volunteer Compute Tasks
              </h3>
              <p class="text-text-muted text-sm leading-relaxed mb-4">
                Initiate the volunteer computing routine. Your console will stay
                open to accept distributed jobs from the Swecha networks.
              </p>
              <div class="code-box-container">
                <div class="code-box-header">
                  <span>TERMINAL</span>
                  <button
                    class="copy-btn code-box-btn transition-all"
                    data-code="uv run corpus-client volunteer-compute"
                  >
                    <svg
                      class="w-3.5 h-3.5"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                      ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3"
                      ></path></svg
                    >
                    Copy
                  </button>
                </div>
                <code class="code-box-body"
                  >uv run corpus-client volunteer-compute</code
                >
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- FAQ Section -->
      <div class="mt-24">
        <h2
          class="faq-section-title text-2xl font-bold text-white mb-8 border-b border-structural-borders/50 pb-4"
        >
          Frequently Asked Questions
        </h2>
        <div class="space-y-6">
          <div>
            <h4 class="faq-question text-lg font-bold text-white mb-2">
              Can I control how much CPU/RAM is used?
            </h4>
            <p class="faq-answer text-white/80 text-sm leading-relaxed">
              Yes, the configuration files inside the client repository let you
              customize resource limitations. You can allocate a specific number
              of cores or hardware thresholds.
            </p>
          </div>
          <div>
            <h4 class="faq-question text-lg font-bold text-white mb-2">
              Is my data secure?
            </h4>
            <p class="faq-answer text-white/80 text-sm leading-relaxed">
              Absolutely. The client does not scan or access your personal
              files. It processes isolated computational datasets related to
              linguistics, text translation, and dataset generation sent from
              our central orchestrator.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Add copy to clipboard functionality
  document.querySelectorAll(".copy-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const code = btn.getAttribute("data-code");
      if (code) {
        navigator.clipboard.writeText(code);
        const originalText = btn.innerHTML;
        btn.innerHTML = `
          <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
          <span class="text-emerald-400 text-xs">Copied!</span>
        `;
        btn.classList.add("border-emerald-500/35", "bg-emerald-500/10");
        setTimeout(() => {
          btn.innerHTML = originalText;
          btn.classList.remove("border-emerald-500/35", "bg-emerald-500/10");
        }, 2000);
      }
    });
  });
</script>

<style>
  /* Code/Terminal Box Custom Styles */
  .code-box-container {
    position: relative;
    border-radius: 0.75rem;
    border: 1px solid var(--structural-borders);
    background-color: rgba(0, 0, 0, 0.4);
    padding: 1rem;
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono",
      "Courier New", monospace;
    font-size: 0.875rem;
    color: #cbd5e1;
    transition: all 0.3s ease;
  }

  .code-box-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
    font-size: 0.75rem;
    color: var(--text-muted);
    border-bottom: 1px solid
      color-mix(in srgb, var(--structural-borders) 30%, transparent);
    padding-bottom: 0.5rem;
  }

  .code-box-body {
    display: block;
    overflow-x: auto;
    white-space: pre;
    color: #e2e8f0;
  }

  .code-box-btn {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem 0.625rem;
    border-radius: 0.375rem;
    background-color: var(--structural-borders);
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .code-box-btn:hover {
    background-color: var(--primary-brand);
    color: var(--primary-btn-text);
  }

  /* Prerequisite Box custom styles */
  .prereq-box {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.5rem;
    padding: 0.75rem;
    border-radius: 0.5rem;
    border: 1px solid var(--structural-borders);
    background-color: rgba(0, 0, 0, 0.4);
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono",
      "Courier New", monospace;
    font-size: 0.75rem;
    color: var(--primary-brand);
  }

  /* Light mode overrides for high-contrast */
  :global(html[data-theme="light"]) .code-box-container {
    background-color: #f1f5f9 !important;
    border-color: #cbd5e1 !important;
    color: #1e293b !important;
  }

  :global(html[data-theme="light"]) .code-box-header {
    color: #64748b !important;
    border-bottom-color: #e2e8f0 !important;
  }

  :global(html[data-theme="light"]) .code-box-body {
    color: #0f172a !important;
  }

  :global(html[data-theme="light"]) .code-box-btn {
    background-color: #e2e8f0 !important;
    color: #475569 !important;
  }

  :global(html[data-theme="light"]) .code-box-btn:hover {
    background-color: var(--primary-brand) !important;
    color: #ffffff !important;
  }

  :global(html[data-theme="light"]) .prereq-box {
    background-color: #f8fafc !important;
    border-color: #cbd5e1 !important;
    color: #025a9e !important;
  }

  :global(html[data-theme="light"]) .prereq-box span {
    color: #1e293b !important;
  }

  /* Dark/default mode styles: blue-green gradient for main titles */
  .vc-title,
  .vc-section-title {
    background: linear-gradient(135deg, #00d4ff, #4dffb8) !important;
    -webkit-background-clip: text !important;
    -webkit-text-fill-color: transparent !important;
    text-shadow: none !important;
  }

  /* Light mode overrides to make text white with visual depth on the blue gradient background */
  :global(html[data-theme="light"]) .vc-title {
    color: #ffffff !important;
    -webkit-text-fill-color: #ffffff !important;
    background: none !important;
    text-shadow:
      0 2px 8px rgba(11, 30, 54, 0.35),
      0 4px 20px rgba(11, 30, 54, 0.25) !important;
  }

  :global(html[data-theme="light"]) .vc-subtitle {
    color: rgba(255, 255, 255, 0.95) !important;
    text-shadow:
      0 2px 6px rgba(11, 30, 54, 0.3),
      0 4px 15px rgba(11, 30, 54, 0.2) !important;
  }

  :global(html[data-theme="light"]) .vc-desc {
    color: rgba(255, 255, 255, 0.95) !important;
    text-shadow:
      0 2px 6px rgba(11, 30, 54, 0.3),
      0 4px 15px rgba(11, 30, 54, 0.2) !important;
  }

  :global(html[data-theme="light"]) .vc-section-title {
    color: #ffffff !important;
    -webkit-text-fill-color: #ffffff !important;
    background: none !important;
    text-shadow:
      0 2px 8px rgba(11, 30, 54, 0.35),
      0 4px 20px rgba(11, 30, 54, 0.25) !important;
  }

  :global(html[data-theme="light"]) .faq-section-title {
    color: #ffffff !important;
    text-shadow:
      0 2px 6px rgba(11, 30, 54, 0.3),
      0 4px 15px rgba(11, 30, 54, 0.2) !important;
  }

  :global(html[data-theme="light"]) .faq-question {
    color: #ffffff !important;
