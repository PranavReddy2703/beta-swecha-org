---
import Layout from '../../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';
import { languages, defaultLang } from '../../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => {
    return {
      params: {
        lang: lang === defaultLang ? undefined : lang,
      },
    };
  });
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={`People's Health Initiative - Swecha.org`}>
  <!-- Main container with reduced top padding to eliminate excessive negative space -->
  <div class="pt-24 pb-20 px-4 sm:px-6 lg:px-8 container mx-auto">
    <div class="max-w-6xl mx-auto space-y-12">
      
      <!-- Hero Header Section with minimal vertical padding -->
      <section class="text-center max-w-3xl mx-auto space-y-4">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary-brand/10 border border-primary-brand/20 text-primary-brand text-xs font-semibold uppercase tracking-wider">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary-brand opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-primary-brand"></span>
          </span>
          People's Health
        </div>
        
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-black text-white tracking-tight leading-tight">
          People's Health Initiative
        </h1>
        <p class="text-base sm:text-lg text-white/80 max-w-2xl mx-auto leading-relaxed">
          A collaborative social initiative driven by volunteers from Swecha, ForIT, doctors, and citizens addressing the healthcare needs of underserved communities.
        </p>
      </section>

      <!-- Unified About Us Panel (Removes negative space by packing content in a single premium card) -->
      <section class="glass-white-card border border-structural-borders bg-card-bg/25 backdrop-blur-xl rounded-2xl p-6 sm:p-8 hover:border-primary-brand/20 transition-all duration-300">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 divide-y md:divide-y-0 md:divide-x divide-structural-borders/60">
          <div class="pb-6 md:pb-0 md:pr-8 space-y-3">
            <h3 class="text-lg sm:text-xl font-bold text-text-main flex items-center gap-2">
              <span class="h-4 w-1 rounded-full bg-primary-brand"></span>
              Who We Are
            </h3>
            <p class="text-sm text-text-muted leading-relaxed">
              People's Health is an initiative of volunteers working in various organizations that include Swecha, Forum of IT Professionals (ForIT), doctors, individuals, intellectuals and service minded concerning citizens.
            </p>
          </div>
          <div class="pt-6 md:pt-0 md:pl-8 space-y-3">
            <h3 class="text-lg sm:text-xl font-bold text-text-main flex items-center gap-2">
              <span class="h-4 w-1 rounded-full bg-secondary-accent"></span>
              Our Foundation & Objective
            </h3>
            <p class="text-sm text-text-muted leading-relaxed">
              Swecha and ForIT are Not for Profit organizations with the objective of promoting the Free Software Movement and providing support for IT employees. They have extended their work as non-profits to address the healthcare needs of the poor, who often face barriers to primary health care.
            </p>
          </div>
        </div>
      </section>

      <!-- Key Impact Areas (2x2 Grid replacing the vertical timeline to pack content tightly) -->
      <section class="space-y-6">
        <div class="flex items-center justify-between border-b border-structural-borders/40 pb-3">
          <h2 class="text-xl sm:text-2xl font-extrabold text-white tracking-tight flex items-center gap-2.5">
            <svg class="w-6 h-6 text-primary-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Our Work & Impact
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Card 1: COVID-19 Help-Line -->
          <div class="group/pillar glass-white-card relative overflow-hidden rounded-2xl border border-structural-borders bg-card-bg/20 p-6 backdrop-blur-xl transition-all duration-300 hover:border-primary-brand/35 hover:-translate-y-0.5 hover:shadow-md hover:shadow-primary-brand/5">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-primary-brand/10 flex items-center justify-center text-primary-brand shrink-0 transition-transform duration-300 group-hover/pillar:scale-110 group-hover/pillar:rotate-6">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.94.725l.548 2.2a1 1 0 01-.321.988l-1.305.98a10.582 10.582 0 004.872 4.872l.98-1.305a1 1 0 01.988-.321l2.2.548a1 1 0 01.725.94V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div class="space-y-1.5">
                <span class="text-xs font-black tracking-wider uppercase text-primary-brand">First wave COVID-19</span>
                <h3 class="text-base sm:text-lg font-bold text-text-main transition-colors group-hover/pillar:text-primary-brand">Medical Help-Line</h3>
                <p class="text-xs sm:text-sm text-text-muted leading-relaxed">
                  The first medical help-line during COVID-19 was an initiative of volunteers coming together. More than 56,000 people were treated, supplied with medicines, and extended other critical services.
                </p>
              </div>
            </div>
          </div>

          <!-- Card 2: COVID isolation centre -->
          <div class="group/pillar glass-white-card relative overflow-hidden rounded-2xl border border-structural-borders bg-card-bg/20 p-6 backdrop-blur-xl transition-all duration-300 hover:border-secondary-accent/35 hover:-translate-y-0.5 hover:shadow-md hover:shadow-secondary-accent/5">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-secondary-accent/10 flex items-center justify-center text-secondary-accent shrink-0 transition-transform duration-300 group-hover/pillar:scale-110 group-hover/pillar:-rotate-6">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
              </div>
              <div class="space-y-1.5">
                <span class="text-xs font-black tracking-wider uppercase text-secondary-accent">Second wave COVID-19</span>
                <h3 class="text-base sm:text-lg font-bold text-text-main transition-colors group-hover/pillar:text-secondary-accent">300-Bed Isolation Centre</h3>
                <p class="text-xs sm:text-sm text-text-muted leading-relaxed">
                  Established and operated a 300-bedded Covid isolation centre during the height of the second COVID wave to support patients and ease hospital backlogs.
                </p>
              </div>
            </div>
          </div>

          <!-- Card 3: Medical Camps -->
          <div class="group/pillar glass-white-card relative overflow-hidden rounded-2xl border border-structural-borders bg-card-bg/20 p-6 backdrop-blur-xl transition-all duration-300 hover:border-primary-brand/35 hover:-translate-y-0.5 hover:shadow-md hover:shadow-primary-brand/5">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-primary-brand/10 flex items-center justify-center text-primary-brand shrink-0 transition-transform duration-300 group-hover/pillar:scale-110 group-hover/pillar:rotate-6">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div class="space-y-1.5">
                <span class="text-xs font-black tracking-wider uppercase text-primary-brand">Ongoing Care</span>
                <h3 class="text-base sm:text-lg font-bold text-text-main transition-colors group-hover/pillar:text-primary-brand">Primary Medical Camps</h3>
                <p class="text-xs sm:text-sm text-text-muted leading-relaxed">
                  At the forefront of conducting medical camps, facilitating the treatment of 500-1000 members every month from slums, working poor, labourers, and senior citizens with no family support in Hyderabad.
                </p>
              </div>
            </div>
          </div>

          <!-- Card 4: Speciality Care -->
          <div class="group/pillar glass-white-card relative overflow-hidden rounded-2xl border border-structural-borders bg-card-bg/20 p-6 backdrop-blur-xl transition-all duration-300 hover:border-secondary-accent/35 hover:-translate-y-0.5 hover:shadow-md hover:shadow-secondary-accent/5">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-secondary-accent/10 flex items-center justify-center text-secondary-accent shrink-0 transition-transform duration-300 group-hover/pillar:scale-110 group-hover/pillar:-rotate-6">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
              </div>
              <div class="space-y-1.5">
                <span class="text-xs font-black tracking-wider uppercase text-secondary-accent">Vision & Speciality</span>
                <h3 class="text-base sm:text-lg font-bold text-text-main transition-colors group-hover/pillar:text-secondary-accent">Secondary & Vision Support</h3>
                <p class="text-xs sm:text-sm text-text-muted leading-relaxed">
                  Facilitated many cataract operations to solve vision problems and provided support for secondary and tertiary care, with doctors volunteering to help cure major ailments.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Get Involved Call To Action Card (Closes the page nicely with minimal spacing) -->
      <section class="glass-white-card relative overflow-hidden rounded-2xl border border-structural-borders bg-gradient-to-r from-primary-brand/10 to-secondary-accent/10 p-8 text-center space-y-6 hover:border-primary-brand/30 transition-all duration-300">
        <div class="absolute -right-20 -top-20 h-40 w-40 rounded-full bg-primary-brand/5 blur-3xl pointer-events-none"></div>
        
        <div class="max-w-2xl mx-auto space-y-4">
          <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
            Help Us Bridge the Healthcare Gap
          </h2>
          <p class="text-sm sm:text-base text-text-muted leading-relaxed">
            Support People's Health Initiative by volunteering at our camps, managing logistics, or contributing to provide medicine and care to the marginalized.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
          <a
            href="https://ehrs.peoples-health.in/register"
            target="_blank"
            rel="noopener noreferrer"
            class="shine-button inline-flex items-center justify-center rounded-xl bg-primary-brand py-3.5 px-8 text-sm font-black text-[var(--primary-btn-text)] leading-none shadow-md shadow-primary-brand/15 hover:bg-hover-brand hover:shadow-lg hover:shadow-primary-brand/25 transition-all duration-300 active:scale-[0.98]"
          >
            Volunteer Registration
          </a>
          <a
            href="/contact"
            class="inline-flex items-center justify-center rounded-xl border border-structural-borders bg-card-bg/60 hover:bg-card-bg/85 py-3.5 px-8 text-sm font-bold text-text-main leading-none backdrop-blur-md transition-all duration-200 hover:border-primary-brand/40 hover:text-primary-brand"
          >
            Contact the Team
          </a>
        </div>
      </section>

    </div>
  </div>
</Layout>
