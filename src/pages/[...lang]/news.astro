---
// src/pages/[...lang]/news.astro
import Layout from '@layouts/Layout.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';
import { languages, defaultLang } from '../../i18n/ui';
import BentoGrid from '@organisms/BentoGrid.astro';
import UpdateCard from '@molecules/UpdateCard.astro';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => {
    return {
      params: {
        lang: lang === defaultLang ? undefined : lang,
      },
    };
  });
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// Latest updates array
const latestUpdates = [
  {
    title: t('news.update1.headline'),
    description: t('news.update1.desc'),
    link: 'https://www.tripurastarnews.com/viswam-ai-and-sflc-in-release-draft-license-for-consultation-aimed-at-safeguarding-open-source-aiand-community-ownership/'
  },
  {
    title: t('news.update2.headline'),
    description: t('news.update2.desc'),
    link: 'https://www.meetup.com/swechafsmi/'
  },
  {
    title: t('news.update3.headline'),
    description: t('news.update3.desc'),
    link: 'https://freedommatters.in/untitled-8/'
  }
];
---

<Layout title={`${t('news.title')} - Swecha.org`} description={t('news.subtitle')}>
  
  <div class="relative min-h-[calc(100vh-4rem)] text-text-main transition-colors duration-300 pt-6 pb-16 overflow-hidden">

    <!-- Main Container -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-10">
      
      <!-- FEATURED BENTO NEWS GRID -->
      <section class="scroll-reveal-section opacity-0 translate-y-6 transition-all duration-500 ease-out pt-2">
        <BentoGrid t={t} />
      </section>

      <!-- LATEST UPDATES SECTION -->
      <section class="space-y-5 scroll-reveal-section opacity-0 translate-y-6 transition-all duration-500 ease-out">
        <div class="flex items-center space-x-3">
          <h2 class="latest-updates-title text-lg md:text-xl font-bold text-text-main select-none">
            {t('news.latest.title')}
          </h2>
          <span class="latest-updates-line h-[1px] flex-grow bg-gradient-to-r from-structural-borders via-structural-borders/30 to-transparent"></span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          {latestUpdates.map((update, index) => (
            <UpdateCard 
              title={update.title}
              description={update.description}
              link={update.link}
              index={index}
            />
          ))}
        </div>
      </section>

    </div>
  </div>
</Layout>

<style>
  /* Light mode overrides to make Latest Updates section heading white with visual depth */
  :global(html[data-theme="light"] .latest-updates-title) {
    color: #FFFFFF !important;
    text-shadow: 
      0 2px 8px rgba(11, 30, 54, 0.35),
      0 4px 20px rgba(11, 30, 54, 0.25) !important;
  }

  /* Light mode override for the fading line next to Latest Updates to be white */
  :global(html[data-theme="light"] .latest-updates-line) {
    background: linear-gradient(to right, rgba(255, 255, 255, 0.6) 0%, rgba(255, 255, 255, 0.15) 50%, transparent 100%) !important;
  }
</style>

<script>
  // Scroll Reveal triggers for clean entry animation
  const scrollObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.remove('opacity-0', 'translate-y-6');
        entry.target.classList.add('opacity-100', 'translate-y-0');
        scrollObserver.unobserve(entry.target);
      }
    });
  }, {
    threshold: 0.05
  });

  document.querySelectorAll('.scroll-reveal-section').forEach(section => {
    scrollObserver.observe(section);
  });
</script>
