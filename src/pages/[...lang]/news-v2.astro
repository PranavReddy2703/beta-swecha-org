---
import Layout from "@layouts/Layout.astro";
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../../i18n/utils";
import { languages, defaultLang } from "../../i18n/ui";

import NewsHero from "@components/news/NewsHero.astro";
import NewsFilter from "@components/news/NewsFilter.astro";
import NewsTimeline from "@components/news/NewsTimeline.astro";
import PublicationGroups from "@components/news/PublicationGroups.astro";
import EditorialNewsCard from "@components/news/EditorialNewsCard.astro";
import ArticleDetailModal from "@components/news/ArticleDetailModal.astro";

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => {
    return {
      params: { lang: lang === defaultLang ? undefined : lang },
    };
  });
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title="News V2" description="News page redesign WIP">
  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-10 py-10"
  >
    <NewsHero t={t} lang={lang} />
    <NewsFilter lang={lang} t={t} uniquePublications={[]} />
    <PublicationGroups articles={[]} lang={lang} />
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <EditorialNewsCard article={{} as any} lang={lang} />
      <EditorialNewsCard article={{} as any} lang={lang} />
    </div>
    <NewsTimeline milestones={[]} lang={lang} />
    <ArticleDetailModal lang={lang} />
  </div>
</Layout>
