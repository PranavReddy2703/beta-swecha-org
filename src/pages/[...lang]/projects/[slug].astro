---
// src/pages/[...lang]/projects/[slug].astro
import Layout from "@layouts/Layout.astro";
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../../../i18n/utils";
import { languages, defaultLang } from "../../../i18n/ui";
import projectsData from "../../../data/organisms/projects.json";
import featuredProjectsData from "../../../data/organisms/featured-projects.json";
import Button from "@components/atoms/Button.astro";

export function getStaticPaths() {
  const paths = [];

  // Combine all projects from featured-projects and projects list
  const allProjects = [
    ...featuredProjectsData.map((p) => ({
      title: p.title,
      slug: p.link.split("/").pop() || "",
      description: p.description,
    })),
    ...projectsData.projects.map((p) => ({
      title: p.title,
      slug: p.link.split("/").pop() || "",
      description: p.description,
    })),
  ].filter((p) => p.slug && p.slug !== "#");

  // Dedup by slug
  const uniqueProjects = Array.from(
    new Map(allProjects.map((item) => [item.slug, item])).values(),
  );

  for (const lang of Object.keys(languages)) {
    for (const project of uniqueProjects) {
      paths.push({
        params: {
          lang: lang === defaultLang ? undefined : lang,
          slug: project.slug,
        },
        props: { project },
      });
    }
  }
  return paths;
}

const { project } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<Layout title={`${project.title} - Swecha.org`}>
  <div
    class="relative min-h-[calc(100vh-4.5rem)] flex items-center justify-center text-text-main overflow-hidden py-16 transition-colors duration-300"
  >
    <!-- Ambient glows -->
    <div class="absolute inset-0 pointer-events-none z-0">
      <div
        class="absolute -top-30 left-1/3 w-[500px] h-[350px] bg-primary-brand/10 blur-[130px] rounded-full"
      >
      </div>
      <div
        class="absolute bottom-0 right-1/4 w-[400px] h-[300px] bg-secondary-accent/10 blur-[110px] rounded-full"
      >
      </div>
    </div>

    <div class="relative z-10 max-w-2xl mx-auto px-4 text-center">
      <!-- Icon/Illustration -->
      <div
        class="w-20 h-20 rounded-2xl bg-amber-500/10 text-amber-500 border border-amber-500/20 flex items-center justify-center mx-auto mb-8 animate-bounce"
        style="animation-duration: 3s;"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.8"
          stroke="currentColor"
          class="w-10 h-10"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M11.42 15.17L17.25 21A1.79 1.79 0 0115 21l-5.83-5.83M11.42 15.17l2.43-2.43M11.42 15.17L9 12.75M15.53 8.47a3.5 3.5 0 00-4.95 0L4.75 14.3a3.5 3.5 0 000 4.95l.7.7a3.5 3.5 0 004.95 0l5.83-5.83a3.5 3.5 0 000-4.95l-.7-.7z"
          ></path>
        </svg>
      </div>

      <!-- Badge -->
      <span
        class="inline-block px-3 py-1 text-xs font-extrabold uppercase tracking-widest rounded-full bg-amber-500/15 text-amber-500 border border-amber-500/25 mb-6 animate-pulse"
      >
        Under Development
      </span>

      <!-- Title -->
      <h1
        class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight mb-4 text-text-main"
      >
        {project.title}
      </h1>

      <!-- Description -->
      <p
        class="text-base sm:text-lg text-text-muted leading-relaxed mb-8 max-w-xl mx-auto"
      >
        {project.description}
      </p>

      <!-- Development Message Card -->
      <div
        class="bg-card-bg/35 border border-structural-borders/80 rounded-2xl p-6 mb-10 max-w-lg mx-auto text-left flex gap-4 items-center backdrop-blur-md"
      >
        <div class="text-amber-500 flex-shrink-0">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            class="w-6 h-6"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
            ></path>
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-bold text-text-main mb-1">Coming Soon</h3>
          <p class="text-xs text-text-muted leading-normal">
            We are actively working on localized documentation and release notes
            for this initiative. Stay tuned for updates!
          </p>
        </div>
      </div>

      <!-- Action Button -->
      <Button
        href={translatePath("/projects")}
        label="Back to Projects"
        variant="primary"
        class="shadow-[0_0_20px_rgba(0,212,255,0.15)]"
      />
    </div>
  </div>
</Layout>
