---
// src/pages/[...lang]/donations.astro
import Layout from '@layouts/Layout.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';
import { languages, defaultLang } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => {
    return {
      params: {
        lang: lang === defaultLang ? undefined : lang,
      },
    };
  });
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const donationMethods = [
  {
    icon: 'bank',
    titleKey: 'donations.method.bank.title' as const,
    descKey: 'donations.method.bank.desc' as const,
  },
  {
    icon: 'upi',
    titleKey: 'donations.method.upi.title' as const,
    descKey: 'donations.method.upi.desc' as const,
  },
  {
    icon: 'cheque',
    titleKey: 'donations.method.cheque.title' as const,
    descKey: 'donations.method.cheque.desc' as const,
  },
];

const impactStats = [
  { value: '50K+', labelKey: 'donations.impact.students' as const },
  { value: '500+', labelKey: 'donations.impact.workshops' as const },
  { value: '20+', labelKey: 'donations.impact.projects' as const },
  { value: '15+', labelKey: 'donations.impact.years' as const },
];
---

<Layout title={`${t('donations.title')} - Swecha.org`} description={t('donations.subtitle')}>
  <div class="relative min-h-[calc(100vh-4rem)] text-text-main transition-colors duration-300 pt-10 pb-16 overflow-hidden">

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-16">

      <!-- Hero Section -->
      <section id="donations-hero" class="text-center max-w-3xl mx-auto scroll-reveal-section opacity-0 translate-y-8 transition-all duration-700 ease-out">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight mb-6 leading-[1.1] text-white drop-shadow-[0_4px_12px_rgba(0,0,0,0.22)]">
          <span class="block">{t('donations.title')}</span>
          <span class="block">{t('donations.title2')}</span>
        </h1>

        <p class="text-base sm:text-lg text-white leading-relaxed max-w-2xl mx-auto">
          {t('donations.subtitle')}
        </p>
      </section>

      <!-- Impact Stats -->
      <section id="donations-impact" class="scroll-reveal-section opacity-0 translate-y-8 transition-all duration-700 ease-out">
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-6">
          {impactStats.map((stat) => (
            <div class="glass-white-card group relative overflow-hidden rounded-2xl border border-structural-borders bg-card-bg/40 p-6 backdrop-blur-xl transition-all duration-300 hover:border-primary-brand/30 hover:shadow-[0_0_25px_rgba(0,212,255,0.05)] text-center">
              <div class="text-3xl sm:text-4xl font-black bg-gradient-to-r from-primary-brand to-secondary-accent bg-clip-text text-transparent mb-2 transition-transform duration-300 group-hover:scale-105">
                {stat.value}
              </div>
              <div class="text-xs sm:text-sm font-bold text-text-muted uppercase tracking-wider">
                {t(stat.labelKey)}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Why Donate + Mission -->
      <section id="donations-why" class="scroll-reveal-section opacity-0 translate-y-8 transition-all duration-700 ease-out">
        <div class="glass-white-card relative overflow-hidden rounded-2xl border border-structural-borders bg-card-bg/40 p-8 sm:p-10 backdrop-blur-xl transition-all duration-300 hover:border-primary-brand/30">
          <!-- Decorative gradient orb -->
          <div class="absolute -top-20 -right-20 w-64 h-64 rounded-full bg-primary-brand/5 blur-3xl pointer-events-none"></div>

          <div class="relative z-10">
            <div class="flex items-center gap-2 mb-4">
              <h2 class="text-2xl sm:text-3xl font-extrabold text-text-main">
                {t('donations.why.title')}
              </h2>
            </div>
            <p class="text-base text-text-muted leading-relaxed mb-6 max-w-3xl">
              {t('donations.why.desc')}
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-8">
              <!-- Digital Education Card -->
              <div class="group/pillar flex items-start gap-3 p-4 rounded-xl bg-primary-brand/5 border border-primary-brand/10 transition-all duration-300 hover:scale-[1.02] hover:-translate-y-0.5 hover:shadow-md hover:shadow-primary-brand/5 hover:border-primary-brand/35">
                <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-primary-brand/10 flex items-center justify-center transition-transform duration-300 group-hover/pillar:scale-110 group-hover/pillar:rotate-6">
                  <svg class="w-5 h-5 text-primary-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                  </svg>
                </div>
                <div>
                  <h3 class="text-sm font-bold text-text-main mb-1 transition-colors duration-300 group-hover/pillar:text-primary-brand">{t('donations.why.education.title')}</h3>
                  <p class="text-xs text-text-muted leading-relaxed">{t('donations.why.education.desc')}</p>
                </div>
              </div>

              <!-- Free Software Development Card -->
              <div class="group/pillar flex items-start gap-3 p-4 rounded-xl bg-secondary-accent/5 border border-secondary-accent/10 transition-all duration-300 hover:scale-[1.02] hover:-translate-y-0.5 hover:shadow-md hover:shadow-secondary-accent/5 hover:border-secondary-accent/35">
                <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-secondary-accent/10 flex items-center justify-center transition-transform duration-300 group-hover/pillar:scale-110 group-hover/pillar:-rotate-6">
                  <svg class="w-5 h-5 text-secondary-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                  </svg>
                </div>
                <div>
                  <h3 class="text-sm font-bold text-text-main mb-1 transition-colors duration-300 group-hover/pillar:text-secondary-accent">{t('donations.why.foss.title')}</h3>
                  <p class="text-xs text-text-muted leading-relaxed">{t('donations.why.foss.desc')}</p>
                </div>
              </div>

              <!-- Community Building Card -->
              <div class="group/pillar flex items-start gap-3 p-4 rounded-xl bg-primary-brand/5 border border-primary-brand/10 transition-all duration-300 hover:scale-[1.02] hover:-translate-y-0.5 hover:shadow-md hover:shadow-primary-brand/5 hover:border-primary-brand/35">
                <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-primary-brand/10 flex items-center justify-center transition-transform duration-300 group-hover/pillar:scale-110 group-hover/pillar:-translate-y-0.5">
                  <svg class="w-5 h-5 text-primary-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                  </svg>
                </div>
                <div>
                  <h3 class="text-sm font-bold text-text-main mb-1 transition-colors duration-300 group-hover/pillar:text-primary-brand">{t('donations.why.community.title')}</h3>
                  <p class="text-xs text-text-muted leading-relaxed">{t('donations.why.community.desc')}</p>
                </div>
              </div>
            </div>

            <!-- Tax Exemption Notice -->
            <div class="group/tax mt-8 p-5 sm:p-6 rounded-xl bg-secondary-accent/5 border border-secondary-accent/15 flex items-start gap-4 backdrop-blur-sm transition-all duration-300 hover:border-secondary-accent/35 hover:shadow-md hover:shadow-secondary-accent/5 hover:bg-secondary-accent/8">
              <div class="flex-shrink-0 w-10 h-10 rounded-full bg-secondary-accent/10 flex items-center justify-center mt-0.5 transition-all duration-300 group-hover/tax:scale-110 group-hover/tax:rotate-[360deg] group-hover/tax:bg-secondary-accent/20">
                <svg class="w-5 h-5 text-secondary-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
              <div>
                <h3 class="text-base sm:text-lg font-extrabold text-text-main mb-1.5 transition-colors duration-300 group-hover/tax:text-secondary-accent">
                  {t('donations.tax.title')}
                </h3>
                <p class="text-xs sm:text-sm text-text-muted leading-relaxed">
                  {t('donations.tax.desc')}
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Donate Trigger Button Section -->
      <section id="donations-trigger-section" class="text-center scroll-reveal-section opacity-0 translate-y-8 transition-all duration-700 ease-out py-6">
        <button
          id="open-donation-modal"
          class="inline-flex items-center justify-center rounded-2xl bg-gradient-to-r from-primary-brand via-hover-brand to-secondary-accent py-[35px] px-[180px] text-2xl font-black text-[var(--primary-btn-text)] select-none cursor-pointer uppercase"
        >
          <svg class="mr-4 h-8 w-8 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
          </svg>
          <span>{t('donations.cta.btn.email')}</span>
        </button>
      </section>

      <!-- Donation Methods Modal -->
      <dialog id="donation-methods-modal" class="modal bg-transparent backdrop:backdrop-blur-md backdrop:bg-[#080B10]/70">
        <div class="modal-box bg-card-bg border border-structural-borders/40 shadow-2xl rounded-2xl p-6 sm:p-10 max-w-5xl w-11/12 overflow-y-auto max-h-[90vh] text-left relative flex flex-col">
          <!-- Close button -->
          <form method="dialog" class="absolute top-4 right-4 z-20">
            <button class="btn btn-sm btn-circle btn-ghost bg-black/40 text-white hover:bg-black/60 border-none outline-none" aria-label="Close">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
          </form>

          <div class="text-center mb-8">
            <h2 class="text-2xl sm:text-3xl font-extrabold text-text-main mb-2">
              {t('donations.methods.title')}
            </h2>
            <p class="text-sm text-text-muted max-w-lg mx-auto">
              {t('donations.methods.subtitle')}
            </p>
          </div>

          <!-- Cards layout -->
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Bank Transfer Card -->
            <div class="glass-white-card group relative overflow-hidden rounded-2xl border border-structural-borders bg-card-bg/40 p-6 sm:p-8 backdrop-blur-xl transition-all duration-300 hover:border-primary-brand/30 hover:shadow-[0_0_25px_rgba(0,212,255,0.05)]">
              <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-primary-brand to-hover-brand opacity-0 group-hover:opacity-100 transition-opacity duration-300 card-top-gradient-bank"></div>
              <div class="w-12 h-12 rounded-xl bg-primary-brand/10 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300">
                <svg class="w-6 h-6 text-primary-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 0h.008v.008h-.008V7.5z" />
                </svg>
              </div>
              <h3 class="text-lg font-extrabold text-text-main mb-2 group-hover:text-primary-brand transition-colors duration-300">
                {t('donations.method.bank.title')}
              </h3>
              <p class="text-sm text-text-muted leading-relaxed mb-5">
                {t('donations.method.bank.desc')}
              </p>
              <div class="space-y-2.5 text-sm">
                <div class="flex justify-between items-center py-2 px-3 rounded-lg bg-canvas-base/30 border border-structural-borders/30">
                  <span class="text-text-muted text-xs font-semibold">{t('donations.bank.accountName')}</span>
                  <span class="text-text-main font-bold text-xs">Swecha</span>
                </div>
                <div class="flex justify-between items-center py-2 px-3 rounded-lg bg-canvas-base/30 border border-structural-borders/30">
                  <span class="text-text-muted text-xs font-semibold">{t('donations.bank.account')}</span>
                  <span class="text-text-main font-bold text-xs">35743428443</span>
                </div>
                <div class="flex justify-between items-center py-2 px-3 rounded-lg bg-canvas-base/30 border border-structural-borders/30">
                  <span class="text-text-muted text-xs font-semibold">{t('donations.bank.name')}</span>
                  <span class="text-text-main font-bold text-xs">STATE BANK OF INDIA</span>
                </div>
                <div class="flex justify-between items-center py-2 px-3 rounded-lg bg-canvas-base/30 border border-structural-borders/30">
                  <span class="text-text-muted text-xs font-semibold">{t('donations.bank.branch')}</span>
                  <span class="text-text-main font-bold text-xs">PBB KUKATPALLY</span>
                </div>
                <div class="flex justify-between items-center py-2 px-3 rounded-lg bg-canvas-base/30 border border-structural-borders/30">
                  <span class="text-text-muted text-xs font-semibold">{t('donations.bank.ifsc')}</span>
                  <span class="text-text-main font-bold text-xs">SBIN0004275</span>
                </div>
              </div>
            </div>

            <!-- UPI Card -->
            <div class="glass-white-card group relative overflow-hidden rounded-2xl border border-structural-borders bg-card-bg/40 p-6 sm:p-8 backdrop-blur-xl transition-all duration-300 hover:border-secondary-accent/30 hover:shadow-[0_0_25px_rgba(77,255,184,0.05)]">
              <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-secondary-accent to-primary-brand opacity-0 group-hover:opacity-100 transition-opacity duration-300 card-top-gradient-upi"></div>
              <div class="w-12 h-12 rounded-xl bg-secondary-accent/10 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300">
                <svg class="w-6 h-6 text-secondary-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" />
                </svg>
              </div>
              <h3 class="text-lg font-extrabold text-text-main mb-2 group-hover:text-secondary-accent transition-colors duration-300">
                {t('donations.method.upi.title')}
              </h3>
              <p class="text-sm text-text-muted leading-relaxed mb-5">
                {t('donations.method.upi.desc')}
              </p>
              <div class="space-y-2.5 text-sm">
                <div class="flex justify-between items-center py-2 px-3 rounded-lg bg-canvas-base/30 border border-structural-borders/30">
                  <span class="text-text-muted text-xs font-semibold">{t('donations.upi.id')}</span>
                  <span class="text-text-main font-bold text-xs">swecha@upi</span>
                </div>
              </div>
              <div class="mt-6 p-4 rounded-xl bg-primary-brand/5 border border-primary-brand/10 text-center">
                <p class="text-xs text-text-muted font-semibold">{t('donations.upi.scan')}</p>
              </div>
            </div>

            <!-- Cheque / DD Card -->
            <div class="glass-white-card group relative overflow-hidden rounded-2xl border border-structural-borders bg-card-bg/40 p-6 sm:p-8 backdrop-blur-xl transition-all duration-300 hover:border-primary-brand/30 hover:shadow-[0_0_25px_rgba(0,212,255,0.05)]">
              <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-hover-brand to-secondary-accent opacity-0 group-hover:opacity-100 transition-opacity duration-300 card-top-gradient-cheque"></div>
              <div class="w-12 h-12 rounded-xl bg-primary-brand/10 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300">
                <svg class="w-6 h-6 text-primary-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                </svg>
              </div>
              <h3 class="text-lg font-extrabold text-text-main mb-2 group-hover:text-primary-brand transition-colors duration-300">
                {t('donations.method.cheque.title')}
              </h3>
              <p class="text-sm text-text-muted leading-relaxed mb-5">
                {t('donations.method.cheque.desc')}
              </p>
              <div class="space-y-2.5 text-sm">
                <div class="flex justify-between items-center py-2 px-3 rounded-lg bg-canvas-base/30 border border-structural-borders/30">
                  <span class="text-text-muted text-xs font-semibold">{t('donations.cheque.payee')}</span>
                  <span class="text-text-main font-bold text-xs">Swecha</span>
                </div>
                <div class="py-2 px-3 rounded-lg bg-canvas-base/30 border border-structural-borders/30">
                  <span class="text-text-muted text-xs font-semibold block mb-1">{t('donations.cheque.address')}</span>
                  <span class="text-text-main font-bold text-xs leading-relaxed block">
                    Swecha, Sy No. 91, Beside Centre for Good Governance, Gachibowli, Hyderabad, Telangana 500032
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <form method="dialog" class="modal-backdrop">
          <button>close</button>
        </form>
      </dialog>


      <!-- CTA Section -->
      <section id="donations-cta" class="scroll-reveal-section opacity-0 translate-y-8 transition-all duration-700 ease-out text-center py-8">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white mb-6 drop-shadow-[0_4px_12px_rgba(0,0,0,0.25)] tracking-tight">
          {t('donations.cta.title')}
        </h2>
        <p class="text-lg sm:text-xl lg:text-2xl text-white/95 leading-relaxed max-w-none drop-shadow-[0_2px_8px_rgba(0,0,0,0.2)]">
          {t('donations.cta.desc')}
        </p>
      </section>

    </div>
  </div>
</Layout>

<style>
  #open-donation-modal {
    position: relative;
    overflow: hidden;
    background-size: 200% auto;
    box-shadow: 0 10px 25px -5px rgba(0, 212, 255, 0.2), 0 8px 10px -6px rgba(0, 212, 255, 0.2);
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  html[data-theme="light"] #open-donation-modal {
    box-shadow: 0 10px 25px -5px rgba(2, 90, 158, 0.15), 0 8px 10px -6px rgba(2, 90, 158, 0.15);
  }
  
  /* Radial glow wave inside the button */
  #open-donation-modal::after {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.25) 0%, transparent 60%);
    transform: scale(0);
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.8s ease;
    opacity: 0;
    pointer-events: none;
  }

  #open-donation-modal:hover {
    transform: scale(1.03);
    background-position: right center;
    box-shadow: 0 20px 35px -5px rgba(0, 212, 255, 0.4), 0 0 25px rgba(0, 212, 255, 0.25);
  }

  html[data-theme="light"] #open-donation-modal:hover {
    box-shadow: 0 20px 35px -5px rgba(59, 130, 246, 0.35), 0 0 25px rgba(59, 130, 246, 0.2);
  }

  #open-donation-modal:hover::after {
    transform: scale(1);
    opacity: 1;
  }

  #open-donation-modal:active {
    transform: scale(0.98);
  }

  /* Softer/different gradients in light mode for the top line */
  html[data-theme="light"] .card-top-gradient-bank {
    background: linear-gradient(90deg, #93C5FD, #60A5FA) !important; /* Soft blue */
  }
  html[data-theme="light"] .card-top-gradient-upi {
    background: linear-gradient(90deg, #A7F3D0, #93C5FD) !important; /* Soft green-blue */
  }
  html[data-theme="light"] .card-top-gradient-cheque {
    background: linear-gradient(90deg, #C7D2FE, #A5B4FC) !important; /* Soft indigo/purple */
  }
</style>

<script>
  const scrollObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.remove('opacity-0', 'translate-y-8');
        entry.target.classList.add('opacity-100', 'translate-y-0');
        scrollObserver.unobserve(entry.target);
      }
    });
  }, {
    threshold: 0.1
  });

  document.querySelectorAll('.scroll-reveal-section').forEach(section => {
    scrollObserver.observe(section);
  });

  // Modal Dialog Trigger
  const openModalBtn = document.getElementById('open-donation-modal');
  const donationModal = document.getElementById('donation-methods-modal') as HTMLDialogElement | null;

  if (openModalBtn && donationModal) {
    openModalBtn.addEventListener('click', () => {
      donationModal.showModal();
    });
  }
</script>
