---
// src/pages/[...lang]/projects.astro
import Layout from '@layouts/Layout.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';
import { languages, defaultLang } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => {
    return {
      params: {
        lang: lang === defaultLang ? undefined : lang,
      },
    };
  });
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<Layout title={`${t('nav.projects')} - Swecha.org`}>
  <section class="py-20 flex flex-col items-center justify-center min-h-[calc(100vh-4rem)] relative overflow-hidden bg-canvas-base">
    <div class="absolute inset-0 pointer-events-none opacity-10">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 h-[500px] w-[500px] rounded-full bg-primary-brand/30 blur-[120px]"></div>
    </div>
    
    <div class="container mx-auto px-4 max-w-xl text-center relative z-10">
      <div class="rounded-2xl border border-structural-borders bg-card-bg/60 p-8 md:p-12 backdrop-blur-md shadow-2xl">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-primary-brand/30 bg-primary-brand/10 px-3 py-1 text-xs font-semibold tracking-wider text-primary-brand uppercase mb-6">
          {t('dev.stage')}
        </span>
        <h1 class="text-3xl font-extrabold tracking-tight text-text-main sm:text-4xl mb-4">
          {t('nav.projects')}
        </h1>
        <p class="text-base text-text-muted leading-relaxed mb-6">
          {t('projects.dev.desc')}
        </p>
        <a 
          href={translatePath('/')} 
          class="inline-flex items-center justify-center rounded-lg bg-primary-brand px-5 py-2.5 text-sm font-bold text-slate-950 transition duration-200 hover:bg-hover-brand"
        >
          {t('dev.returnHome')}
        </a>
      </div>
    </div>
  </section>
</Layout>
