---
// src/layouts/Layout.astro
import Navbar from "@organisms/Navbar.astro";
import BackgroundDecorations from "@organisms/BackgroundDecorations.astro";
import Footer from "@organisms/Footer.astro";
import SocialIsland from "@organisms/SocialIsland.astro";
import UpdatesIsland from "@organisms/UpdatesIsland.astro";
import FeedbackPopup from "@molecules/FeedbackPopup.astro";
import ChatbotButton from "@molecules/ChatbotButton.astro";
import "../styles/global.css";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

interface Props {
  title?: string;
  description?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
  title = t("layout.defaultTitle"),
  description = t("layout.defaultDesc"),
} = Astro.props;
---

<!doctype html>
<html lang={lang} class="scroll-smooth" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#080B10" />
    <title>Swecha</title>
    <meta name="description" content={description} />

    <!-- Inline script to set the theme before render to prevent FOUC -->
    <script is:inline>
      const savedTheme = localStorage.getItem("theme") || "dark";
      document.documentElement.setAttribute("data-theme", savedTheme);
    </script>

    <!-- PWA Registration -->
    <script>
      import "../pwa.ts";
    </script>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="font"
      href="https://fonts.gstatic.com/s/plusjakartasans/v12/LDIoaomQNQcsA88c7O9yZ4KMCoOg4Ko20yw.woff2"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      as="font"
      href="https://fonts.gstatic.com/s/outfit/v15/QGYvz_MVcBeNP4NJtEtq.woff2"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Great+Vibes&family=Alex+Brush&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Great+Vibes&family=Alex+Brush&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Great+Vibes&family=Alex+Brush&display=swap"
      />
    </noscript>

    <style>
      body {
        font-family: "Plus Jakarta Sans", system-ui, sans-serif;
      }
      h1,
      h2,
      h3,
      h4,
      h5,
      h6 {
        font-family: "Outfit", system-ui, sans-serif;
      }
    </style>
  </head>
  <body
    class="min-h-screen bg-canvas-base text-text-main antialiased flex flex-col transition-colors duration-300"
  >
    <!-- Background Decor (Birds) -->
    <BackgroundDecorations />

    <!-- Navbar Component -->
    <Navbar />

    <!-- Main Content Slot -->
    <main id="main-content" class="flex-grow pb-20">
      <slot />
    </main>

    <!-- Social Media Island -->
    <SocialIsland />

    <!-- Updates Island -->
    <UpdatesIsland />

    <!-- Footer Component -->
    <Footer />

    <!-- Give Us Feedback Pop-up -->
    <FeedbackPopup />

    <!-- Chatbot FAB -->
    <ChatbotButton />
  </body>
</html>
