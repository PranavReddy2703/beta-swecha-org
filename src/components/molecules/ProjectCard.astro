---
// src/components/projects/ProjectCard.astro
interface Props {
  title: string;
  description: string;
  tags: string[];
  status: "Live" | "Completed" | "In Development";
  link?: string;
}

const { title, description, tags, status, link = "#" } = Astro.props;
const tagsString = tags.join(",");

// Determine status color
const statusColors = {
  Live: "text-secondary-accent bg-secondary-accent/10 border-secondary-accent/20",
  Completed: "text-primary-brand bg-primary-brand/10 border-primary-brand/20",
  "In Development":
    "text-amber-600 bg-amber-600/10 border-amber-600/20 dark:text-yellow-400 dark:bg-yellow-400/10 dark:border-yellow-400/20",
};

const statusClass = statusColors[status] || statusColors.Live;
---

<a
  href={link}
  data-tags={tagsString}
  class="project-card group relative flex flex-col h-full bg-card-bg/40 backdrop-blur-xl border border-structural-borders rounded-2xl p-6 md:p-8 transition-all duration-300 hover:bg-elevated-surface/90 hover:-translate-y-1 hover:border-primary-brand/50 hover:shadow-[0_10px_40px_-10px_rgba(0,212,255,0.15)] overflow-hidden"
>
  <!-- Hover Glow Effect -->
  <div
    class="absolute inset-0 bg-gradient-to-br from-primary-brand/0 to-primary-brand/0 group-hover:from-primary-brand/5 group-hover:to-transparent transition-colors duration-500 pointer-events-none"
  >
  </div>

  <!-- Header: Status and External Icon -->
  <div class="flex justify-between items-start mb-6">
    <span
      data-status={status}
      class={`status-badge inline-flex items-center gap-1.5 px-3 py-1 text-[10px] sm:text-xs font-bold uppercase tracking-wider rounded-full border ${statusClass}`}
    >
      {
        status === "Completed" ? (
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-3 h-3 text-current"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="3"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M5 13l4 4L19 7"
            />
          </svg>
        ) : (
          <span class="relative flex h-1.5 w-1.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-current opacity-75" />
            <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-current" />
          </span>
        )
      }
      {status}
    </span>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="w-5 h-5 text-slate-500 group-hover:text-primary-brand transition-colors duration-300"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
      ></path>
    </svg>
  </div>

  <!-- Body: Title and Description -->
  <div class="flex-grow">
    <h3
      class="text-xl md:text-2xl font-bold text-text-main mb-3 group-hover:text-primary-brand transition-colors duration-300"
    >
      {title}
    </h3>
    <p class="text-sm md:text-base text-text-muted leading-relaxed mb-6">
      {description}
    </p>
  </div>

  <!-- Footer: Tags -->
  <div
    class="flex flex-wrap gap-2 mt-auto pt-6 border-t border-structural-borders/50"
  >
    {
      tags.map((tag) => (
        <span class="project-tag px-2.5 py-1 text-xs font-medium text-text-muted bg-secondary-bg rounded-md border border-structural-borders/80 group-hover:border-primary-brand/30 transition-colors duration-300">
          {tag}
        </span>
      ))
    }
  </div>
</a>

<style>
  /* Light mode overrides for status badges to make them brighter and more vibrant */
  :global(html[data-theme="light"]) .status-badge[data-status="Live"] {
    background-color: #ecfdf5 !important;
    color: #059669 !important;
    border-color: #a7f3d0 !important;
  }

  :global(html[data-theme="light"]) .status-badge[data-status="Completed"] {
    background-color: #f0f9ff !important;
    color: #0284c7 !important;
    border-color: #bae6fd !important;
  }

  :global(html[data-theme="light"])
    .status-badge[data-status="In Development"] {
    background-color: #fef3c7 !important;
    color: #d97706 !important;
    border-color: #fde68a !important;
  }

  /* Light mode overrides to make project category tags blue */
  :global(html[data-theme="light"]) .project-card .project-tag {
    background-color: rgba(2, 90, 158, 0.08) !important;
    color: #025a9e !important;
    border-color: rgba(2, 90, 158, 0.15) !important;
  }

  :global(html[data-theme="light"]) .project-card:hover .project-tag {
    background-color: rgba(2, 90, 158, 0.12) !important;
    border-color: rgba(2, 90, 158, 0.25) !important;
  }
</style>
