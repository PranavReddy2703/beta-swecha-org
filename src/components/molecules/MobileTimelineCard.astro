---
// src/components/molecules/MobileTimelineCard.astro
import Tag from '../atoms/Tag.astro';
interface Props {
  year: string;
  title: string;
  description: string;
  previewImage?: string;
  tags?: string[];
  index: number;
}

const {
  year,
  title,
  description,
  previewImage,
  tags = ["Community", "FOSS", "Localization"],
  index,
} = Astro.props;
---

<div
  class="mobile-timeline-card w-full bg-card-bg/40 border border-structural-borders/40 backdrop-blur-md rounded-2xl p-5 shadow-2xl transition-all duration-500 glass-white-card flex flex-col gap-4 scale-90 opacity-60 origin-center"
  data-index={index}
>
  <!-- Top: Image -->
  <div
    class="w-full h-40 sm:h-48 rounded-xl border border-structural-borders/40 bg-[#080B10]/80 overflow-hidden relative flex flex-col justify-center items-center text-center group/preview shadow-inner"
  >
    {
      previewImage ? (
        <img
          src={previewImage}
          alt={title}
          class="w-full h-full object-cover"
        />
      ) : (
        <>
          <div class="absolute inset-0 bg-gradient-to-tr from-primary-brand/5 to-secondary-accent/5 opacity-50 pointer-events-none" />
          <span class="text-[10px] font-black tracking-widest text-[#a855f7] uppercase mb-1.5 z-10">
            PROJECT PREVIEW
          </span>
          <h4 class="text-sm font-extrabold text-text-main mb-1.5 max-w-[200px] truncate z-10">
            {title}
          </h4>
        </>
      )
    }
    <div
      class="absolute inset-0 bg-gradient-to-t from-[#080B10]/70 via-transparent to-transparent pointer-events-none"
    >
    </div>
  </div>

  <!-- Middle: Content -->
  <div class="flex flex-col flex-grow text-left mt-2">
    <div class="flex items-center gap-2 mb-2">
      <span
        class="text-[10px] font-extrabold tracking-wider text-primary-brand uppercase"
        >MILESTONE</span
      >
      <span class="text-xs text-text-muted/40">•</span>
      <span class="text-xs font-bold text-secondary-accent tracking-wide"
        >{year}</span
      >
    </div>
    <h3 class="text-lg font-black text-text-main mb-1">
      {title}
    </h3>
    <div class="flex flex-wrap gap-1.5 mt-2 pr-12">
      {
        tags.map((tag) => (
          <Tag label={tag} class="text-[10px] px-2 py-0.5 whitespace-nowrap" />
        ))
      }
    </div>
  </div>

  <!-- Bottom: Button -->
  <button
    class="read-more-btn inline-flex items-center gap-1.5 text-primary-brand hover:text-hover-brand font-bold text-sm transition-colors duration-300 mt-2 self-start focus:outline-none"
    data-year={year}
    data-title={title}
    data-description={description}
    data-image={previewImage || ""}
    data-tags={JSON.stringify(tags)}
  >
    Read More
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="h-4 w-4"
      viewBox="0 0 20 20"
      fill="currentColor"
    >
      <path
        fill-rule="evenodd"
        d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
        clip-rule="evenodd"></path>
    </svg>
  </button>
</div>
