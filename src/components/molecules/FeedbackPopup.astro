---
// src/components/molecules/FeedbackPopup.astro
---

<div
  id="feedback-popup"
  class="feedback-popup fixed z-[100] bottom-20 left-6 right-6 md:right-auto md:w-96 rounded-2xl border p-5 shadow-2xl transition-all duration-500 ease-out transform translate-y-16 opacity-0 pointer-events-none"
>
  <!-- Close Button -->
  <button
    id="close-feedback-popup"
    class="absolute top-3 right-3 text-text-muted hover:text-text-main p-1.5 rounded-full hover:bg-elevated-surface/50 transition-colors duration-200 focus:outline-none cursor-pointer"
    aria-label="Close feedback popup"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="h-4 w-4"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2.5"
        d="M6 18L18 6M6 6l12 12"></path>
    </svg>
  </button>

  <div class="flex items-start gap-4">
    <!-- Icon Container with brand color gradient -->
    <div
      class="flex-shrink-0 w-10 h-10 rounded-xl bg-gradient-to-tr from-primary-brand/20 to-secondary-accent/20 flex items-center justify-center text-primary-brand border border-primary-brand/30"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-5 w-5"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"
        ></path>
      </svg>
    </div>

    <!-- Text content -->
    <div class="flex-grow pr-4">
      <h3 class="font-bold text-text-main text-base mb-1">Give Us Feedback</h3>
      <p class="text-xs text-text-muted leading-relaxed">
        Help us improve! We'd love to hear your thoughts and suggestions on the
        Swecha website.
      </p>
    </div>
  </div>

  <div class="mt-4 flex justify-end gap-3">
    <button
      id="dismiss-feedback-btn"
      class="text-xs font-semibold px-4 py-2 rounded-lg text-text-muted hover:text-text-main hover:bg-elevated-surface/50 transition-all duration-200 cursor-pointer"
    >
      Maybe later
    </button>
    <a
      id="submit-feedback-btn"
      href="https://forms.gle/q4XjpJY13aTAFf1E9"
      target="_blank"
      rel="noopener noreferrer"
      class="text-xs font-bold px-4 py-2 rounded-lg bg-primary-brand text-[var(--primary-btn-text)] hover:bg-hover-brand shadow-lg shadow-primary-brand/10 hover:shadow-hover-brand/20 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 cursor-pointer text-center"
    >
      Share Feedback
    </a>
  </div>
</div>

<script>
  function setupFeedbackPopup() {
    const popup = document.getElementById("feedback-popup");
    const closeBtn = document.getElementById("close-feedback-popup");
    const dismissBtn = document.getElementById("dismiss-feedback-btn");
    const submitBtn = document.getElementById("submit-feedback-btn");

    if (!popup || popup.dataset.initialized === "true") return;

    // Mark as initialized to prevent double setup
    popup.dataset.initialized = "true";

    let timeoutId: ReturnType<typeof setTimeout>;

    // Show popup after 3 seconds (3000ms delay)
    timeoutId = setTimeout(() => {
      popup.classList.add("show");
    }, 3000);

    const dismissFeedback = () => {
      popup.classList.remove("show");
    };

    closeBtn?.addEventListener("click", dismissFeedback);
    dismissBtn?.addEventListener("click", dismissFeedback);
    submitBtn?.addEventListener("click", dismissFeedback);

    // Astro lifecycle cleanup
    const cleanup = () => {
      clearTimeout(timeoutId);
      closeBtn?.removeEventListener("click", dismissFeedback);
      dismissBtn?.removeEventListener("click", dismissFeedback);
      submitBtn?.removeEventListener("click", dismissFeedback);
    };

    document.addEventListener("astro:before-swap", cleanup, { once: true });
  }

  // Hook into Astro's router load events for SPA/transition compatibility
  document.addEventListener("DOMContentLoaded", setupFeedbackPopup);
  document.addEventListener("astro:page-load", setupFeedbackPopup);

  // Call it immediately in case script is run after page swap/navigation
  setupFeedbackPopup();
</script>

<style>
  .feedback-popup {
    z-index: 150 !important;
    background-color: rgba(27, 36, 50, 0.9);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-color: rgba(39, 52, 73, 0.8);
  }

  /* Light Theme overrides matching Layout */
  :global(html[data-theme="light"]) .feedback-popup {
    background-color: rgba(255, 255, 255, 0.95) !important;
    border-color: rgba(2, 90, 158, 0.15) !important;
    box-shadow:
      0 20px 40px -15px rgba(11, 30, 54, 0.15),
      0 0 0 1px rgba(255, 255, 255, 0.6),
      inset 0 1px 0 rgba(255, 255, 255, 0.5) !important;
  }

  /* Smooth enter animation status classes */
  .feedback-popup.show {
    opacity: 1 !important;
    transform: translateY(0) !important;
    pointer-events: auto !important;
  }
</style>
