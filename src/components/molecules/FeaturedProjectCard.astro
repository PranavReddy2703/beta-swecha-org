---
// src/components/molecules/FeaturedProjectCard.astro
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
interface Props {
  title: string;
  description: string;
  imageLabel: string;
  image?: string;
  link?: string;
}

const { title, description, imageLabel, image, link = "#" } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<a
  href={link}
  class="group/card featured-project-card relative z-20 flex-none w-[calc(100vw-2rem)] xl:w-[1248px] max-w-full h-[340px] md:h-[420px] snap-center snap-always bg-secondary-bg border border-structural-borders rounded-2xl overflow-hidden transition-all duration-500 hover:border-secondary-accent/60 hover:shadow-[0_0_30px_-5px_rgba(77,255,184,0.2)]"
>
  <!-- Background Image/Pattern Layer -->
  <div class="absolute inset-0 bg-canvas-base">
    {
      image ? (
        <img
          src={image}
          alt={title}
          class="absolute inset-0 w-full h-full object-cover opacity-90 group-hover/card:opacity-100 transition-opacity duration-500"
        />
      ) : null
    }
    <div
      class="absolute inset-0 bg-gradient-to-t from-secondary-accent/10 to-transparent opacity-0 group-hover/card:opacity-100 transition-opacity duration-500 z-0"
    >
    </div>

    {
      !image && (
        <span class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 text-secondary-accent/20 font-mono text-2xl md:text-4xl tracking-widest uppercase z-10 pointer-events-none">
          [ {imageLabel} ]
        </span>
      )
    }
  </div>

  <!-- Gradient Overlay (black shade gradient from bottom to half) -->
  <div
    class="absolute inset-0 bg-gradient-to-t from-black via-black/80 to-transparent z-10 featured-project-overlay"
  >
  </div>

  <!-- Content Overlaid on Top -->
  <div class="absolute bottom-0 left-0 w-full p-6 md:p-8 z-20">
    <span
      class="featured-badge inline-flex items-center gap-1.5 px-3 py-1 mb-4 text-xs font-bold uppercase tracking-widest text-black bg-secondary-accent rounded-full shadow-[0_0_15px_rgba(77,255,184,0.6)]"
    >
      <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24">
        <path
          d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"
        ></path>
      </svg>
      {t("projects.featuredBadge")}
    </span>
    <h3
      class="featured-project-card-title text-xl md:text-2xl lg:text-3xl font-extrabold text-white mb-2 group-hover/card:text-secondary-accent transition-colors duration-300"
    >
      {title}
    </h3>
    <p class="text-sm md:text-base text-slate-300 leading-relaxed max-w-3xl">
      {description}
    </p>
  </div>
</a>

<style>
  /* Light mode overrides to make the featured badge tag ice blue inside the card */
  :global(html[data-theme="light"] .featured-badge) {
    background-color: #e0f2fe !important; /* Light Ice Blue (Tailwind sky-100) */
    color: #025a9e !important; /* Contrast brand blue */
    box-shadow: 0 0 15px rgba(224, 242, 254, 0.6) !important;
  }

  /* Ice blue title hover color in light mode */
  :global(
    html[data-theme="light"]
      .featured-project-card:hover
      .featured-project-card-title
  ),
  :global(
    html[data-theme="light"]
      .featured-project-card:hover
      .group-hover\/card\:text-secondary-accent
  ) {
    color: #e0f2fe !important;
  }
</style>
