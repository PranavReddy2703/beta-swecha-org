---
// src/components/events/EventCard.astro
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../../i18n/utils";

interface Props {
  event: {
    slug: string;
    title: string;
    shortDescription: string;
    image: string;
    date: string;
    venue: string;
    category: string;
    ongoing?: boolean;
  };
  isGlow?: boolean;
}

const { event, isGlow = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const dateStr = event.date;
---

<div
  class={`group relative overflow-hidden rounded-2xl border border-structural-borders bg-secondary-bg/40 backdrop-blur-md transition-all duration-300 hover:-translate-y-1 flex flex-col h-full cursor-pointer ${isGlow ? "active-card-green-glow" : "hover:border-primary-brand/35 hover:shadow-[0_8px_30px_rgba(0,212,255,0.08)]"}`}
  onclick={`window.location.href = '${translatePath(`/events/${event.slug}`)}'`}
  data-category={event.category.toLowerCase()}
  data-past="false"
  data-ongoing={event.ongoing ? "true" : "false"}
  data-title={event.title.toLowerCase()}
  data-desc={event.shortDescription.toLowerCase()}
>
  <!-- Cover Image with overflow hidden container -->
  <div class="relative w-full h-48 sm:h-52 overflow-hidden bg-slate-950">
    <img
      src={event.image}
      alt={event.title}
      class="h-full w-full object-cover object-center transition-transform duration-500 ease-out group-hover:scale-105"
    />
  </div>

  <!-- Content Block -->
  <div class="p-5 flex flex-col flex-grow justify-between space-y-4">
    <div class="space-y-2.5">
      <!-- Date & Venue Metadata -->
      <div
        class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs font-semibold text-text-muted"
      >
        <span class="flex items-center gap-1">
          <svg
            class={`w-3.5 h-3.5 ${isGlow ? "text-secondary-accent animate-pulse" : "text-primary-brand"}`}
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2 2v12a2 2 0 002 2z"
            ></path>
          </svg>
          {dateStr}
        </span>
        <span class="flex items-center gap-1">
          <svg
            class={`w-3.5 h-3.5 ${isGlow ? "text-secondary-accent animate-pulse" : "text-primary-brand"}`}
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
            ></path>
          </svg>
          {event.venue}
        </span>
      </div>

      <!-- Title -->
      <h3
        class={`text-lg md:text-xl font-bold tracking-tight text-text-main transition-colors duration-300 leading-snug ${isGlow ? "group-hover:text-secondary-accent" : "group-hover:text-primary-brand"}`}
      >
        {event.title}
      </h3>

      <!-- Description -->
      <p
        class="text-sm text-text-muted leading-relaxed font-medium line-clamp-3"
      >
        {event.shortDescription}
      </p>
    </div>

    <!-- Action Button (View Details) -->
    <div
      class="pt-2 border-t border-structural-borders/20 flex items-center justify-between"
    >
      <a
        href={translatePath(`/events/${event.slug}`)}
        class={`inline-flex items-center gap-1.5 text-xs font-bold transition-colors duration-200 ${isGlow ? "text-secondary-accent hover:text-[#33ffc2]" : "text-primary-brand hover:text-hover-brand"}`}
        onclick="event.stopPropagation();"
      >
        <span>{t("events.btn.viewDetails")}</span>
        <svg
          class="h-3.5 w-3.5 transform transition-transform duration-300 group-hover:translate-x-0.5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"
          ></path>
        </svg>
      </a>
    </div>
  </div>
</div>

<style>
  /* Premium border glow effect (active by default, intensifies on hover) matching FeaturedNewsCard style but strictly green */
  .active-card-green-glow {
    border-color: color-mix(
      in srgb,
      var(--secondary-accent) 30%,
      transparent
    ) !important;
    box-shadow:
      0 10px 30px -10px rgba(0, 0, 0, 0.7),
      0 0 20px -5px color-mix(in srgb, var(--secondary-accent) 10%, transparent),
      0 0 35px -15px color-mix(in srgb, var(--secondary-accent) 8%, transparent) !important;
  }

  .active-card-green-glow:hover {
    border-color: color-mix(
      in srgb,
      var(--secondary-accent) 55%,
      transparent
    ) !important;
    box-shadow:
      0 10px 30px -10px rgba(0, 0, 0, 0.7),
      0 0 30px -5px color-mix(in srgb, var(--secondary-accent) 22%, transparent),
      0 0 50px -10px
        color-mix(in srgb, var(--secondary-accent) 16%, transparent) !important;
  }
</style>
