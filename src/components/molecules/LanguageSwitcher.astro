---
// src/components/molecules/LanguageSwitcher.astro
import IconButton from "../atoms/IconButton.astro";
import LangOption from "../atoms/LangOption.astro";
import { getLangFromUrl } from "../../i18n/utils";
import { languages, defaultLang } from "../../i18n/ui";

interface Props {
  title: string;
}

const { title } = Astro.props;

const lang = getLangFromUrl(Astro.url);

const languagesList = Object.entries(languages).map(([code, name]) => ({
  code,
  name,
}));

const getPathnameWithoutLang = (pathname: string) => {
  const parts = pathname.split("/");
  if (parts[1] && parts[1] in languages) {
    parts.splice(1, 1);
  }
  return parts.join("/") || "/";
};

const cleanPath = getPathnameWithoutLang(Astro.url.pathname);
---

<div class="dropdown dropdown-end">
  <IconButton id="lang-toggle" title={title}>
    <svg
      class="h-5 w-5 action-btn-icon"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.8"
        d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5c-.313 1.565-.95 3.107-1.859 4.5M11.25 10.5a9 9 0 01-4.8 3.59"
      ></path>
    </svg>
  </IconButton>
  <ul tabindex="0" class="dropdown-content menu lang-dropdown">
    {
      languagesList.map((langOption) => {
        const targetHref =
          langOption.code === defaultLang
            ? cleanPath
            : `/${langOption.code}${cleanPath === "/" ? "" : cleanPath}`;
        return (
          <LangOption
            href={targetHref}
            name={langOption.name}
            isActive={lang === langOption.code}
          />
        );
      })
    }
  </ul>
</div>

<style>
  .lang-dropdown {
    position: absolute;
    right: 0;
    margin-top: 0.75rem;
    padding: 0.5rem;
    min-width: 10rem;
    background: var(--card-bg);
    border: 1px solid var(--structural-borders);
    border-radius: 0.75rem;
    box-shadow:
      0 10px 40px rgba(0, 0, 0, 0.3),
      0 0 0 1px color-mix(in srgb, var(--primary-brand) 8%, transparent);
    list-style: none;
    z-index: 100;
    backdrop-filter: blur(20px);
    animation: dropdownReveal 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  @keyframes dropdownReveal {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
</style>
