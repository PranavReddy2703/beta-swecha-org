---
// src/components/news/NewsFilter.astro
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import PublicationGroups from "../organisms/PublicationGroups.astro";

interface Props {
  lang: string;
  t: any;
  articles: any[];
}

const { lang, t, articles } = Astro.props;
const uniquePublications = [
  ...new Set(articles.map((a: any) => a.publication)),
];

// Localized UI Labels
const labels = {
  search:
    lang === "te"
      ? "వ్యాసాల కోసం వెతకండి..."
      : lang === "hi"
        ? "लेख खोजें..."
        : "Search articles...",
  searchLabel: lang === "te" ? "శోధన" : lang === "hi" ? "खोजें" : "Search",
  category: lang === "te" ? "వర్గం" : lang === "hi" ? "श्रेणी" : "Category",
  year: lang === "te" ? "సంవత్సరం" : lang === "hi" ? "वर्ष" : "Year",
  publication:
    lang === "te" ? "ప్రచురణ" : lang === "hi" ? "प्रकाशन" : "Publication",
  sort:
    lang === "te"
      ? "క్రమబద్ధీకరించు"
      : lang === "hi"
        ? "क्रमबद्ध करें"
        : "Sort By",
  all: lang === "te" ? "అన్నీ" : lang === "hi" ? "सभी" : "All",
  latest: lang === "te" ? "తాజాది" : lang === "hi" ? "नवीनतम" : "Latest",
  oldest: lang === "te" ? "పాతది" : lang === "hi" ? "पुराना" : "Oldest",
};

const categories = [
  { id: "all", label: labels.all },
  {
    id: "ai-initiative",
    label:
      lang === "te"
        ? "AI కార్యక్రమాలు"
        : lang === "hi"
          ? "एआई पहल"
          : "AI Initiative",
  },
  {
    id: "event-coverage",
    label:
      lang === "te"
        ? "ఈవెంట్ కవరేజ్"
        : lang === "hi"
          ? "इवेंट कवरेज"
          : "Event Coverage",
  },
  {
    id: "press-release",
    label:
      lang === "te"
        ? "పత్రికా ప్రకటనలు"
        : lang === "hi"
          ? "प्रेस विज्ञप्ति"
          : "Press Release",
  },
  {
    id: "community",
    label:
      lang === "te"
        ? "కమ్యూనిటీ"
        : lang === "hi"
          ? "समुदाय"
          : "Community Update",
  },
  {
    id: "blog",
    label: lang === "te" ? "బ్లాగులు" : lang === "hi" ? "ब्लॉग" : "Blog",
  },
  {
    id: "news",
    label: lang === "te" ? "వార్తలు" : lang === "hi" ? "समाचार" : "News",
  },
];

const years = ["All", "2026", "2025", "2024"];
---

<div class="news-filter-container space-y-3.5 select-none">
  <!-- Search Bar + Dropdowns Control Row -->
  <div class="flex flex-col lg:flex-row gap-3">
    <!-- Search Input -->
    <div class="flex flex-col flex-grow">
      <label
        for="search-input"
        class="news-filter-label text-[9px] font-bold text-text-muted uppercase tracking-wider mb-1"
        >{labels.searchLabel}</label
      >
      <div class="relative">
        <div
          class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-text-muted/60"
        >
          <svg
            class="h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
        <input
          type="text"
          id="search-input"
          placeholder={labels.search}
          class="w-full pl-9 pr-4 h-9 rounded-lg border border-structural-borders bg-card-bg/20 text-xs text-text-main placeholder-text-muted/50 focus:outline-none focus:border-primary-brand/50 focus:ring-1 focus:ring-primary-brand/35 transition-all duration-200 shadow-sm"
        />
      </div>
    </div>

    <!-- Dropdowns Grid -->
    <div class="grid grid-cols-3 gap-2.5 shrink-0 lg:w-[380px]">
      <!-- Year Select -->
      <div class="flex flex-col">
        <label
          for="year-select"
          class="news-filter-label text-[9px] font-bold text-text-muted uppercase tracking-wider mb-1"
          >{labels.year}</label
        >
        <select
          id="year-select"
          class="px-2.5 h-9 rounded-lg border border-structural-borders bg-card-bg/35 text-xs text-text-main font-semibold focus:outline-none focus:border-primary-brand/50 cursor-pointer transition-colors duration-200 shadow-sm"
        >
          <option value="all">{labels.all}</option>
          {
            years
              .filter((y) => y !== "All")
              .map((year) => <option value={year}>{year}</option>)
          }
        </select>
      </div>

      <!-- Publication Select -->
      <div class="flex flex-col">
        <label
          for="pub-select"
          class="news-filter-label text-[9px] font-bold text-text-muted uppercase tracking-wider mb-1"
          >{labels.publication}</label
        >
        <select
          id="pub-select"
          class="px-2.5 h-9 rounded-lg border border-structural-borders bg-card-bg/35 text-[10px] text-text-main font-semibold focus:outline-none focus:border-primary-brand/50 cursor-pointer transition-colors duration-200 shadow-sm"
        >
          <option value="all">{labels.all}</option>
          {
            [...new Set(articles.map((a) => a.publication))].map((pub) => (
              <option value={pub.toLowerCase()}>{pub}</option>
            ))
          }
        </select>
      </div>

      <!-- Sort Select -->
      <div class="flex flex-col">
        <label
          for="sort-select"
          class="news-filter-label text-[9px] font-bold text-text-muted uppercase tracking-wider mb-1"
          >{labels.sort}</label
        >
        <select
          id="sort-select"
          class="px-2.5 h-9 rounded-lg border border-structural-borders bg-card-bg/35 text-xs text-text-main font-semibold focus:outline-none focus:border-primary-brand/50 cursor-pointer transition-colors duration-200 shadow-sm"
        >
          <option value="latest">{labels.latest}</option>
          <option value="oldest">{labels.oldest}</option>
        </select>
      </div>
    </div>
  </div>

  <!-- Horizontal Scrollable Category Filter Pills -->
  <div
    class="flex items-center gap-1.5 overflow-x-auto pb-1 scrollbar-thin scrollbar-thumb-structural-borders/30 scroll-smooth"
  >
    {
      categories.map((cat, idx) => (
        <button
          type="button"
          data-category={cat.id}
          class={`category-pill px-2.5 py-0.5 rounded-full text-[10px] font-bold whitespace-nowrap transition-all duration-200 cursor-pointer border shadow-sm ${
            idx === 0
              ? "bg-primary-brand border-primary-brand text-[var(--primary-btn-text)] shadow-sm shadow-primary-brand/20"
              : "bg-card-bg/25 border-structural-borders text-text-muted hover:text-text-main hover:border-text-muted/30"
          }`}
        >
          {cat.label}
        </button>
      ))
    }
  </div>

  <!-- Publisher filter buttons -->
  <div class="pt-0.5">
    <PublicationGroups articles={articles} lang={lang} />
  </div>
</div>

<style>
  /* Custom scrollbar tuning for filter pills */
  ::-webkit-scrollbar {
    height: 4px;
  }
  ::-webkit-scrollbar-track {
    background: transparent;
  }
  ::-webkit-scrollbar-thumb {
    background: rgba(var(--structural-borders), 0.15);
    border-radius: 99px;
  }

  /* Light mode overrides for labels, inputs, selects, and pills */
  :global(html[data-theme="light"]) .news-filter-label {
    color: #ffffff !important;
    text-shadow: 0 1px 2px rgba(11, 30, 54, 0.2) !important;
  }

  :global(html[data-theme="light"]) #search-input,
  :global(html[data-theme="light"]) #year-select,
  :global(html[data-theme="light"]) #sort-select {
    background-color: #ffffff !important;
    color: #0b1e36 !important;
    border-color: rgba(255, 255, 255, 0.85) !important;
    box-shadow:
      0 4px 10px rgba(11, 30, 54, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.4) !important;
  }

  :global(html[data-theme="light"]) #search-input:focus,
  :global(html[data-theme="light"]) #year-select:focus,
  :global(html[data-theme="light"]) #sort-select:focus {
    border-color: var(--primary-brand) !important;
    box-shadow:
      0 4px 14px rgba(2, 90, 158, 0.15),
      inset 0 1px 0 rgba(255, 255, 255, 0.4) !important;
  }

  :global(html[data-theme="light"]) .category-pill:not(.bg-primary-brand) {
    background-color: #ffffff !important;
    border-color: rgba(255, 255, 255, 0.85) !important;
    color: #0b1e36 !important;
    box-shadow:
      0 2px 6px rgba(11, 30, 54, 0.06),
      inset 0 1px 0 rgba(255, 255, 255, 0.4) !important;
  }

  :global(html[data-theme="light"])
    .category-pill:not(.bg-primary-brand):hover {
    background-color: #ffffff !important;
    border-color: rgba(2, 90, 158, 0.45) !important;
    color: var(--primary-brand) !important;
    box-shadow:
      0 4px 10px rgba(11, 30, 54, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.4) !important;
  }

  :global(html[data-theme="light"]) .category-pill.bg-primary-brand {
    background-color: #ffffff !important;
    border-color: var(--primary-brand) !important;
    color: var(--primary-brand) !important;
    box-shadow:
      0 2px 4px rgba(2, 90, 158, 0.08),
      inset 0 2px 4px rgba(2, 90, 158, 0.12) !important;
    transform: scale(0.96) translateY(0.5px) !important;
  }
</style>
