---
// src/components/TimelineCard.astro
interface Props {
  year: string;
  title: string;
  description: string;
  previewImage?: string;
  tags?: string[];
}

const { year, title, description, previewImage, tags = ["Community", "FOSS", "Localization"] } = Astro.props;
---

<div class="w-full min-h-[630px] md:min-h-[400px] bg-card-bg/40 border border-structural-borders/40 hover:border-primary-brand/30 backdrop-blur-md rounded-2xl p-8 sm:p-8 shadow-xl transition-all duration-500 hover:border-primary-brand/40 cursor-default select-none grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
  <!-- Left Column: Project/Event Preview -->
  <div class="md:col-span-5 w-full h-72 md:h-80 rounded-xl border border-structural-borders/40 bg-[#080B10]/80 overflow-hidden relative group/preview flex flex-col justify-center items-center text-center">
    {previewImage ? (
      <img 
        src={previewImage} 
        alt={title} 
        class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover/preview:scale-105" 
      />
    ) : (
      <>
        <!-- Subtle gradient glow overlay fallback -->
        <div class="absolute inset-0 bg-gradient-to-tr from-primary-brand/5 to-secondary-accent/5 opacity-50 pointer-events-none"></div>
        <span class="text-[10px] font-black tracking-widest text-[#a855f7] uppercase mb-1.5 z-10">
          PROJECT PREVIEW
        </span>
        <h4 class="text-sm font-extrabold text-text-main mb-1.5 max-w-[360px] truncate z-10">
          {title}
        </h4>
        <p class="text-[11px] text-text-muted max-w-[220px] leading-relaxed z-10">
          You can replace this preview block with a real screenshot, mockup, or mini visual card later.
        </p>
      </>
    )}
    <!-- Subtle gradient overlay on top of the image to blend it with dark card styles -->
    <div class="absolute inset-0 bg-gradient-to-t from-[#080B10]/70 via-transparent to-transparent pointer-events-none"></div>
  </div>

  <!-- Right Column: Details -->
  <div class="md:col-span-7 flex flex-col justify-start text-left">
    <!-- Small Tag Heading -->
    <div class="flex items-center gap-2 mb-2">
      <span class="text-[11px] font-extrabold tracking-wider text-primary-brand uppercase">
        FEATURED MILESTONE
      </span>
      <span class="text-xs text-text-muted/40">•</span>
      <span class="text-xs font-bold text-secondary-accent tracking-wide">
        {year}
      </span>
    </div>

    <!-- Title -->
    <h3 class="text-xl sm:text-2xl font-black text-text-main mb-2.5 transition-colors duration-300">
      {title}
    </h3>

    <!-- Description (minimum 16px as per constitution.md) -->
    <p class="text-[16px] text-text-muted leading-relaxed mb-4">
      {description}
    </p>

    <!-- Tech/Topic Badges (daisyui badge component) -->
    <div class="flex flex-wrap gap-2">
      {tags.map((tag) => (
        <div class="badge badge-outline border-structural-borders/60 text-text-muted text-[11px] font-semibold px-2.5 py-1">
          {tag}
        </div>
      ))}
    </div>
  </div>
</div>
