---
// src/components/BackgroundDecorations.astro
---

<div class="fixed inset-0 pointer-events-none overflow-hidden z-10 select-none">
  <!-- Subtle, elegant ambient birds flying in V-formation and gliding across the screen -->
  <div class="absolute inset-0 birds-wrapper transition-opacity duration-300">
    
    <!-- Flock 1: V-Formation (Three Birds) -->
    <div class="absolute flock-container-1">
      <!-- Leader -->
      <div class="absolute bird-leader">
        <svg class="bird" viewBox="0 0 100 100" fill="currentColor">
          <path class="bird-path-1" d="M 10 32 Q 30 24 50 32 Q 70 24 90 32 Q 70 28 50 32 Q 30 28 10 32 Z" />
        </svg>
      </div>
      <!-- Follower Left -->
      <div class="absolute bird-follower-l">
        <svg class="bird" viewBox="0 0 100 100" fill="currentColor">
          <path class="bird-path-2" d="M 10 32 Q 30 24 50 32 Q 70 24 90 32 Q 70 28 50 32 Q 30 28 10 32 Z" />
        </svg>
      </div>
      <!-- Follower Right -->
      <div class="absolute bird-follower-r">
        <svg class="bird" viewBox="0 0 100 100" fill="currentColor">
          <path class="bird-path-3" d="M 10 32 Q 30 24 50 32 Q 70 24 90 32 Q 70 28 50 32 Q 30 28 10 32 Z" />
        </svg>
      </div>
    </div>

    <!-- Lone Bird: Active flight, climbs and dives -->
    <div class="absolute bird-lone-container">
      <svg class="bird" viewBox="0 0 100 100" fill="currentColor">
        <path class="bird-path-lone" d="M 10 32 Q 30 24 50 32 Q 70 24 90 32 Q 70 28 50 32 Q 30 28 10 32 Z" />
      </svg>
    </div>

    <!-- Glider: High altitude, slow and serene glide -->
    <div class="absolute bird-glider-container">
      <svg class="bird" viewBox="0 0 100 100" fill="currentColor">
        <path class="bird-path-glider" d="M 10 32 Q 30 24 50 32 Q 70 24 90 32 Q 70 28 50 32 Q 30 28 10 32 Z" />
      </svg>
    </div>

  </div>
</div>

<style>
  /* Explicit wrapper opacity for perfect visibility on both light and dark themes */
  .birds-wrapper {
    opacity: 0.75; /* Clearly visible light-mode opacity */
    transition: opacity 0.3s ease;
  }

  :global(html[data-theme="dark"]) .birds-wrapper {
    opacity: 0.55; /* Clearly visible dark-mode opacity */
  }

  .bird {
    width: 32px;
    height: 32px;
    transition: color 0.3s ease;
  }

  /* Color identity for the birds using theme-responsive brand colors */
  .flock-container-1 .bird {
    color: var(--primary-brand);
  }
  
  .bird-lone-container .bird {
    color: var(--secondary-accent);
  }
  
  .bird-glider-container .bird {
    color: var(--primary-brand);
  }

  /* --- Flock 1 Layout (Leader-Follower spacing - wider for organic feel) --- */
  .flock-container-1 {
    width: 220px;
    height: 180px;
    will-change: left, transform;
    animation: fly-flock-1 45s infinite linear;
    animation-delay: -5s; /* Spaced out initial delay */
  }

  .bird-leader {
    top: 50px;
    left: 0;
    transform: scale(0.9);
  }

  .bird-follower-l {
    top: 120px;
    left: 90px;
    transform: scale(0.75);
  }

  .bird-follower-r {
    top: -10px;
    left: 110px;
    transform: scale(0.72);
  }

  /* --- Lone Bird & Glider Layout --- */
  .bird-lone-container {
    width: 32px;
    height: 32px;
    will-change: left, transform;
    animation: fly-lone-1 32s infinite linear;
    animation-delay: -22s; /* Spaced out initial delay */
  }

  .bird-glider-container {
    width: 32px;
    height: 32px;
    will-change: left, transform;
    animation: fly-glider-1 60s infinite linear;
    animation-delay: -45s; /* Spaced out initial delay */
  }

  /* --- Flapping Paths Animations --- */
  .bird-path-1 {
    animation: flap-cycle-1 4.5s infinite ease-in-out;
  }
  .bird-path-2 {
    animation: flap-cycle-2 4.1s infinite ease-in-out;
    animation-delay: 0.3s; /* offset flap slightly in formation */
  }
  .bird-path-3 {
    animation: flap-cycle-3 4.3s infinite ease-in-out;
    animation-delay: 0.6s; /* offset flap slightly in formation */
  }
  .bird-path-lone {
    animation: flap-cycle-1 3.5s infinite ease-in-out; /* faster wings */
  }
  .bird-path-glider {
    animation: flap-cycle-glider 7s infinite ease-in-out; /* slow glide and rare beat */
  }

  /* --- Trajectory & Flight Path Keyframes (Altitudes separated) --- */
  
  /* Flock 1: majestic drift across top (8vh to 14vh) */
  @keyframes fly-flock-1 {
    0% {
      left: 105%;
      transform: translateY(8vh);
      opacity: 0;
    }
    3% {
      opacity: 1;
    }
    57% {
      opacity: 1;
    }
    60% {
      left: -25%;
      transform: translateY(14vh);
      opacity: 0;
    }
    60.01%, 100% {
      left: 105%;
      transform: translateY(8vh);
      opacity: 0;
    }
  }

  /* Lone Bird: dynamic climb and dive across lower section (65vh to 78vh) */
  @keyframes fly-lone-1 {
    0%, 15% {
      left: 105%;
      transform: translateY(70vh);
      opacity: 0;
    }
    18% {
      opacity: 1;
    }
    35% {
      transform: translateY(65vh) rotate(-8deg); /* climb */
    }
    55% {
      transform: translateY(78vh) rotate(6deg); /* dive */
    }
    72% {
      opacity: 1;
    }
    75% {
      left: -15%;
      transform: translateY(72vh);
      opacity: 0;
    }
    75.01%, 100% {
      left: 105%;
      transform: translateY(70vh);
      opacity: 0;
    }
  }

  /* Glider Bird: slow, high-altitude passage, mid-level altitude (30vh to 35vh) */
  @keyframes fly-glider-1 {
    0%, 30% {
      left: 105%;
      transform: translateY(30vh);
      opacity: 0;
    }
    33% {
      opacity: 1;
    }
    87% {
      opacity: 1;
    }
    90% {
      left: -15%;
      transform: translateY(35vh);
      opacity: 0;
    }
    90.01%, 100% {
      left: 105%;
      transform: translateY(30vh);
      opacity: 0;
    }
  }

  /* --- Flapping Cycle Keyframes (Path Morphing) --- */
  
  /* Cycle 1 (Leader / Lone): Flaps for 40% of duration, then glides */
  @keyframes flap-cycle-1 {
    0%, 10%, 20%, 30%, 40% {
      d: path("M 10 32 Q 30 24 50 32 Q 70 24 90 32 Q 70 28 50 32 Q 30 28 10 32 Z"); /* glide */
    }
    5%, 25% {
      d: path("M 10 42 Q 30 12 50 35 Q 70 12 90 42 Q 70 28 50 35 Q 30 28 10 42 Z"); /* wings up */
    }
    15%, 35% {
      d: path("M 10 18 Q 30 34 50 35 Q 70 34 90 18 Q 70 28 50 35 Q 30 28 10 18 Z"); /* wings down */
    }
    45%, 100% {
      d: path("M 10 32 Q 30 24 50 32 Q 70 24 90 32 Q 70 28 50 32 Q 30 28 10 32 Z"); /* glide */
    }
  }

  /* Cycle 2 (Follower L): Slightly different rhythm */
  @keyframes flap-cycle-2 {
    0%, 8%, 16%, 24%, 32%, 40% {
      d: path("M 10 32 Q 30 24 50 32 Q 70 24 90 32 Q 70 28 50 32 Q 30 28 10 32 Z");
    }
    4%, 20% {
      d: path("M 10 42 Q 30 12 50 35 Q 70 12 90 42 Q 70 28 50 35 Q 30 28 10 42 Z");
    }
    12%, 28% {
      d: path("M 10 18 Q 30 34 50 35 Q 70 34 90 18 Q 70 28 50 35 Q 30 28 10 18 Z");
    }
    41%, 100% {
      d: path("M 10 32 Q 30 24 50 32 Q 70 24 90 32 Q 70 28 50 32 Q 30 28 10 32 Z");
    }
  }

  /* Cycle 3 (Follower R): Another rhythm variation */
  @keyframes flap-cycle-3 {
    0%, 12%, 24%, 36% {
      d: path("M 10 32 Q 30 24 50 32 Q 70 24 90 32 Q 70 28 50 32 Q 30 28 10 32 Z");
    }
    6%, 30% {
      d: path("M 10 42 Q 30 12 50 35 Q 70 12 90 42 Q 70 28 50 35 Q 30 28 10 42 Z");
    }
    18% {
      d: path("M 10 18 Q 30 34 50 35 Q 70 34 90 18 Q 70 28 50 35 Q 30 28 10 18 Z");
    }
    37%, 100% {
      d: path("M 10 32 Q 30 24 50 32 Q 70 24 90 32 Q 70 28 50 32 Q 30 28 10 32 Z");
    }
  }

  /* Glider Cycle: Mostly glide, very rare single beat */
  @keyframes flap-cycle-glider {
    0%, 10%, 100% {
      d: path("M 10 32 Q 30 24 50 32 Q 70 24 90 32 Q 70 28 50 32 Q 30 28 10 32 Z");
    }
    3% {
      d: path("M 10 42 Q 30 12 50 35 Q 70 12 90 42 Q 70 28 50 35 Q 30 28 10 42 Z");
    }
    7% {
      d: path("M 10 18 Q 30 34 50 35 Q 70 34 90 18 Q 70 28 50 35 Q 30 28 10 18 Z");
    }
  }
</style>
