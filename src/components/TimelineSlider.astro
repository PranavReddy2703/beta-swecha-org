---
// src/components/TimelineSlider.astro
interface Props {
  events: Array<{
    year: string;
    title: string;
    description: string;
  }>;
}

const { events } = Astro.props;
const N = events.length;

// Interpolate colors dynamically from Electric Cyan (HSL 190) to Emerald Mint (HSL 155)
const getNodeColors = (idx: number) => {
  const t = N > 1 ? idx / (N - 1) : 0;
  const hue = Math.round(190 - t * 35);
  const lightness = Math.round(50 + t * 15);
  
  const color = `hsl(${hue}, 100%, ${lightness}%)`;
  const glow = `hsla(${hue}, 100%, ${lightness}%, 0.25)`;
  const shadow = `hsla(${hue}, 100%, ${lightness}%, 0.15)`;
  
  return { color, glow, shadow };
};
---

<div class="w-full overflow-visible py-6 relative flex justify-center mt-4">
  <ul 
    id="sliding-timeline" 
    class="timeline timeline-horizontal select-none transition-transform duration-500 ease-out flex justify-between relative" 
    style={`width: ${events.length * 200}px; min-width: ${events.length * 200}px;`}
  >
    {events.map((event, index) => {
      const colors = getNodeColors(index);
      const nextColors = index < N - 1 ? getNodeColors(index + 1) : null;
      
      // Calculate dynamic linear gradients for line segments
      const lineStyle = nextColors 
        ? `background: linear-gradient(to right, ${colors.color}, ${nextColors.color}) !important;` 
        : '';
      const prevLineStyle = index > 0 
        ? `background: linear-gradient(to right, ${getNodeColors(index - 1).color}, ${colors.color}) !important;` 
        : '';

      return (
        <li class="flex-1 relative">
          {index > 0 && (
            <hr 
              class="timeline-line-prev h-[4px] bg-[#141f26]/70 border-none transition-all duration-500 ease-in-out relative z-[1]" 
              style={prevLineStyle}
            />
          )}
          
          <button 
            class="timeline-middle timeline-node relative flex flex-col items-center group z-10 focus:outline-none cursor-pointer"
            data-index={index}
            data-color={colors.color}
            data-glow={colors.glow}
            data-shadow={colors.shadow}
            aria-label={`Jump to event year ${event.year}`}
          >
            <!-- The Node Dot with pulse ring -->
            <div class="relative flex items-center justify-center h-8 w-8 dot-wrapper">
              <!-- Pulse Ring -->
              <span class="pulse-ring absolute inset-0 rounded-full border opacity-0 hidden"></span>
              
              <!-- Circular Glow around the node -->
              <div 
                class="dot-glow" 
                style={`--node-glow: ${colors.glow};`}
              ></div>
              
              <!-- Core Dot -->
              <div 
                class="node-dot h-5 w-5 rounded-full border-[3px] border-[#080B10] bg-transparent transition-all duration-500 transform z-10"
              >
              </div>

              <!-- Left Edge Screen Extension (only for index 0) -->
              {index === 0 && (
                <div 
                  class="timeline-line-prev-extend h-[4px] transition-all duration-500 ease-in-out" 
                  style={`background: linear-gradient(to right, transparent 0%, ${colors.color} 100%) !important;`}
                />
              )}

              <!-- Right Edge Screen Extension (only for last index) -->
              {index === N - 1 && (
                <div 
                  class="timeline-line-next-extend h-[4px] transition-all duration-500 ease-in-out" 
                  style={`background: linear-gradient(to right, ${colors.color} 0%, transparent 100%) !important;`}
                />
              )}
            </div>
          </button>
          
          <div class="timeline-end mt-3 text-center w-full">
            <!-- Year Label -->
            <span class="node-year text-xs sm:text-sm font-bold text-text-muted transition-colors duration-300">
              {event.year}
            </span>
          </div>
          
          {index < N - 1 && (
            <hr 
              class="timeline-line-next h-[4px] bg-[#141f26]/70 border-none transition-all duration-500 ease-in-out relative z-[1]" 
              style={lineStyle}
            />
          )}
        </li>
      );
    })}
  </ul>
</div>

<style>
  #sliding-timeline {
    position: relative;
    left: 50%;
  }

  /* Edge extensions positioning */
  .timeline-line-prev-extend {
    position: absolute !important;
    right: calc(50% + 8px) !important;
    margin: 0 !important;
    transform: translateY(-50%) !important;
    top: 50% !important;
    z-index: 0 !important;
    opacity: 1 !important;
  }
  
  .timeline-line-next-extend {
    position: absolute !important;
    left:calc(50% + 8px) !important;
    margin: 0 !important;
    transform: translateY(-50%) !important;
    top: 50% !important;
    z-index: 0 !important;
    opacity: 1 !important;
  }

  /* Circular Glow behind each milestone node */
  .dot-glow {
    position: absolute;
    inset: -14px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--node-glow, rgba(0, 212, 255, 0.2)) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
    transition: all 0.5s ease-in-out;
  }

  /* DaisyUI timeline overrides */
  .timeline hr {
    height: 4px !important;
    border: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    border-radius: 0 !important;
    width: calc(100% + 16px) !important;
    position: relative !important;
    left: -8px !important;
  }

  .timeline-end {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  /* Active pulse animation */
  @keyframes subtle-pulse {
    0% {
      transform: scale(0.6);
      opacity: 0.6;
    }
    100% {
      transform: scale(1.6);
      opacity: 0;
    }
  }

  .active-pulse {
    display: block !important;
    animation: subtle-pulse 3s cubic-bezier(0.2, 0.8, 0.2, 1) infinite;
  }
</style>
