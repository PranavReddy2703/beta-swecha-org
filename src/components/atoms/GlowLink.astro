---
// src/components/atoms/GlowLink.astro
interface Props {
  href: string;
  class?: string;
}

const { href, class: className = "" } = Astro.props;
---

<a href={href} class={`glow-link ${className}`}>
  <slot />
</a>

<style>
  .glow-link {
    position: relative;
    z-index: 10;
    cursor: pointer !important;
    pointer-events: auto !important;
    background: linear-gradient(135deg, #00d4ff, #4dffb8) !important;
    -webkit-background-clip: text !important;
    -webkit-text-fill-color: transparent !important;
    font-weight: 700;
    display: inline-block;
    filter: drop-shadow(0 0 2px rgba(0, 212, 255, 0.5));
    transition:
      filter 0.3s cubic-bezier(0.25, 1, 0.5, 1),
      transform 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .glow-link:hover {
    filter: drop-shadow(0 0 8px rgba(0, 212, 255, 0.85))
      drop-shadow(0 0 16px rgba(77, 255, 180, 0.6)) !important;
    transform: translateY(-1px) scale(1.03) !important;
  }
</style>
