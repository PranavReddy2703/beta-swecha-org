---
// src/components/atoms/NavDropdown.astro
interface DropdownItem {
  name: string;
  href: string;
  icon?: string;
}

interface Props {
  label: string;
  items: DropdownItem[];
  isActive?: boolean;
}

const { label, items, isActive = false } = Astro.props;
---

<details class="dropdown" id="initiatives-dropdown">
  <summary
    class={`nav-link ${isActive ? "nav-link-active" : ""}`}
    data-active={isActive ? "true" : "false"}
  >
    <span class="nav-link-text">{label}</span>
    <span class="nav-link-indicator"></span>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="relative z-10 ml-1 transition-transform duration-300 dropdown-arrow"
    >
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </summary>
  <ul tabindex="0" class="dropdown-content menu nav-dropdown-content">
    {
      items.map((item) => {
        const suffix = item.href.split("/").filter(Boolean).pop() || "";
        return (
          <li>
            <a href={item.href} class={`dropdown-item item-${suffix}`}>
              {item.icon && <Fragment set:html={item.icon} />}
              <span>{item.name}</span>
            </a>
          </li>
        );
      })
    }
  </ul>
</details>

<style>
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.6rem;
    font-family: "Outfit", system-ui, sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    text-decoration: none;
    border-radius: 0.5rem;
    transition: color 0.25s ease;
    overflow: hidden;
    list-style: none;
    cursor: pointer;
  }

  .nav-link::-webkit-details-marker {
    display: none;
  }

  .nav-link-text {
    position: relative;
    z-index: 1;
  }

  .nav-link::before {
    content: "";
    position: absolute;
    inset: 4px;
    border-radius: 0.375rem;
    background: var(--elevated-surface);
    opacity: 0;
    transform: scale(0.85);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav-link:hover::before {
    opacity: 1;
    transform: scale(1);
  }

  .nav-link:hover {
    color: var(--primary-brand);
  }

  .nav-link:active {
    transform: scale(0.97);
  }

  .nav-link-indicator {
    position: absolute;
    bottom: 2px;
    left: 50%;
    width: 0;
    height: 2px;
    border-radius: 1px;
    background: linear-gradient(
      90deg,
      var(--primary-brand),
      var(--secondary-accent)
    );
    transform: translateX(-50%);
    transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 0 8px rgba(0, 212, 255, 0.4);
  }

  .nav-link:hover .nav-link-indicator {
    width: 60%;
  }

  .nav-link-active {
    color: var(--primary-brand);
  }

  .nav-link-active .nav-link-indicator {
    width: 70%;
  }

  .nav-link-active::before {
    opacity: 0.5;
    transform: scale(1);
  }

  details[open] .dropdown-arrow {
    transform: rotate(180deg);
  }

  /* Added styles mirroring LanguageSwitcher.astro */
  .nav-dropdown-content {
    margin-top: 0.75rem;
    padding: 0.5rem;
    min-width: 12rem;
    background: var(--card-bg);
    border: 1px solid var(--structural-borders);
    border-radius: 0.75rem;
    box-shadow:
      0 10px 40px rgba(0, 0, 0, 0.3),
      0 0 0 1px color-mix(in srgb, var(--primary-brand) 8%, transparent);
    list-style: none;
    z-index: 100;
    backdrop-filter: blur(20px);
    animation: dropdownReveal 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  @keyframes dropdownReveal {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .dropdown-item {
    display: flex;
    align-items: center;
    padding: 0.5rem 0.75rem;
    font-family: "Outfit", system-ui, sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    text-decoration: none;
    border-radius: 0.5rem;
    transition: all 0.25s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .dropdown-item :global(svg) {
    transition: all 0.25s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .dropdown-item:hover {
    padding-left: 1.25rem;
  }

  .dropdown-item:hover :global(svg) {
    transform: scale(1.1);
  }

  /* Vishwam AI: Purple / Indigo */
  .item-vishwam-ai:hover {
    background: linear-gradient(
      135deg,
      rgba(167, 139, 250, 0.12),
      rgba(99, 102, 241, 0.06)
    );
    color: #a78bfa;
    box-shadow:
      inset 0 0 0 1px rgba(167, 139, 250, 0.15),
      0 4px 12px rgba(167, 139, 250, 0.08);
  }
  .item-vishwam-ai:hover :global(svg) {
    color: #a78bfa !important;
    filter: drop-shadow(0 0 6px rgba(167, 139, 250, 0.7));
  }

  /* Dev Days: Amber / Orange */
  .item-devdays:hover {
    background: linear-gradient(
      135deg,
      rgba(251, 191, 36, 0.12),
      rgba(249, 115, 22, 0.06)
    );
    color: #fbbf24;
    box-shadow:
      inset 0 0 0 1px rgba(251, 191, 36, 0.15),
      0 4px 12px rgba(251, 191, 36, 0.08);
  }
  .item-devdays:hover :global(svg) {
    color: #fbbf24 !important;
    filter: drop-shadow(0 0 6px rgba(251, 191, 36, 0.7));
  }

  /* People's Health: Emerald / Mint Green */
  .item-peoples-health:hover {
    background: linear-gradient(
      135deg,
      rgba(52, 211, 153, 0.12),
      rgba(20, 184, 166, 0.06)
    );
    color: #34d399;
    box-shadow:
      inset 0 0 0 1px rgba(52, 211, 153, 0.15),
      0 4px 12px rgba(52, 211, 153, 0.08);
  }
  .item-peoples-health:hover :global(svg) {
    color: #34d399 !important;
    filter: drop-shadow(0 0 6px rgba(52, 211, 153, 0.7));
  }

  /* Code4Change: Vibrant Rose / Pink */
  .item-code4change:hover {
    background: linear-gradient(
      135deg,
      rgba(244, 63, 94, 0.12),
      rgba(236, 72, 153, 0.06)
    );
    color: #f43f5e;
    box-shadow:
      inset 0 0 0 1px rgba(244, 63, 94, 0.15),
      0 4px 12px rgba(244, 63, 94, 0.08);
  }
  .item-code4change:hover :global(svg) {
    color: #f43f5e !important;
    filter: drop-shadow(0 0 6px rgba(244, 63, 94, 0.7));
  }

  /* Voluntary Computing: Electric Blue */
  .item-voluntary-computing:hover {
    background: linear-gradient(
      135deg,
      rgba(59, 130, 246, 0.12),
      rgba(96, 165, 250, 0.06)
    );
    color: #3b82f6;
    box-shadow:
      inset 0 0 0 1px rgba(59, 130, 246, 0.15),
      0 4px 12px rgba(59, 130, 246, 0.08);
  }
  .item-voluntary-computing:hover :global(svg) {
    color: #3b82f6 !important;
    filter: drop-shadow(0 0 6px rgba(59, 130, 246, 0.7));
  }
</style>

<script>
  // Close details dropdowns when clicking outside
  document.addEventListener("click", (event) => {
    const dropdowns = document.querySelectorAll("details.dropdown");
    dropdowns.forEach((dropdown) => {
      if (
        dropdown.hasAttribute("open") &&
        !dropdown.contains(event.target as Node)
      ) {
        dropdown.removeAttribute("open");
      }
    });
  });
</script>
