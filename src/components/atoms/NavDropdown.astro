---
// src/components/atoms/NavDropdown.astro
interface DropdownItem {
  name: string;
  href: string;
  icon?: string;
}

interface Props {
  label: string;
  items: DropdownItem[];
  isActive?: boolean;
}

const { label, items, isActive = false } = Astro.props;
---

<details class="dropdown" id="initiatives-dropdown">
  <summary class={`nav-link ${isActive ? 'nav-link-active' : ''}`} data-active={isActive ? 'true' : 'false'}>
    <span class="nav-link-text">{label}</span>
    <span class="nav-link-indicator"></span>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="relative z-10 ml-1 transition-transform duration-300 dropdown-arrow">
      <path d="m6 9 6 6 6-6"/>
    </svg>
  </summary>
  <ul tabindex="0" class="dropdown-content menu nav-dropdown-content">
    {items.map(item => (
      <li>
        <a href={item.href} class="flex items-center text-text-muted hover:text-primary-brand hover:bg-elevated-surface transition-colors font-semibold py-2 px-3 rounded-md">
          {item.icon && <Fragment set:html={item.icon} />}
          {item.name}
        </a>
      </li>
    ))}
  </ul>
</details>

<style>
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.875rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-muted);
    text-decoration: none;
    border-radius: 0.5rem;
    transition: color 0.25s ease;
    overflow: hidden;
    list-style: none;
    cursor: pointer;
  }

  .nav-link::-webkit-details-marker {
    display: none;
  }

  .nav-link-text {
    position: relative;
    z-index: 1;
  }

  .nav-link::before {
    content: '';
    position: absolute;
    inset: 4px;
    border-radius: 0.375rem;
    background: var(--elevated-surface);
    opacity: 0;
    transform: scale(0.85);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav-link:hover::before {
    opacity: 1;
    transform: scale(1);
  }

  .nav-link:hover {
    color: var(--primary-brand);
  }

  .nav-link:active {
    transform: scale(0.97);
  }

  .nav-link-indicator {
    position: absolute;
    bottom: 2px;
    left: 50%;
    width: 0;
    height: 2px;
    border-radius: 1px;
    background: linear-gradient(90deg, var(--primary-brand), var(--secondary-accent));
    transform: translateX(-50%);
    transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 0 8px rgba(0, 212, 255, 0.4);
  }

  .nav-link:hover .nav-link-indicator {
    width: 60%;
  }

  .nav-link-active {
    color: var(--primary-brand);
  }

  .nav-link-active .nav-link-indicator {
    width: 70%;
  }

  .nav-link-active::before {
    opacity: 0.5;
    transform: scale(1);
  }
  
  details[open] .dropdown-arrow {
    transform: rotate(180deg);
  }

  /* Added styles mirroring LanguageSwitcher.astro */
  .nav-dropdown-content {
    margin-top: 0.75rem;
    padding: 0.5rem;
    min-width: 12rem;
    background: var(--card-bg);
    border: 1px solid var(--structural-borders);
    border-radius: 0.75rem;
    box-shadow:
      0 10px 40px rgba(0, 0, 0, 0.3),
      0 0 0 1px color-mix(in srgb, var(--primary-brand) 8%, transparent);
    list-style: none;
    z-index: 100;
    backdrop-filter: blur(20px);
    animation: dropdownReveal 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  @keyframes dropdownReveal {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
</style>

<script>
  // Close details dropdowns when clicking outside
  document.addEventListener('click', (event) => {
    const dropdowns = document.querySelectorAll('details.dropdown');
    dropdowns.forEach((dropdown) => {
      if (dropdown.hasAttribute('open') && !dropdown.contains(event.target as Node)) {
        dropdown.removeAttribute('open');
      }
    });
  });
</script>
