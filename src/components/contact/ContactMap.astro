---
// src/components/contact/ContactMap.astro
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="relative w-full group">
  <!-- Border glow background element -->
  <div class="absolute inset-0 pointer-events-none rounded-2xl bg-gradient-to-r from-primary-brand/10 to-secondary-accent/10 blur-xl opacity-80 group-hover:opacity-100 transition-opacity duration-500"></div>

  <!-- Map Container -->
  <div class="relative w-full rounded-2xl border border-structural-borders bg-card-bg/40 backdrop-blur-xl p-2.5 overflow-hidden transition-all duration-500 hover:border-primary-brand/40 shadow-2xl">
    
    <!-- Header/Title -->
    <div class="flex items-center justify-between mb-3 px-2 py-1 select-none">
      <div class="flex items-center space-x-2">
        <span class="inline-flex h-2 w-2 rounded-full bg-secondary-accent animate-pulse"></span>
        <span class="text-xs font-bold uppercase tracking-wider text-text-muted">{title}</span>
      </div>
      <div class="text-[10px] text-text-muted/50 font-mono">NODE_COORD: 17.4196° N, 78.3496° E</div>
    </div>

    <!-- Map iframe container with responsive heights matching spec -->
    <div class="relative w-full h-[320px] md:h-[400px] lg:h-[550px] rounded-xl overflow-hidden border border-structural-borders/30 bg-canvas-base">
      <iframe 
        title="Interactive Google Map showing Swecha Office location"
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3806.962057761066!2d78.3496057751656!3d17.419614483488734!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3bcb935515233157%3A0x1d4d38e21703666b!2sSwecha!5e0!3m2!1sen!2sin!4v1718531234567!5m2!1sen!2sin" 
        class="absolute inset-0 w-full h-full border-0 grayscale invert contrast-125 opacity-75 hover:opacity-100 hover:filter-none transition-all duration-700" 
        allowfullscreen="" 
        loading="lazy" 
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </div>
</div>
