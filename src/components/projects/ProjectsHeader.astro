---
// src/components/projects/ProjectsHeader.astro
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<header
  class="relative overflow-hidden bg-canvas-base border-b border-structural-borders/30 pt-24 pb-16 md:pt-32 md:pb-20"
>
  <!-- Glowing neon background effect -->
  <div class="absolute inset-0 pointer-events-none opacity-20">
    <div
      class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full bg-primary-brand/30 blur-[120px]"
    >
    </div>
  </div>

  <div class="container mx-auto px-4 relative z-10 text-center max-w-3xl">
    <p class="text-lg md:text-xl text-slate-300 leading-relaxed">
      {description}
    </p>
  </div>
</header>
