---
// src/components/news/EditorialNewsCard.astro
import CategoryBadge from "../atoms/CategoryBadge.astro";

interface Props {
  article: {
    id: string;
    title: Record<string, string>;
    description: Record<string, string>;
    summary: Record<string, string>;
    author: Record<string, string>;
    date: Record<string, string>;
    readingTime: Record<string, string>;
    publication: string;
    publicationLogo?: string;
    category: Record<string, string>;
    image: string;
    url: string;
    year: number;
  };
  lang: string;
  isLarge?: boolean;
}

const { article, lang, isLarge = false } = Astro.props;

const localizedTitle = article.title[lang] || article.title["en"];
const localizedDesc = article.description[lang] || article.description["en"];
const localizedCategory = article.category[lang] || article.category["en"];
const localizedAuthor = article.author[lang] || article.author["en"];
const localizedDate = article.date[lang] || article.date["en"];
const localizedReadingTime =
  article.readingTime[lang] || article.readingTime["en"];

// Get publication short code logo
const pubLogo =
  article.publicationLogo || article.publication.slice(0, 2).toUpperCase();
---

{
  isLarge ? (
    /* LARGE FEATURED EDITORIAL CARD (Horizontal on Desktop, Stacked on Mobile) */
    <div
      data-article-id={article.id}
      data-category={article.category.en.toLowerCase().replace(/ /g, "-")}
      data-year={article.year}
      data-publication={article.publication.toLowerCase()}
      class="article-card group relative overflow-hidden rounded-2xl border border-structural-borders/80 bg-card-bg/20 backdrop-blur-xl transition-all duration-500 flex flex-col lg:flex-row gap-6 p-6 md:p-8 cursor-pointer shadow-lg hover:shadow-2xl hover:border-primary-brand/35 select-none"
    >
      {/* Background Glows */}
      <div class="absolute -top-12 -left-12 w-48 h-48 bg-primary-brand/10 rounded-full blur-[80px] pointer-events-none group-hover:bg-primary-brand/15 transition-all duration-700" />
      <div class="absolute -bottom-16 -right-16 w-52 h-52 bg-secondary-accent/8 rounded-full blur-[90px] pointer-events-none group-hover:bg-secondary-accent/12 transition-all duration-700" />

      {/* Text Side */}
      <div class="flex-1 flex flex-col justify-between order-2 lg:order-1 relative z-10 space-y-4">
        <div class="space-y-3">
          {/* Publication Header */}
          <div class="flex items-center gap-2.5">
            {pubLogo.startsWith("/") ? (
              <img
                src={pubLogo}
                alt={article.publication}
                class="w-6.5 h-6.5 object-cover rounded-md shadow-sm shrink-0"
              />
            ) : (
              <span class="flex items-center justify-center w-6.5 h-6.5 rounded-md bg-gradient-to-br from-primary-brand to-secondary-accent text-[10px] font-black text-slate-950 select-none shadow-sm shrink-0">
                {pubLogo}
              </span>
            )}
            <span class="text-xs font-bold text-text-main tracking-wide">
              {article.publication}
            </span>
            <span class="text-text-muted/40">•</span>
            <span class="text-[10px] font-bold text-text-muted">
              {localizedDate}
            </span>
          </div>

          <div class="space-y-2">
            <h2 class="featured-title text-xl md:text-2xl lg:text-3xl font-black text-text-main group-hover:text-transparent group-hover:bg-clip-text group-hover:bg-gradient-to-r group-hover:from-primary-brand group-hover:to-secondary-accent transition-all duration-300 leading-tight tracking-tight">
              {localizedTitle}
            </h2>
            <p class="text-xs md:text-sm text-text-muted leading-relaxed font-medium">
              {localizedDesc}
            </p>
          </div>
        </div>

        <div class="flex items-center justify-between pt-4 border-t border-structural-borders/30">
          <div class="flex items-center gap-3">
            <CategoryBadge text={localizedCategory} variant="green" />
            <span class="text-[10px] font-bold text-text-muted font-mono">
              {localizedReadingTime}
            </span>
          </div>

          <span class="flex items-center gap-1 text-[11px] font-black text-primary-brand group-hover:text-secondary-accent transition-colors duration-300">
            {lang === "te"
              ? "వ్యాసం చూడండి"
              : lang === "hi"
                ? "विवरण देखें"
                : "View Article"}
            <svg
              class="h-3 w-3 transform transition-transform duration-300 group-hover:translate-x-0.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M14 5l7 7m0 0l-7 7m7-7H3"
              />
            </svg>
          </span>
        </div>
      </div>

      {/* Image Side */}
      <div class="w-full lg:w-[45%] overflow-hidden rounded-xl bg-slate-950 order-1 lg:order-2 aspect-[16/9.5] lg:aspect-auto lg:self-stretch min-h-[180px] lg:min-h-0 relative z-0 border border-structural-borders/40">
        <div class="absolute inset-0 bg-gradient-to-t lg:bg-gradient-to-r from-slate-950/60 via-transparent to-transparent opacity-50 z-10 pointer-events-none" />
        <img
          src={article.image}
          alt={localizedTitle}
          class="absolute inset-0 h-full w-full object-cover object-center transition-all duration-700 ease-in-out group-hover:scale-[1.03]"
        />
      </div>
    </div>
  ) : (
    /* COMPACT GOOGLE NEWS CARD (Text on Left, Square Thumbnail on Right) */
    <div
      data-article-id={article.id}
      data-category={article.category.en.toLowerCase().replace(/ /g, "-")}
      data-year={article.year}
      data-publication={article.publication.toLowerCase()}
      class="article-card group relative overflow-hidden rounded-2xl border border-structural-borders bg-secondary-bg/25 hover:bg-secondary-bg/40 backdrop-blur-md transition-all duration-300 flex justify-between gap-4 p-4 md:p-5 cursor-pointer shadow-sm hover:shadow-md hover:border-primary-brand/35 select-none"
    >
      {/* Text Left */}
      <div class="flex-1 flex flex-col justify-between space-y-3.5 z-10 min-w-0">
        <div class="space-y-2">
          {/* Publisher Metadata */}
          <div class="flex items-center gap-2 max-w-full">
            {pubLogo.startsWith("/") ? (
              <img
                src={pubLogo}
                alt={article.publication}
                class="w-5 h-5 object-cover rounded shadow-sm shrink-0"
              />
            ) : (
              <span class="flex items-center justify-center w-5 h-5 rounded bg-gradient-to-br from-primary-brand/80 to-secondary-accent/80 text-[8px] font-black text-slate-950 select-none shadow-sm shrink-0">
                {pubLogo}
              </span>
            )}
            <span class="text-[10px] font-bold text-text-main truncate shrink-0 max-w-[120px]">
              {article.publication}
            </span>
            <span class="text-text-muted/30 text-[9px]">•</span>
            <span class="text-[9px] font-bold text-text-muted shrink-0">
              {localizedDate}
            </span>
          </div>

          <h3 class="text-sm md:text-base font-black tracking-tight text-text-main group-hover:text-primary-brand transition-colors duration-300 leading-snug line-clamp-2 md:line-clamp-3">
            {localizedTitle}
          </h3>

          <p class="text-xs text-text-muted leading-relaxed font-medium line-clamp-2 hidden md:block">
            {localizedDesc}
          </p>
        </div>

        <div class="flex items-center gap-2.5 pt-0.5">
          <CategoryBadge text={localizedCategory} variant="cyan" />
          <span class="text-[9px] font-bold text-text-muted font-mono">
            {localizedReadingTime}
          </span>
        </div>
      </div>

      {/* Square Thumbnail Right */}
      <div class="w-20 h-20 md:w-24 md:h-24 overflow-hidden rounded-xl bg-slate-950 shrink-0 border border-structural-borders/30 relative">
        <img
          src={article.image}
          alt={localizedTitle}
          class="h-full w-full object-cover object-center transition-transform duration-500 ease-out group-hover:scale-[1.02]"
        />
      </div>
    </div>
  )
}

<style>
  /* Light mode title color enhancements */
  :global(html[data-theme="light"]) .featured-title {
    background: none !important;
    color: #0b1e36 !important;
    -webkit-text-fill-color: #0b1e36 !important;
  }
  :global(html[data-theme="light"]) .group:hover .featured-title {
    color: var(--primary-brand) !important;
  }
</style>
