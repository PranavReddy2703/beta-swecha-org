---
// src/components/organisms/Footer.astro
import SocialIcon from '../atoms/SocialIcon.astro';
import socialIconsData from '../../data/atoms/socialIcons.json';
import footerData from '../../data/organisms/footer.json';
import type { SocialIconData } from '../types/index';

const typedIcons = socialIconsData as SocialIconData[];
const copyrightText = footerData.copyrightTemplate.replace('{year}', new Date().getFullYear().toString());
---

<footer class="w-full border-t border-structural-borders bg-secondary-bg/30 backdrop-blur-md py-5 transition-colors duration-300">
  <div class="px-10 sm:px-16 lg:px-24">
    <div class="flex items-center justify-between">
      <div class="text-xs text-text-muted/60">
        {copyrightText}
      </div>
      <div class="flex items-center gap-4">
        {typedIcons.map((icon) => (
          <SocialIcon
            href={icon.href}
            label={icon.label}
            platform={icon.platform}
          />
        ))}
      </div>
    </div>
  </div>
</footer>
