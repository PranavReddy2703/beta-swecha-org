---
// src/components/organisms/MobileDrawer.astro
import MobileNavLink from '../atoms/MobileNavLink.astro';

interface NavItem {
  name: string;
  href: string;
  isDropdown?: boolean;
  children?: { name: string; href: string }[];
}

interface Props {
  navItems: NavItem[];
  isCurrentPage: (href: string) => boolean;
}

const { navItems, isCurrentPage } = Astro.props;
---

<div id="mobile-menu" class="mobile-drawer md:hidden">
  <div class="mobile-drawer-inner">
    {navItems.map((item, index) => (
      item.isDropdown && item.children ? (
        <div class="mobile-nav-group mb-2">
          <div class="relative mobile-dropdown-btn group cursor-pointer" aria-expanded="false">
            <div class="pointer-events-none">
              <MobileNavLink
                href="#"
                label={item.name}
                isActive={isCurrentPage(item.href)}
                index={index}
              />
            </div>
            <div class="absolute right-2 top-1/2 -translate-y-1/2 p-3 text-text-muted group-hover:text-text-main">
              <svg class="w-5 h-5 transition-transform duration-300 mobile-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
            </div>
          </div>
          <div class="mobile-dropdown-content flex flex-col pl-3 border-l-2 ml-5 mt-1 overflow-hidden transition-all duration-300" style="border-color: rgba(148, 163, 184, 0.4); max-height: 0; opacity: 0; margin-bottom: 0;">
            {item.children.map((child, childIndex) => (
              <MobileNavLink
                href={child.href}
                label={child.name}
                isActive={isCurrentPage(child.href)}
                index={0}
                isSubLink={true}
              />
            ))}
          </div>
        </div>
      ) : (
        <MobileNavLink
          href={item.href}
          label={item.name}
          isActive={isCurrentPage(item.href)}
          index={index}
        />
      )
    ))}
  </div>
</div>

<style>
  .mobile-drawer {
    max-height: 0;
    overflow: hidden;
    border-top: 1px solid transparent;
    background: color-mix(in srgb, var(--secondary-bg) 95%, transparent);
    backdrop-filter: blur(20px);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .mobile-drawer-open {
    max-height: 48rem;
    overflow-y: auto;
    border-top-color: var(--structural-borders);
  }

  .mobile-drawer-inner {
    padding: 0.75rem 1rem 1rem;
  }
</style>

<script>
  const setupMobileDropdowns = () => {
    const dropdownBtns = document.querySelectorAll('.mobile-dropdown-btn');
    dropdownBtns.forEach(btn => {
      // Remove any existing listeners by cloning (defensive)
      const clone = btn.cloneNode(true) as HTMLElement;
      if (btn.parentNode) {
        btn.parentNode.replaceChild(clone, btn);
      }
      
      clone.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        
        const content = clone.nextElementSibling as HTMLElement;
        const isExpanded = clone.getAttribute('aria-expanded') === 'true';
        const chevron = clone.querySelector('.mobile-chevron') as HTMLElement;
        
        if (isExpanded) {
          clone.setAttribute('aria-expanded', 'false');
          if (chevron) chevron.style.transform = 'rotate(0deg)';
          if (content) {
            content.style.maxHeight = '0';
            content.style.opacity = '0';
            content.style.marginBottom = '0';
          }
        } else {
          clone.setAttribute('aria-expanded', 'true');
          if (chevron) chevron.style.transform = 'rotate(180deg)';
          if (content) {
            content.style.maxHeight = '500px';
            content.style.opacity = '1';
            content.style.marginBottom = '0.5rem';
          }
        }
      });
    });
  };

  // Run on initial load and any subsequent view transitions
  setupMobileDropdowns();
  document.addEventListener('astro:after-swap', setupMobileDropdowns);
</script>
