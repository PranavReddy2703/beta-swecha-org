---
// src/components/organisms/MobileDrawer.astro
import MobileNavLink from '../atoms/MobileNavLink.astro';
import { getLangFromUrl } from '../../i18n/utils';
import { languages, defaultLang } from '../../i18n/ui';

interface NavItem {
  name: string;
  href: string;
}

interface Props {
  navItems: NavItem[];
  isCurrentPage: (href: string) => boolean;
}

const { navItems, isCurrentPage } = Astro.props;

const lang = getLangFromUrl(Astro.url);

const languagesList = Object.entries(languages).map(([code, name]) => ({
  code,
  name,
}));

const getPathnameWithoutLang = (pathname: string) => {
  const parts = pathname.split('/');
  if (parts[1] && parts[1] in languages) {
    parts.splice(1, 1);
  }
  return parts.join('/') || '/';
};

const cleanPath = getPathnameWithoutLang(Astro.url.pathname);
---

<div id="mobile-menu" class="mobile-drawer md:hidden">
  <div class="mobile-drawer-inner">
    {navItems.map((item, index) => (
      <MobileNavLink
        href={item.href}
        label={item.name}
        isActive={isCurrentPage(item.href)}
        index={index}
      />
    ))}

    <!-- Mobile Language Divider & Selection -->
    <div class="mobile-divider"></div>
    <p class="text-xs font-semibold uppercase tracking-wider text-text-muted mb-3 px-3">Select Language</p>
    <div class="grid grid-cols-3 gap-2 px-3 pb-2">
      {languagesList.map((langOption) => {
        const targetHref = langOption.code === defaultLang
          ? cleanPath
          : `/${langOption.code}${cleanPath === '/' ? '' : cleanPath}`;

        return (
          <a
            href={targetHref}
            class={`mobile-lang-btn ${lang === langOption.code ? 'mobile-lang-btn-active' : ''}`}
          >
            {langOption.name}
          </a>
        );
      })}
    </div>
  </div>
</div>

<style>
  .mobile-drawer {
    max-height: 0;
    overflow: hidden;
    border-top: 1px solid transparent;
    background: color-mix(in srgb, var(--secondary-bg) 95%, transparent);
    backdrop-filter: blur(20px);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .mobile-drawer-open {
    max-height: 32rem;
    border-top-color: var(--structural-borders);
  }

  .mobile-drawer-inner {
    padding: 0.75rem 1rem 1rem;
  }

  .mobile-divider {
    margin: 0.75rem 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--structural-borders),
      transparent
    );
  }

  .mobile-lang-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    border-radius: 0.5rem;
    border: 1px solid var(--structural-borders);
    background: color-mix(in srgb, var(--card-bg) 50%, transparent);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .mobile-lang-btn:hover {
    background: var(--elevated-surface);
    color: var(--primary-brand);
    border-color: color-mix(in srgb, var(--primary-brand) 40%, transparent);
    transform: translateY(-1px);
  }

  .mobile-lang-btn-active {
    border-color: var(--primary-brand);
    color: var(--primary-brand);
    background: color-mix(in srgb, var(--primary-brand) 10%, transparent);
  }
</style>
