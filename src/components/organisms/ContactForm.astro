---
// src/components/contact/ContactForm.astro
interface Props {
  title: string;
  subtitle: string;
  nameLabel: string;
  emailLabel: string;
  subjectLabel: string;
  messageLabel: string;
  sendButtonText: string;
}

const { title, subtitle, nameLabel, emailLabel, subjectLabel, messageLabel, sendButtonText } = Astro.props;
---

<div class="glass-white-card group relative overflow-hidden rounded-2xl border border-structural-borders bg-card-bg/40 p-5 md:p-6 backdrop-blur-xl transition-all duration-300 hover:border-primary-brand/30 hover:shadow-[0_0_25px_rgba(0,212,255,0.05)] select-none h-full flex flex-col">
  <!-- Interactive backglow decoration -->
  <div class="absolute -right-20 -bottom-20 h-40 w-40 rounded-full bg-secondary-accent/5 blur-3xl group-hover:bg-secondary-accent/8 transition-all duration-500"></div>
  <div class="absolute -left-20 -top-20 h-40 w-40 rounded-full bg-primary-brand/5 blur-3xl group-hover:bg-primary-brand/8 transition-all duration-500"></div>

  <div class="mb-5 relative z-10">
    <h3 class="text-xl md:text-2xl font-extrabold text-text-main group-hover:text-primary-brand transition-colors duration-300">
      {title}
    </h3>
    <p class="text-xs text-text-muted mt-1.5">
      {subtitle}
    </p>
  </div>

  <!-- Success Message Container -->
  <div id="rebuilt-form-success" class="hidden flex-col items-center justify-center py-10 text-center relative z-10 transition-all duration-500 animate-fade-in flex-grow">
    <div class="p-3.5 rounded-full bg-secondary-accent/10 text-secondary-accent border border-secondary-accent/20 mb-4 shadow-[0_0_15px_rgba(77,255,184,0.1)]">
      <svg class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    </div>
    <h4 class="text-xl font-black text-text-main mb-2">Message Sent!</h4>
    <p class="text-xs text-text-muted max-w-sm mb-6 leading-relaxed">
      Your transmission has been broadcasted successfully. A Swecha community coordinator will establish contact shortly.
    </p>
    <button 
      id="rebuilt-reset-form"
      type="button"
      class="inline-flex items-center justify-center rounded-lg border border-structural-borders bg-card-bg/60 px-4 py-2.5 text-xs font-bold text-text-main backdrop-blur-md transition-all duration-200 hover:border-primary-brand/40 hover:text-primary-brand hover:bg-elevated-surface"
    >
      Send Another Message
    </button>
  </div>

  <!-- Main Form stacked vertically -->
  <form id="rebuilt-contact-form" class="space-y-4 relative z-10 transition-all duration-300">
    
    <!-- Name Field -->
    <div class="space-y-1.5">
      <label for="input-name" class="block text-xs font-semibold text-text-main">{nameLabel} <span class="text-primary-brand">*</span></label>
      <input 
        type="text" 
        id="input-name" 
        name="name" 
        required 
        placeholder="First & last name"
        class="w-full rounded-lg border border-structural-borders/80 bg-canvas-base/80 px-3.5 py-2.5 text-sm text-text-main placeholder-text-muted/40 focus:border-primary-brand focus:ring-1 focus:ring-primary-brand focus:shadow-[0_0_10px_rgba(0,212,255,0.25)] focus:outline-none transition-all duration-200"
      />
    </div>

    <!-- Email Field -->
    <div class="space-y-1.5">
      <label for="input-email" class="block text-xs font-semibold text-text-main">{emailLabel} <span class="text-primary-brand">*</span></label>
      <input 
        type="email" 
        id="input-email" 
        name="email" 
        required 
        placeholder="yourname@domain.com"
        class="w-full rounded-lg border border-structural-borders/80 bg-canvas-base/80 px-3.5 py-2.5 text-sm text-text-main placeholder-text-muted/40 focus:border-primary-brand focus:ring-1 focus:ring-primary-brand focus:shadow-[0_0_10px_rgba(0,212,255,0.25)] focus:outline-none transition-all duration-200"
      />
    </div>

    <!-- Subject Field -->
    <div class="space-y-1.5">
      <label for="input-subject" class="block text-xs font-semibold text-text-main">{subjectLabel} <span class="text-primary-brand">*</span></label>
      <input 
        type="text" 
        id="input-subject" 
        name="subject" 
        required 
        placeholder="What is this transmission regarding?"
        class="w-full rounded-lg border border-structural-borders/80 bg-canvas-base/80 px-3.5 py-2.5 text-sm text-text-main placeholder-text-muted/40 focus:border-primary-brand focus:ring-1 focus:ring-primary-brand focus:shadow-[0_0_10px_rgba(0,212,255,0.25)] focus:outline-none transition-all duration-200"
      />
    </div>

    <!-- Message Field -->
    <div class="space-y-1.5">
      <label for="input-message" class="block text-xs font-semibold text-text-main">{messageLabel} <span class="text-primary-brand">*</span></label>
      <textarea 
        id="input-message" 
        name="message" 
        required 
        rows="4"
        placeholder="Write your transmission details..."
        class="w-full rounded-lg border border-structural-borders/80 bg-canvas-base/80 px-3.5 py-2.5 text-sm text-text-main placeholder-text-muted/40 focus:border-primary-brand focus:ring-1 focus:ring-primary-brand focus:shadow-[0_0_10px_rgba(0,212,255,0.25)] focus:outline-none transition-all duration-200 resize-y min-h-[100px]"
      ></textarea>
    </div>

    <!-- Submit Button with Shine Effect & PaperPlane -->
    <div class="pt-2">
      <button 
        type="submit" 
        class="shine-button w-full inline-flex items-center justify-center rounded-lg bg-gradient-to-r from-primary-brand to-secondary-accent py-3 px-6 text-sm font-black text-canvas-base shadow-md shadow-primary-brand/10 transition-all duration-300 hover:from-hover-brand hover:to-secondary-accent hover:shadow-lg hover:shadow-primary-brand/20 active:scale-[0.99] focus:outline-none focus:ring-2 focus:ring-primary-brand"
      >
        <span>{sendButtonText}</span>
        <svg class="ml-2 h-4 w-4 transform transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
        </svg>
      </button>
    </div>
  </form>
</div>

<style>
  /* Button shine animation settings */
  .shine-button {
    position: relative;
    overflow: hidden;
  }
  
  .shine-button::after {
    content: '';
    position: absolute;
    top: -50%;
    left: -70%;
    width: 30%;
    height: 200%;
    background: linear-gradient(
      to right,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0.4) 50%,
      rgba(255, 255, 255, 0) 100%
    );
    transform: rotate(25deg);
    transition: none;
    pointer-events: none;
  }

  .shine-button:hover::after {
    left: 130%;
    transition: left 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Fade-in transitions */
  @keyframes fadeIn {
    from { opacity: 0; transform: scale(0.97); }
    to { opacity: 1; transform: scale(1); }
  }
  .animate-fade-in {
    animation: fadeIn 0.4s ease-out forwards;
  }
</style>

<script>
  const form = document.getElementById('rebuilt-contact-form') as HTMLFormElement | null;
  const successContainer = document.getElementById('rebuilt-form-success');
  const resetBtn = document.getElementById('rebuilt-reset-form');

  if (form && successContainer && resetBtn) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      // Submit loading animation state
      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const originalContent = submitBtn.innerHTML;
      submitBtn.disabled = true;
      submitBtn.innerHTML = `
        <svg class="animate-spin h-4 w-4 mr-2 text-canvas-base inline-block" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg> Sending...`;

      // Measure and lock the card height to prevent it from shrinking during transitions
      const card = form.closest('.group') as HTMLElement | null;
      if (card) {
        const rect = card.getBoundingClientRect();
        card.style.minHeight = `${rect.height}px`;
      }

      // Simulating API transport latency
      setTimeout(() => {
        form.reset();
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalContent;

        form.classList.add('hidden');
        successContainer.classList.remove('hidden');
        successContainer.classList.add('flex');
      }, 700);
    });

    resetBtn.addEventListener('click', () => {
      const card = form.closest('.group') as HTMLElement | null;
      if (card) {
        card.style.minHeight = '';
      }
      successContainer.classList.add('hidden');
      successContainer.classList.remove('flex');
      form.classList.remove('hidden');
    });
  }
</script>
