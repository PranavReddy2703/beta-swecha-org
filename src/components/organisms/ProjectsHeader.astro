---
// src/components/projects/ProjectsHeader.astro
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<header
  class="relative overflow-hidden border-b border-structural-borders/30 pt-24 pb-16 md:pt-32 md:pb-20"
>

  <div class="container mx-auto px-4 relative z-10 text-center max-w-3xl">
    <p class="text-lg md:text-xl text-slate-300 leading-relaxed">
      {description}
    </p>
  </div>
</header>
