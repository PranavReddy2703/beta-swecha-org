---
// src/components/AboutSection.astro
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const paragraphs = [
  t('about.p1'),
  t('about.p2'),
  t('about.p3'),
  t('about.p4')
];
---

<section id="about" class="py-20 min-h-[calc(100vh-4rem)] flex flex-col justify-center bg-transparent border-t border-structural-borders/30 relative overflow-hidden transition-colors duration-300">
  <!-- Background glow decorations -->
  <div class="absolute inset-0 pointer-events-none opacity-20">
    <div class="absolute -top-40 left-1/4 h-[500px] w-[500px] rounded-full bg-primary-brand blur-[120px]"></div>
    <div class="absolute bottom-10 right-1/4 h-[400px] w-[400px] rounded-full bg-secondary-accent blur-[120px]"></div>
  </div>

  <div class="container mx-auto px-4 max-w-7xl relative z-10">
    <!-- Content Block with random ambient outline glow -->
    <div class="about-card relative bg-card-bg/15 border border-structural-borders/30 backdrop-blur-md rounded-xl p-8 sm:p-12 shadow-xl hover:border-primary-brand/35 transition-all duration-500 max-w-7xl mx-auto w-full animate-random-glow">
      <div class="space-y-6 text-center text-text-main/70 leading-relaxed font-normal">
        {paragraphs.map((p, index) => (
          <p 
            class="text-base sm:text-lg opacity-0 translate-y-3 animate-fade-in-up cursor-default"
            style={`animation-delay: ${index * 150 + 150}ms;`}
          >
            <span class="block hover-lift">
              <Fragment set:html={p} />
            </span>
          </p>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* Custom Scoped Animations */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Randomly fluctuating outline glows (Cyan/Mint) for the container border & shadow */
  @keyframes randomGlow {
    0%, 100% {
      box-shadow: 0 0 20px 2px rgba(0, 212, 255, 0.12), inset 0 0 12px 1px rgba(0, 212, 255, 0.04);
      border-color: rgba(0, 212, 255, 0.2);
    }
    25% {
      box-shadow: 0 0 35px 5px rgba(0, 212, 255, 0.35), inset 0 0 16px 2px rgba(0, 212, 255, 0.1);
      border-color: rgba(0, 212, 255, 0.45);
    }
    50% {
      box-shadow: 0 0 25px 3px rgba(77, 255, 180, 0.22), inset 0 0 12px 1px rgba(77, 255, 180, 0.08);
      border-color: rgba(77, 255, 180, 0.3);
    }
    75% {
      box-shadow: 0 0 40px 6px rgba(0, 212, 255, 0.42), inset 0 0 20px 3px rgba(0, 212, 255, 0.15);
      border-color: rgba(0, 212, 255, 0.5);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.6s cubic-bezier(0.25, 1, 0.5, 1) forwards;
  }

  .animate-random-glow {
    animation: randomGlow 10s infinite ease-in-out;
  }

  /* Randomly fluctuating outline glows for light mode (soft sky blue & emerald green) with baseline depth shadows */
  @keyframes randomGlowLight {
    0%, 100% {
      box-shadow: 0 20px 40px -15px rgba(8, 28, 54, 0.15), 0 0 20px 2px rgba(2, 132, 199, 0.08);
      border-color: rgba(2, 132, 199, 0.15);
    }
    25% {
      box-shadow: 0 25px 45px -12px rgba(8, 28, 54, 0.2), 0 0 35px 5px rgba(2, 132, 199, 0.2);
      border-color: rgba(2, 132, 199, 0.35);
    }
    50% {
      box-shadow: 0 20px 40px -15px rgba(8, 28, 54, 0.15), 0 0 25px 3px rgba(5, 150, 105, 0.12);
      border-color: rgba(5, 150, 105, 0.25);
    }
    75% {
      box-shadow: 0 28px 50px -10px rgba(8, 28, 54, 0.22), 0 0 40px 6px rgba(2, 132, 199, 0.25);
      border-color: rgba(2, 132, 199, 0.4);
    }
  }

  :global(html[data-theme="light"]) .animate-random-glow {
    animation: randomGlowLight 10s infinite ease-in-out;
  }

  /* Hover lift animation on text paragraphs (separated from entrance container transitions) */
  .hover-lift {
    transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1), color 0.3s ease;
  }

  .hover-lift:hover {
    transform: translateY(-4px) scale(1.008);
    color: var(--text-primary-hover);
  }

  /* Blue and Green Gradient Glowing Hyperlinks (Global Scoped for set:html compatibility) */
  :global(.glow-link) {
    position: relative;
    z-index: 10;
    cursor: pointer !important;
    pointer-events: auto !important;
    background: linear-gradient(135deg, #00D4FF, #4DFFB8) !important;
    -webkit-background-clip: text !important;
    -webkit-text-fill-color: transparent !important;
    font-weight: 700;
    display: inline-block;
    filter: drop-shadow(0 0 2px rgba(0, 212, 255, 0.5));
    transition: filter 0.3s cubic-bezier(0.25, 1, 0.5, 1), transform 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  }

  :global(.glow-link:hover) {
    filter: drop-shadow(0 0 8px rgba(0, 212, 255, 0.85)) drop-shadow(0 0 16px rgba(77, 255, 180, 0.6)) !important;
    transform: translateY(-1px) scale(1.03) !important;
  }

  /* Light mode overrides for glow link to keep high contrast */
  :global(html[data-theme="light"] .glow-link) {
    background: linear-gradient(135deg, var(--primary-brand), var(--secondary-accent)) !important;
    -webkit-background-clip: text !important;
    -webkit-text-fill-color: transparent !important;
    filter: drop-shadow(0 0 2px rgba(2, 132, 199, 0.15)) !important;
  }

  :global(html[data-theme="light"] .glow-link:hover) {
    filter: drop-shadow(0 0 6px rgba(2, 132, 199, 0.4)) drop-shadow(0 0 12px rgba(5, 150, 105, 0.3)) !important;
  }
</style>
