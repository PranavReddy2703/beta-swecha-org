---
// src/components/contact/ContactInfoCard.astro
interface Props {
  title: string;
  content: string;
  icon: "MapPin" | "Mail" | "Phone" | "GraduationCap";
  link?: string;
}

const { title, content, icon, link } = Astro.props;
---

<div
  class="glass-white-card group relative overflow-hidden rounded-xl border border-structural-borders bg-card-bg/60 p-6 backdrop-blur-md transition-all duration-300 hover:border-primary-brand/40 hover:-translate-y-1 hover:shadow-lg hover:shadow-primary-brand/5 flex flex-col justify-between h-full"
>
  <!-- Glowing background decor inside the card -->
  <div
    class="absolute -right-10 -top-10 h-24 w-24 rounded-full bg-primary-brand/5 blur-xl group-hover:bg-primary-brand/10 transition-all duration-300"
  >
  </div>

  <div>
    <!-- Icon and Title Header -->
    <div class="flex items-center space-x-3 mb-4">
      <div
        class="p-2.5 rounded-lg bg-secondary-bg/50 text-primary-brand border border-structural-borders/30 transition-colors duration-300 group-hover:border-primary-brand/30 group-hover:bg-primary-brand/5"
      >
        {
          icon === "MapPin" && (
            <svg
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
              <circle cx="12" cy="10" r="3" />
            </svg>
          )
        }
        {
          icon === "Mail" && (
            <svg
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
              <polyline points="22,6 12,13 2,6" />
            </svg>
          )
        }
        {
          icon === "Phone" && (
            <svg
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
          )
        }
        {
          icon === "GraduationCap" && (
            <svg
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
              <path d="M6 12v5c0 2 2 3 6 3s6-1 6-3v-5" />
            </svg>
          )
        }
      </div>
      <h3
        class="text-lg font-bold text-text-main group-hover:text-primary-brand transition-colors duration-300"
      >
        {title}
      </h3>
    </div>

    <!-- Content Block -->
    <div
      class="text-sm text-text-muted leading-relaxed whitespace-pre-line font-medium mb-4"
    >
      {
        link ? (
          <a
            href={link}
            class="hover:text-primary-brand hover:underline transition-colors duration-200 focus:outline-none focus:ring-1 focus:ring-primary-brand focus:ring-offset-2 focus:ring-offset-card-bg rounded-sm"
          >
            {content}
          </a>
        ) : (
          <span>{content}</span>
        )
      }
    </div>
  </div>

  {
    link && (
      <div class="mt-2">
        <a
          href={link}
          class="inline-flex items-center text-xs font-bold text-primary-brand group-hover:text-hover-brand transition-colors duration-200"
          aria-label={`Contact Swecha via ${title}: ${content}`}
        >
          <span>
            {icon === "Mail" || icon === "GraduationCap"
              ? "Send Email"
              : "Place Call"}
          </span>
          <svg
            class="ml-1 h-3 w-3 transform transition-transform duration-200 group-hover:translate-x-0.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M14 5l7 7m0 0l-7 7m7-7H3"
            />
          </svg>
        </a>
      </div>
    )
  }
</div>
