---
// src/components/news/NewsHero.astro
import { useTranslations } from "../../i18n/utils";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang as "en" | "te" | "hi");
---

<div class="pt-0">
  <!-- Centered Headings Layout -->
  <div
    class="flex flex-col items-center text-center gap-3 border-b border-structural-borders/40 pb-6"
  >
    <h1
      class="news-hero-title text-3xl md:text-4xl lg:text-5xl font-black text-text-main tracking-tight leading-none"
    >
      {t("news.title")}
    </h1>
    <p
      class="news-hero-subtitle text-sm md:text-base text-text-muted leading-relaxed font-medium max-w-2xl"
    >
      {t("news.subtitle")}
    </p>
  </div>
</div>

<style>
  .news-hero-title {
    background: linear-gradient(135deg, #00d4ff, #4dffb8) !important;
    background-clip: text !important;
    -webkit-background-clip: text !important;
    -webkit-text-fill-color: transparent !important;
    text-shadow: none !important;
    width: fit-content;
    display: inline-block;
  }

  /* Light mode styles for the news hero headings to ensure readability and depth */
  :global(html[data-theme="light"]) .news-hero-title {
    color: #ffffff !important;
    -webkit-text-fill-color: #ffffff !important;
    background: none !important;
    text-shadow: 0 2px 4px rgba(11, 30, 54, 0.3) !important;
  }
  :global(html[data-theme="light"]) .news-hero-subtitle {
    color: rgba(255, 255, 255, 0.95) !important;
    text-shadow: 0 1px 2px rgba(11, 30, 54, 0.2) !important;
  }
</style>
