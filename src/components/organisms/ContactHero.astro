---
// src/components/contact/ContactHero.astro
interface Props {
  title: string;
  subtitle: string;
}

const { title, subtitle } = Astro.props;
---

<section class="relative overflow-hidden pt-20 pb-12 md:pt-28 md:pb-16 flex flex-col items-center justify-center text-center">


  <div class="relative z-10 max-w-3xl px-4 sm:px-6 lg:px-8 mx-auto flex flex-col items-center select-none animate-fade-up">
    <!-- Centered Heading with Cyan Underline -->
    <h1 class="text-4xl font-extrabold tracking-tight text-text-main sm:text-5xl lg:text-6xl mb-4 relative">
      {title}
    </h1>
    
    <!-- Animated Cyan Underline -->
    <div class="h-1 bg-primary-brand rounded-full mb-6 shadow-[0_0_8px_rgba(0,212,255,0.5)] animate-expand-underline"></div>

    <!-- Subtitle description -->
    <p class="max-w-2xl text-base text-text-muted md:text-lg leading-relaxed whitespace-pre-line">
      {subtitle}
    </p>
  </div>
</section>

<style>
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes expandUnderline {
    from {
      width: 0;
    }
    to {
      width: 80px; /* matching w-20 (80px) from About page */
    }
  }

  .animate-fade-up {
    animation: fadeUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .animate-expand-underline {
    animation: expandUnderline 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.2s forwards;
    width: 0;
  }
</style>
