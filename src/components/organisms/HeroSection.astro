---
// src/components/organisms/HeroSection.astro
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<!-- Hero Section -->
<section
  class="hero-section relative overflow-hidden py-16 md:py-24 lg:py-32 flex flex-col items-center justify-center min-h-[calc(100vh-4.5rem)] bg-transparent transition-colors duration-300"
>
  <!-- Main Container -->
  <div
    class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 z-10 w-full flex flex-col items-center text-center"
  >
    <!-- Animated Big Swecha Logo -->
    <div
      class="hero-logo-container mb-8 md:mb-12 relative flex items-center justify-center w-full max-w-lg mx-auto animate-fade-in-up"
      style="animation-delay: 0.1s;"
    >
      <div
        class="logo-glow-effect absolute w-72 h-72 md:w-[450px] md:h-[450px] rounded-full bg-primary-brand/10 blur-[100px] opacity-60 dark:opacity-40 animate-pulse pointer-events-none"
      >
      </div>

      <div class="relative flex items-center justify-center">
        <!-- SVG Cursive Text Logo to prevent clipping -->
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 220 80"
          class="hero-logo-svg w-[340px] sm:w-[460px] md:w-[580px] h-auto select-none"
          fill="none"
          overflow="visible"
        >
          <defs>
            <linearGradient
              id="swecha-hero-logo-grad"
              x1="0%"
              y1="0%"
              x2="100%"
              y2="0%"
            >
              <stop offset="0%" stop-color="#00D4FF"></stop>
              <stop offset="50%" stop-color="#33E4FF"></stop>
              <stop offset="100%" stop-color="#4DFFB8"></stop>
            </linearGradient>
          </defs>
          <g class="hero-logo-content" overflow="visible">
            <text
              x="15"
              y="58"
              font-family="'Great Vibes', 'Alex Brush', 'Brush Script MT', cursive"
              font-size="52"
              style="letter-spacing: 0.5px;"
              class="hero-logo-text"
            >
              Swecha
            </text>
          </g>
        </svg>

        <!-- Birds Container to the right -->
        <div class="absolute right-[2%] top-[12%]">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 60 40"
            class="hero-birds-svg w-20 sm:w-24 md:w-32 h-auto overflow-visible select-none"
            fill="none"
          >
            <g class="hero-birds-group" overflow="visible">
              <!-- Large Bird -->
              <path
                class="hero-bird-1"
                d="M0 10 Q8 4 18 3 Q28 2 36 6 Q38 7 40 8 Q42 7 44 6 Q52 2 62 3 Q72 4 80 10 Q72 8 62 7 Q52 6 44 8.5 Q42 11 40 12 Q38 11 36 8.5 Q28 6 18 7 Q8 8 0 10 Z"
                fill="url(#swecha-hero-logo-grad)"></path>
              <!-- Small Bird -->
              <path
                class="hero-bird-2"
                d="M0 10 Q8 4 18 3 Q28 2 36 6 Q38 7 40 8 Q42 7 44 6 Q52 2 62 3 Q72 4 80 10 Q72 8 62 7 Q52 6 44 8.5 Q42 11 40 12 Q38 11 36 8.5 Q28 6 18 7 Q8 8 0 10 Z"
                fill="url(#swecha-hero-logo-grad)"></path>
            </g>
          </svg>
        </div>
      </div>
    </div>

    <!-- Headline with premium typography -->
    <h1
      class="hero-title text-3xl sm:text-4xl md:text-5xl lg:text-5xl font-black text-text-main tracking-tight mb-6 max-w-5xl animate-fade-in-up"
      style="animation-delay: 0.3s;"
    >
      {t("hero.title1")}
      <span
        class="brand-gradient-text inline-block ml-2 bg-gradient-to-r from-primary-brand via-hover-brand to-secondary-accent bg-clip-text text-transparent drop-shadow-[0_2px_8px_rgba(255,255,255,0.55)] dark:drop-shadow-[0_2px_15px_rgba(0,212,255,0.3)]"
      >
        {t("hero.title2")}
      </span>
    </h1>

    <!-- Subtitle description -->
    <p
      class="hero-desc text-base sm:text-lg text-text-muted mb-10 leading-relaxed max-w-3xl animate-fade-in-up"
      style="animation-delay: 0.4s;"
    >
      {t("hero.desc")}
    </p>

    <!-- Action buttons -->
    <div
      class="flex flex-wrap items-center justify-center gap-4 mb-16 animate-fade-in-up"
      style="animation-delay: 0.5s;"
    >
      <a
        href={translatePath("/projects")}
        class="hero-primary-btn px-6 py-3.5 rounded-xl bg-primary-brand text-[var(--primary-btn-text)] font-black text-sm tracking-wide shadow-md shadow-primary-brand/10 hover:bg-hover-brand hover:scale-105 active:scale-95 transition-all duration-300"
      >
        {t("hero.btn.explore")}
      </a>
      <a
        href={translatePath("/about")}
        class="hero-secondary-btn px-6 py-3.5 rounded-xl border border-structural-borders bg-card-bg/30 text-text-main font-bold text-sm tracking-wide backdrop-blur hover:border-primary-brand/35 hover:scale-105 active:scale-95 transition-all duration-300"
      >
        {t("hero.btn.learn")}
      </a>
    </div>

    <!-- Impact Statistics Grid -->
    <div
      class="grid grid-cols-2 sm:grid-cols-4 gap-8 md:gap-12 w-full max-w-4xl pt-10 border-t border-structural-borders/30 justify-center items-center mb-24 animate-fade-in-up"
      style="animation-delay: 0.6s;"
    >
      <div class="stats-item flex flex-col items-center">
        <span
          class="stats-val text-3xl sm:text-4xl md:text-5xl font-black bg-gradient-to-r from-primary-brand to-secondary-accent bg-clip-text text-transparent"
        >
          {t("hero.stats.students.val")}
        </span>
        <span
          class="stats-lbl text-[10px] font-extrabold text-text-muted mt-2 uppercase tracking-wider"
        >
          {t("hero.stats.students.lbl")}
        </span>
      </div>
      <div class="stats-item flex flex-col items-center">
        <span
          class="stats-val text-3xl sm:text-4xl md:text-5xl font-black bg-gradient-to-r from-primary-brand to-secondary-accent bg-clip-text text-transparent"
        >
          {t("hero.stats.workshops.val")}
        </span>
        <span
          class="stats-lbl text-[10px] font-extrabold text-text-muted mt-2 uppercase tracking-wider"
        >
          {t("hero.stats.workshops.lbl")}
        </span>
      </div>
      <div class="stats-item flex flex-col items-center">
        <span
          class="stats-val text-3xl sm:text-4xl md:text-5xl font-black bg-gradient-to-r from-primary-brand to-secondary-accent bg-clip-text text-transparent"
        >
          {t("hero.stats.projects.val")}
        </span>
        <span
          class="stats-lbl text-[10px] font-extrabold text-text-muted mt-2 uppercase tracking-wider"
        >
          {t("hero.stats.projects.lbl")}
        </span>
      </div>
      <div class="stats-item flex flex-col items-center">
        <span
          class="stats-val text-3xl sm:text-4xl md:text-5xl font-black bg-gradient-to-r from-primary-brand to-secondary-accent bg-clip-text text-transparent"
        >
          {t("hero.stats.years.val")}
        </span>
        <span
          class="stats-lbl text-[10px] font-extrabold text-text-muted mt-2 uppercase tracking-wider"
        >
          {t("hero.stats.years.lbl")}
        </span>
      </div>
    </div>

    <!-- Initiatives/Pillars horizontal grid at the bottom -->
    <div class="w-full mt-8 animate-fade-in-up" style="animation-delay: 0.7s;">
      <!-- Section Title & Decoration -->
      <div class="text-center mb-10">
        <h2
          class="text-xs font-black uppercase tracking-widest text-primary-brand/80"
        >
          {t("nav.initiatives")}
        </h2>
        <div
          class="h-[2px] w-12 bg-gradient-to-r from-primary-brand to-secondary-accent mx-auto mt-3 rounded-full"
        >
        </div>
      </div>

      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 w-full text-left"
      >
        <!-- Pillar Card: VISHWAM.ai -->
        <a
          href={translatePath("/initiatives/vishwam-ai")}
          class="pillar-card glass-card glass-white-card group relative flex flex-col justify-between p-5 rounded-2xl border border-structural-borders bg-card-bg/25 backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 hover:border-primary-brand/35 hover:shadow-xl hover:shadow-primary-brand/5"
        >
          <div class="flex flex-col gap-3">
            <div
              class="w-10 h-10 rounded-xl bg-violet-600/10 text-violet-400 flex items-center justify-center group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"
                ></path>
              </svg>
            </div>
            <div class="space-y-1">
              <h2
                class="text-base font-bold text-text-main group-hover:text-primary-brand transition-colors"
              >
                {t("hero.pillar.vishwam.title")}
              </h2>
              <p class="text-xs text-text-muted leading-relaxed">
                {t("hero.pillar.vishwam.desc")}
              </p>
            </div>
          </div>
          <div
            class="flex items-center gap-1 text-[10px] font-bold text-primary-brand uppercase tracking-wider pt-6 mt-auto"
          >
            Explore
            <svg
              class="w-3 h-3 transition-transform duration-300 group-hover:translate-x-1"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 5l7 7-7 7"></path>
            </svg>
          </div>
        </a>

        <!-- Pillar Card: Swecha OS -->
        <a
          href={translatePath("/about/swecha-os")}
          class="pillar-card glass-card glass-white-card group relative flex flex-col justify-between p-5 rounded-2xl border border-structural-borders bg-card-bg/25 backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 hover:border-primary-brand/35 hover:shadow-xl hover:shadow-primary-brand/5"
        >
          <div class="flex flex-col gap-3">
            <div
              class="w-10 h-10 rounded-xl bg-primary-brand/10 text-primary-brand flex items-center justify-center group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path>
              </svg>
            </div>
            <div class="space-y-1">
              <h2
                class="text-base font-bold text-text-main group-hover:text-primary-brand transition-colors"
              >
                {t("hero.pillar.os.title")}
              </h2>
              <p class="text-xs text-text-muted leading-relaxed">
                {t("hero.pillar.os.desc")}
              </p>
            </div>
          </div>
          <div
            class="flex items-center gap-1 text-[10px] font-bold text-primary-brand uppercase tracking-wider pt-6 mt-auto"
          >
            Explore
            <svg
              class="w-3 h-3 transition-transform duration-300 group-hover:translate-x-1"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 5l7 7-7 7"></path>
            </svg>
          </div>
        </a>

        <!-- Pillar Card: Code4Change -->
        <a
          href={translatePath("/initiatives/code4change")}
          class="pillar-card glass-card glass-white-card group relative flex flex-col justify-between p-5 rounded-2xl border border-structural-borders bg-card-bg/25 backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 hover:border-primary-brand/35 hover:shadow-xl hover:shadow-primary-brand/5"
        >
          <div class="flex flex-col gap-3">
            <div
              class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-500 flex items-center justify-center group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
              </svg>
            </div>
            <div class="space-y-1">
              <h2
                class="text-base font-bold text-text-main group-hover:text-primary-brand transition-colors"
              >
                {t("hero.pillar.code4change.title")}
              </h2>
              <p class="text-xs text-text-muted leading-relaxed">
                {t("hero.pillar.code4change.desc")}
              </p>
            </div>
          </div>
          <div
            class="flex items-center gap-1 text-[10px] font-bold text-primary-brand uppercase tracking-wider pt-6 mt-auto"
          >
            Explore
            <svg
              class="w-3 h-3 transition-transform duration-300 group-hover:translate-x-1"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 5l7 7-7 7"></path>
            </svg>
          </div>
        </a>

        <!-- Pillar Card: People's Health -->
        <a
          href={translatePath("/initiatives/peoples-health")}
          class="pillar-card glass-card glass-white-card group relative flex flex-col justify-between p-5 rounded-2xl border border-structural-borders bg-card-bg/25 backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 hover:border-primary-brand/35 hover:shadow-xl hover:shadow-primary-brand/5"
        >
          <div class="flex flex-col gap-3">
            <div
              class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-500 flex items-center justify-center group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
                ></path>
              </svg>
            </div>
            <div class="space-y-1">
              <h2
                class="text-base font-bold text-text-main group-hover:text-primary-brand transition-colors"
              >
                {t("hero.pillar.health.title")}
              </h2>
              <p class="text-xs text-text-muted leading-relaxed">
                {t("hero.pillar.health.desc")}
              </p>
            </div>
          </div>
          <div
            class="flex items-center gap-1 text-[10px] font-bold text-primary-brand uppercase tracking-wider pt-6 mt-auto"
          >
            Explore
            <svg
              class="w-3 h-3 transition-transform duration-300 group-hover:translate-x-1"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 5l7 7-7 7"></path>
            </svg>
          </div>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Section-specific ambient glows in dark mode */
  .hero-section {
    background-image:
      radial-gradient(
        circle at 25% 10%,
        rgba(0, 212, 255, 0.08) 0%,
        transparent 60%
      ),
      radial-gradient(
        circle at 75% 90%,
        rgba(77, 255, 184, 0.08) 0%,
        transparent 60%
      );
  }

  /* Section-specific ambient glows in light mode */
  :global(html[data-theme="light"]) .hero-section {
    background-image:
      radial-gradient(
        circle at 25% 10%,
        rgba(2, 90, 158, 0.03) 0%,
        transparent 60%
      ),
      radial-gradient(
        circle at 75% 90%,
        rgba(59, 130, 246, 0.03) 0%,
        transparent 60%
      );
  }

  /* Logo Animations & Layout */
  .hero-logo-text {
    font-family: "Great Vibes", "Alex Brush", "Brush Script MT", cursive;
    fill: url(#swecha-hero-logo-grad);
    filter: drop-shadow(0 2px 10px rgba(0, 212, 255, 0.2))
      drop-shadow(0 4px 20px rgba(77, 255, 184, 0.1));
    transition: filter 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .hero-logo-container:hover .hero-logo-text {
    filter: drop-shadow(0 4px 20px rgba(0, 212, 255, 0.45))
      drop-shadow(0 8px 40px rgba(77, 255, 184, 0.3));
  }

  .hero-birds-svg {
    overflow: visible;
  }

  .hero-bird-1 {
    transform: translate(0px, 5px) scale(0.4) rotate(-10deg);
    animation: hero-flap-large 2.6s ease-in-out infinite;
    transform-origin: center;
  }
  .hero-bird-2 {
    transform: translate(25px, 18px) scale(0.28) rotate(-5deg);
    animation: hero-flap-small 2.2s ease-in-out infinite;
    transform-origin: center;
  }

  @keyframes hero-flap-large {
    0%,
    100% {
      transform: translate(0px, 5px) scale(0.4) rotate(-10deg) scaleY(1);
    }
    50% {
      transform: translate(-2px, 1px) scale(0.4) rotate(-18deg) scaleY(0.35);
    }
  }

  @keyframes hero-flap-small {
    0%,
    100% {
      transform: translate(25px, 18px) scale(0.28) rotate(-5deg) scaleY(1);
    }
    50% {
      transform: translate(27px, 13px) scale(0.28) rotate(-12deg) scaleY(0.4);
    }
  }

  .hero-title {
    line-height: 1.1;
  }

  /* Default dark mode header drop shadow glow */
  .brand-gradient-text {
    filter: drop-shadow(0 2px 10px rgba(0, 212, 255, 0.15));
  }

  /* Stats grid val */
  .stats-val {
    filter: drop-shadow(0 2px 8px rgba(0, 212, 255, 0.2));
  }

  /* Entrance animations */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.8s cubic-bezier(0.25, 1, 0.5, 1) forwards;
    opacity: 0;
  }

  /* Light mode overrides */
  :global(html[data-theme="light"]) .hero-logo-text {
    fill: #ffffff !important;
    filter: drop-shadow(0 2px 8px rgba(11, 30, 54, 0.35))
      drop-shadow(0 4px 20px rgba(11, 30, 54, 0.2)) !important;
  }

  :global(html[data-theme="light"]) .hero-logo-container:hover .hero-logo-text {
    filter: drop-shadow(0 4px 16px rgba(11, 30, 54, 0.5))
      drop-shadow(0 8px 30px rgba(11, 30, 54, 0.3)) !important;
  }

  :global(html[data-theme="light"]) .hero-bird-1,
  :global(html[data-theme="light"]) .hero-bird-2 {
    fill: #ffffff !important;
    filter: drop-shadow(0 2px 4px rgba(11, 30, 54, 0.35)) !important;
  }

  :global(html[data-theme="light"]) .hero-title {
    color: #ffffff !important;
    text-shadow:
      0 2px 8px rgba(11, 30, 54, 0.35),
      0 4px 20px rgba(11, 30, 54, 0.25) !important;
  }

  :global(html[data-theme="light"]) .brand-gradient-text {
    background: none !important;
    -webkit-text-fill-color: #ffffff !important;
    color: #ffffff !important;
    text-shadow:
      0 2px 8px rgba(11, 30, 54, 0.35),
      0 4px 20px rgba(11, 30, 54, 0.25) !important;
    filter: none !important;
  }

  :global(html[data-theme="light"]) .hero-desc {
    color: rgba(255, 255, 255, 0.95) !important;
    text-shadow:
      0 2px 6px rgba(11, 30, 54, 0.3),
      0 4px 15px rgba(11, 30, 54, 0.2) !important;
  }

  :global(html[data-theme="light"]) .stats-val {
    background: none !important;
    -webkit-text-fill-color: #ffffff !important;
    color: #ffffff !important;
    text-shadow:
      0 2px 8px rgba(11, 30, 54, 0.35),
      0 4px 20px rgba(11, 30, 54, 0.25) !important;
  }

  :global(html[data-theme="light"]) .stats-lbl {
    color: rgba(255, 255, 255, 0.85) !important;
    text-shadow: 0 1px 2px rgba(11, 30, 54, 0.15) !important;
  }

  :global(html[data-theme="light"]) .hero-secondary-btn {
    background-color: rgba(255, 255, 255, 0.85) !important;
    border-color: rgba(255, 255, 255, 0.9) !important;
    color: #0b1e36 !important;
    box-shadow:
      0 12px 24px -10px rgba(8, 28, 54, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.5) !important;
  }

  :global(html[data-theme="light"]) .hero-secondary-btn:hover {
    background-color: #ffffff !important;
    border-color: var(--primary-brand) !important;
    color: var(--primary-brand) !important;
  }
</style>
