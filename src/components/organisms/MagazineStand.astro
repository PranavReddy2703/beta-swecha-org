---
// src/components/organisms/MagazineStand.astro
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../../i18n/utils";
import magazineData from "../../data/organisms/magazines.json";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const magazines = magazineData.magazines;

// Section title translation
const sectionTitle =
  lang === "te"
    ? "మ్యాగజైన్ స్టాండ్"
    : lang === "hi"
      ? "पत्रिका स्टैंड"
      : "Magazine Stand";
---

<div class="space-y-4 select-none mt-12">
  <div class="flex items-center space-x-3">
    <h2
      class="news-section-header text-sm font-black text-text-main uppercase tracking-widest"
    >
      {sectionTitle}
    </h2>
    <span
      class="h-[1px] flex-grow bg-gradient-to-r from-structural-borders via-structural-borders/30 to-transparent"
    ></span>
  </div>

  <div
    id="magazine-trigger"
    class="magazine-stand-container relative h-[520px] w-full max-w-[320px] mx-auto cursor-pointer group"
  >
    <!-- Background glow on hover -->
    <div
      class="absolute inset-0 bg-primary-brand/10 blur-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 rounded-full"
    >
    </div>

    {
      magazines.map((mag, idx) => {
        const title = mag.title[lang] || mag.title["en"];
        const depth = magazines.length - 1 - idx;

        // Front card (depth 0) = 255 (white)
        // Back card (depth 3) = 240 (#f0f0f0)
        const shade = 255 - depth * 5;

        return (
          <div
            class="magazine-card absolute top-0 left-0 right-0 shadow-md transition-all duration-500 ease-[cubic-bezier(0.23,1,0.32,1)] rounded-2xl overflow-hidden border border-primary-brand/20 bg-secondary-bg p-4"
            style={`z-index: ${idx + 10}; transform: translateY(${idx * 45}px);`}
            data-idx={idx}
          >
            {/* Light mode explicit background shade */}
            <div
              class="absolute inset-0 pointer-events-none rounded-2xl dark:hidden z-0"
              style={`background-color: rgb(${shade}, ${shade}, ${shade});`}
            />

            <div class="flex items-center gap-2 mb-4 relative z-10">
              <span class="w-2 h-2 rounded-full bg-primary-brand animate-pulse" />
              <h3 class="text-[10px] font-black text-text-main uppercase tracking-widest truncate">
                {title}
              </h3>
            </div>
            <div class="h-[320px] w-full rounded-xl overflow-hidden border border-structural-borders/30 relative z-10">
              <img
                src={mag.cover}
                alt={title}
                class="w-full h-full object-cover"
              />
            </div>
          </div>
        );
      })
    }

    <!-- Click to spread overlay hint -->
    <div
      class="absolute bottom-4 left-1/2 -translate-x-1/2 z-[100] bg-black/60 backdrop-blur-sm px-4 py-1.5 rounded-full border border-white/10 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none flex items-center gap-2"
    >
      <svg
        class="w-4 h-4 text-primary-brand animate-pulse"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"
        ></path>
      </svg>
      <span class="text-[10px] font-bold text-white uppercase tracking-wider"
        >Click to Spread</span
      >
    </div>
  </div>
</div>

<!-- Full Screen Spread Modal -->
<dialog id="magazine-modal" class="modal bg-transparent">
  <div
    class="fixed inset-0 bg-primary-bg/95 backdrop-blur-xl z-50 flex flex-col p-8 md:p-12 transition-all duration-700 ease-out opacity-0 pointer-events-none"
    id="magazine-modal-overlay"
  >
    <div class="flex justify-between items-center mb-8">
      <h2 class="text-2xl md:text-3xl font-black text-text-main tracking-tight">
        {sectionTitle}
      </h2>
      <button
        id="close-magazines"
        class="btn btn-circle btn-ghost bg-secondary-bg hover:bg-structural-borders/50 text-text-main border border-structural-borders"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path></svg
        >
      </button>
    </div>

    <div
      class="flex-grow overflow-y-auto overflow-x-hidden custom-scrollbar px-6 -mx-6 pt-6 -mt-6 pb-4"
    >
      <div
        class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8 pb-12"
      >
        {
          magazines.map((mag, idx) => {
            const title = mag.title[lang] || mag.title["en"];
            return (
              <div
                class="magazine-spread-card opacity-0 translate-y-12 transition-all duration-700 ease-out rounded-xl overflow-hidden shadow-2xl border border-structural-borders group/mag hover:scale-105 hover:-translate-y-2 hover:border-primary-brand/50 hover:shadow-primary-brand/30 isolate"
                style={`transition-delay: ${idx * 100}ms;`}
              >
                <a
                  href={mag.url}
                  target="_blank"
                  class="block h-[400px] w-full relative rounded-xl overflow-hidden"
                >
                  <img
                    src={mag.cover}
                    alt={title}
                    class="w-full h-full object-cover rounded-xl"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent" />
                  <div class="absolute bottom-0 left-0 right-0 p-5">
                    <span class="inline-block px-2 py-1 bg-primary-brand/20 backdrop-blur-md border border-primary-brand/40 text-primary-brand text-[10px] font-black tracking-widest rounded mb-3">
                      {mag.date}
                    </span>
                    <h3 class="text-white font-bold text-lg leading-tight group-hover/mag:text-primary-brand transition-colors">
                      {title}
                    </h3>
                  </div>
                </a>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</dialog>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const trigger = document.getElementById("magazine-trigger");
    const modal = document.getElementById(
      "magazine-modal",
    ) as HTMLDialogElement;
    const overlay = document.getElementById("magazine-modal-overlay");
    const closeBtn = document.getElementById("close-magazines");
    const spreadCards = document.querySelectorAll(".magazine-spread-card");
    const standCards = document.querySelectorAll(
      ".magazine-card",
    ) as NodeListOf<HTMLElement>;

    // Hover Fan-out effect on the stand
    if (trigger) {
      trigger.addEventListener("mouseenter", () => {
        standCards.forEach((card, idx) => {
          // Increase translation on hover
          card.style.transform = `translateY(${idx * 50}px)`;
        });
      });

      trigger.addEventListener("mouseleave", () => {
        standCards.forEach((card, idx) => {
          // Restore translation
          card.style.transform = `translateY(${idx * 45}px)`;
        });
      });

      // Click to open full spread
      trigger.addEventListener("click", () => {
        modal.showModal();
        // Trigger animations
        requestAnimationFrame(() => {
          overlay?.classList.remove("opacity-0", "pointer-events-none");
          document.body.style.overflow = "hidden";

          spreadCards.forEach((card) => {
            card.classList.remove("opacity-0", "translate-y-12");
          });
        });
      });
    }

    const closeSpread = () => {
      overlay?.classList.add("opacity-0", "pointer-events-none");
      document.body.style.overflow = "";

      spreadCards.forEach((card) => {
        card.classList.add("opacity-0", "translate-y-12");
      });

      setTimeout(() => {
        modal.close();
      }, 700); // match transition duration
    };

    closeBtn?.addEventListener("click", closeSpread);

    // Close on backdrop click or ESC
    modal?.addEventListener("click", (e) => {
      if (e.target === overlay) {
        closeSpread();
      }
    });

    document.addEventListener("keydown", (e) => {
      if (
        e.key === "Escape" &&
        overlay &&
        !overlay.classList.contains("opacity-0")
      ) {
        closeSpread();
      }
    });
  });
</script>

<style>
  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: var(--structural-borders);
    border-radius: 10px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: var(--primary-brand);
  }
</style>
