---
// src/components/events/EventHero.astro
import Badge from '../atoms/Badge.astro';
import Button from '../atoms/Button.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<header class="relative w-full overflow-hidden bg-canvas-base border-b border-structural-borders/30">
  <!-- Neon Tech Ambient Glows -->
  <div class="absolute inset-0 pointer-events-none z-10 overflow-hidden">
    <div class="absolute -top-30 left-1/3 w-[500px] h-[350px] bg-primary-brand/15 blur-[130px] rounded-full"></div>
    <div class="absolute bottom-0 right-1/4 w-[400px] h-[300px] bg-secondary-accent/10 blur-[110px] rounded-full"></div>
  </div>

  <!-- Hero Content and Banner Wrapper -->
  <div class="relative w-full h-[65vh] min-h-[500px] md:h-[75vh] flex items-center justify-center">

    <!-- Background Image with Overlay -->
    <div class="absolute inset-0 z-0">
      <img
        src="/images/event-banner.png"
        alt="Trust and Safety in AI Conference Banner"
        class="w-full h-full object-cover object-center scale-105 filter brightness-75 contrast-105 transition-all duration-1000 ease-out hover:scale-100"
      />
      <!-- Tech Matrix Grid Overlay -->
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#273449_1px,transparent_1px),linear-gradient(to_bottom,#273449_1px,transparent_1px)] bg-[size:4rem_4rem] opacity-[0.08] mix-blend-overlay"></div>

      <!-- Multi-stage Dark Overlays -->
      <div class="absolute inset-0 bg-gradient-to-b from-canvas-base/30 via-canvas-base/75 to-canvas-base z-10"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-canvas-base via-transparent to-canvas-base opacity-90 z-10"></div>
    </div>

    <!-- Immersive Content Area -->
    <div class="relative z-20 max-w-5xl mx-auto px-4 text-center sm:px-6 lg:px-8 space-y-6 md:space-y-8 animate-fade-in">

      <!-- Event Category Badge -->
      <div class="inline-flex justify-center transition-all duration-300 hover:scale-105">
        <Badge label={t('event.badge')} variant="hero" />
      </div>

      <!-- Main Event Title -->
      <div class="space-y-3 md:space-y-4">
        <h1 class="text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight text-text-main leading-tight select-none">
          {t('event.title')}
        </h1>
        <p class="brand-gradient-text text-xl sm:text-2xl md:text-3xl font-semibold tracking-wide bg-gradient-to-r from-primary-brand via-hover-brand to-secondary-accent bg-clip-text text-transparent drop-shadow-[0_0_15px_rgba(0,212,255,0.4)]">
          {t('event.subtitle')}
        </p>
      </div>

      <!-- Event Description -->
      <p class="max-w-2xl mx-auto text-base sm:text-lg text-text-muted leading-relaxed font-medium md:text-xl">
        {t('event.description')}
      </p>

      <!-- Primary CTA Actions -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
        <Button
          href="#register-section"
          label={t('event.btn.register')}
          variant="primary"
          class="w-full sm:w-auto px-8 py-4 shadow-[0_0_30px_rgba(0,212,255,0.25)] hover:shadow-[0_0_40px_rgba(0,212,255,0.4)]"
        />
        <Button
          href="#about-section"
          label={t('event.btn.readMore')}
          variant="secondary"
          class="w-full sm:w-auto px-8 py-4 hover:border-secondary-accent/40"
        />
      </div>

    </div>
  </div>
</header>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>
