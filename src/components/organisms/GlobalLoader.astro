---
// src/components/organisms/GlobalLoader.astro
---

<div
  id="global-loader"
  class="fixed inset-0 z-[9999] bg-[#050B14] flex flex-col items-center justify-center overflow-hidden transition-opacity duration-700"
>
  {/* The Isometric Grid Backdrop */}
  <div
    class="absolute inset-0 flex items-center justify-center opacity-30 pointer-events-none perspective-[1000px]"
  >
    <div
      class="grid-plane w-[200vw] h-[200vh] border-primary-brand/20 border-t border-l"
    >
    </div>
  </div>

  {/* The Target Landing Pad */}
  <div
    id="loader-pad"
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 mt-32 w-64 h-64 opacity-0 transition-all duration-1000 transform rotate-x-[60deg] -rotate-z-[45deg] scale-50"
  >
    <div
      class="ripple ripple-1 absolute inset-0 rounded-full border-2 border-primary-brand shadow-[0_0_15px_rgba(0,212,255,0.6)]"
    >
    </div>
    <div
      class="ripple ripple-2 absolute inset-4 rounded-full border border-secondary-accent/70 shadow-[0_0_10px_rgba(77,255,184,0.4)]"
    >
    </div>
    <div
      class="ripple ripple-3 absolute inset-8 rounded-full border-2 border-primary-brand/50"
    >
    </div>
    <div
      class="absolute inset-0 rounded-full bg-primary-brand/5 backdrop-blur-sm animate-pulse"
    >
    </div>
  </div>

  {/* The Cyber Bird */}
  <div
    id="loader-bird"
    class="relative z-10 w-48 h-48 flex items-center justify-center loader-bird-active"
  >
    <svg
      viewBox="0 0 100 100"
      class="w-full h-full overflow-visible drop-shadow-[0_0_8px_rgba(0,212,255,0.8)]"
    >
      <defs>
        <linearGradient id="bird-primary" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#00D4FF"></stop>
          <stop offset="100%" stop-color="#4DFFB8"></stop>
        </linearGradient>
        <linearGradient id="bird-secondary" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#4DFFB8"></stop>
          <stop offset="100%" stop-color="#00D4FF"></stop>
        </linearGradient>
        <filter id="glow-bird" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur stdDeviation="2" result="coloredBlur"
          ></feGaussianBlur>
          <feMerge>
            <feMergeNode in="coloredBlur"></feMergeNode>
            <feMergeNode in="SourceGraphic"></feMergeNode>
          </feMerge>
        </filter>
      </defs>

      <g id="bird-group" transform="translate(0, 0)">
        <!-- Left Wing -->
        <g id="wing-left" transform-origin="45 40">
          <polygon
            points="45,40 10,25 25,50 45,45"
            fill="url(#bird-secondary)"
            filter="url(#glow-bird)"
            opacity="0.9"></polygon>
          <polygon
            points="45,40 5,40 20,60 45,50"
            fill="url(#bird-primary)"
            filter="url(#glow-bird)"
            opacity="0.7"></polygon>
        </g>

        <!-- Right Wing -->
        <g id="wing-right" transform-origin="55 40">
          <polygon
            points="55,40 90,25 75,50 55,45"
            fill="url(#bird-secondary)"
            filter="url(#glow-bird)"
            opacity="0.9"></polygon>
          <polygon
            points="55,40 95,40 80,60 55,50"
            fill="url(#bird-primary)"
            filter="url(#glow-bird)"
            opacity="0.7"></polygon>
        </g>

        <!-- Body -->
        <polygon
          points="50,20 40,40 50,70 60,40"
          fill="url(#bird-primary)"
          filter="url(#glow-bird)"></polygon>
        <!-- Tail -->
        <polygon
          points="45,65 35,90 50,85 65,90 55,65"
          fill="url(#bird-secondary)"
          filter="url(#glow-bird)"
          opacity="0.8"></polygon>
        <!-- Head -->
        <polygon
          points="50,10 45,22 55,22"
          fill="url(#bird-primary)"
          filter="url(#glow-bird)"></polygon>
      </g>
    </svg>
  </div>

  <div
    id="loader-text"
    class="absolute bottom-16 text-xs font-bold tracking-[0.3em] uppercase text-primary-brand animate-pulse opacity-80"
  >
    Initializing Data Sequence
  </div>
</div>

<style>
  /* Isometric Grid Pattern */
  .grid-plane {
    background-image:
      linear-gradient(to right, rgba(0, 212, 255, 0.1) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(0, 212, 255, 0.1) 1px, transparent 1px);
    background-size: 40px 40px;
    transform: rotateX(60deg) rotateZ(-45deg);
    animation: grid-slide 10s linear infinite;
  }

  @keyframes grid-slide {
    0% {
      transform: rotateX(60deg) rotateZ(-45deg) translateY(0);
    }
    100% {
      transform: rotateX(60deg) rotateZ(-45deg) translateY(40px);
    }
  }

  /* Target Pad Ripples */
  .ripple {
    animation: ripple-effect 3s cubic-bezier(0.16, 1, 0.3, 1) infinite;
    opacity: 0;
  }
  .ripple-2 {
    animation-delay: 0.5s;
  }
  .ripple-3 {
    animation-delay: 1s;
  }

  @keyframes ripple-effect {
    0% {
      transform: scale(0.5);
      opacity: 1;
      border-width: 3px;
    }
    100% {
      transform: scale(1.5);
      opacity: 0;
      border-width: 1px;
    }
  }

  /* Bird Animations */
  .loader-bird-active {
    animation: hover 2s ease-in-out infinite;
    transform: translateY(-50px) scale(1.2);
  }
  .loader-bird-active #wing-left {
    animation: flap-left 0.4s ease-in-out infinite;
  }
  .loader-bird-active #wing-right {
    animation: flap-right 0.4s ease-in-out infinite;
  }

  /* The Landed State (Applied via JS) */
  .loader-bird-landed {
    transform: translateY(25px) scale(0.85);
    transition: transform 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .loader-bird-landed #wing-left {
    transform: rotateY(55deg) rotateZ(-25deg) translateY(10px);
    transition: transform 0.6s ease-out;
  }
  .loader-bird-landed #wing-right {
    transform: rotateY(-55deg) rotateZ(25deg) translateY(10px);
    transition: transform 0.6s ease-out;
  }

  /* Target Pad Active State */
  .pad-active {
    opacity: 1 !important;
    transform: rotateX(60deg) rotateZ(-45deg) scale(1) !important;
  }

  @keyframes flap-left {
    0%,
    100% {
      transform: rotateY(0deg) rotateZ(0deg) translateY(0);
    }
    50% {
      transform: rotateY(45deg) rotateZ(-20deg) translateY(-8px);
    }
  }
  @keyframes flap-right {
    0%,
    100% {
      transform: rotateY(0deg) rotateZ(0deg) translateY(0);
    }
    50% {
      transform: rotateY(-45deg) rotateZ(20deg) translateY(-8px);
    }
  }
  @keyframes hover {
    0%,
    100% {
      transform: translateY(-50px) scale(1.2);
    }
    50% {
      transform: translateY(-65px) scale(1.2);
    }
  }
</style>

<script is:inline>
  function runLandingSequence() {
    const loader = document.getElementById("global-loader");
    const bird = document.getElementById("loader-bird");
    const pad = document.getElementById("loader-pad");
    const text = document.getElementById("loader-text");

    if (!loader || !bird || !pad || !text) return;

    // State 1 & 2: Show Pad and start landing approach
    setTimeout(() => {
      pad.classList.add("pad-active");
      text.innerText = "Data Sequence Acquired";
    }, 100);

    // State 3: Landed!
    setTimeout(() => {
      bird.classList.remove("loader-bird-active");
      bird.classList.add("loader-bird-landed");
      text.innerText = "Access Granted";
      text.classList.remove("animate-pulse");

      // Flash effect on land
      const flash = document.createElement("div");
      flash.className =
        "absolute inset-0 bg-primary-brand/20 z-20 pointer-events-none mix-blend-screen transition-opacity duration-500";
      loader.appendChild(flash);
      setTimeout(() => (flash.style.opacity = "0"), 50);
    }, 800); // Bird lands shortly after

    // Hide loader fully
    setTimeout(() => {
      loader.style.opacity = "0";
      loader.style.pointerEvents = "none";
      setTimeout(() => {
        loader.style.display = "none";
      }, 700);
    }, 1500);
  }

  // Handle Initial Load
  if (document.readyState === "complete") {
    runLandingSequence();
  } else {
    window.addEventListener("load", runLandingSequence);
  }

  // Handle Astro View Transitions (subsequent page loads)
  document.addEventListener("astro:before-preparation", () => {
    const loader = document.getElementById("global-loader");
    const bird = document.getElementById("loader-bird");
    const pad = document.getElementById("loader-pad");
    const text = document.getElementById("loader-text");

    if (loader && bird && pad && text) {
      loader.style.display = "flex";
      loader.style.opacity = "1";
      loader.style.pointerEvents = "all";
      bird.classList.remove("loader-bird-landed");
      bird.classList.add("loader-bird-active");
      pad.classList.remove("pad-active");
      text.innerText = "Initializing Data Sequence";
      text.classList.add("animate-pulse");
    }
  });

  document.addEventListener("astro:page-load", () => {
    // Only run if not the very first load (which is handled by window.load)
    if (window.hasRunFirstLoader) {
      runLandingSequence();
    }
    window.hasRunFirstLoader = true;
  });
</script>
