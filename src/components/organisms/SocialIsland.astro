---
// src/components/organisms/SocialIsland.astro
import SocialIcon from "../atoms/SocialIcon.astro";
import socialIconsData from "../../data/atoms/socialIcons.json";
import type { SocialIconData } from "../types/index";
import BaseIsland from "../molecules/BaseIsland.astro";

const typedIcons = socialIconsData as SocialIconData[];
---

<BaseIsland
  id="social-island"
  position="bottom"
  offset="80px"
  toggleText="Socials"
>
  <div class="p-[10px_8px] flex flex-col items-center gap-2">
    <!-- Close Button inside panel -->
    <button class="base-island-close-btn" aria-label="Close Socials Panel">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="base-island-close-icon"
        aria-hidden="true"
      >
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>

    <!-- Subtle separator -->
    <div class="social-divider"></div>

    {
      typedIcons.map((icon) => (
        <div class="social-item-wrapper group relative">
          <SocialIcon
            href={icon.href}
            label={icon.label}
            platform={icon.platform}
          />
          {/* Custom Premium Tooltip */}
          <span class="social-tooltip">{icon.label}</span>
        </div>
      ))
    }
  </div>
</BaseIsland>

<style>
  /* Divider */
  .social-divider {
    width: 16px;
    height: 1px;
    background: var(--structural-borders);
    opacity: 0.5;
    margin: 1px 0;
  }

  /* Icon styling wrappers with glass effects */
  .social-item-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(html[data-theme="light"]) .social-item-wrapper {
    background: rgba(0, 0, 0, 0.02);
    border-color: rgba(0, 0, 0, 0.06);
  }

  .social-item-wrapper:hover {
    background: rgba(0, 212, 255, 0.12);
    border-color: var(--primary-brand);
    transform: scale(1.12) translateY(-2px);
    box-shadow: 0 4px 14px rgba(0, 212, 255, 0.3);
  }

  :global(html[data-theme="light"]) .social-item-wrapper:hover {
    background: rgba(2, 90, 158, 0.08);
    border-color: var(--primary-brand);
    box-shadow: 0 4px 14px rgba(2, 132, 199, 0.18);
  }

  /* Deep style override inside island for the atom footer icon */
  .social-item-wrapper :global(.footer-icon) {
    color: var(--text-muted);
    opacity: 0.75;
    transition:
      color 0.3s ease,
      opacity 0.3s ease;
  }

  .social-item-wrapper :global(.footer-icon svg) {
    width: 0.875rem;
    height: 0.875rem;
  }

  .social-item-wrapper:hover :global(.footer-icon) {
    color: var(--primary-brand);
    opacity: 1;
  }

  /* Beautiful floating tooltip */
  .social-tooltip {
    position: absolute;
    right: 100%;
    margin-right: 10px;
    top: 50%;
    transform: translateY(-50%) translateX(10px);
    padding: 4px 8px;
    border-radius: 6px;
    background: #0b0f19;
    border: 1px solid var(--structural-borders);
    color: var(--text-primary);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.02em;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(html[data-theme="light"]) .social-tooltip {
    background: #ffffff;
    border-color: rgba(0, 0, 0, 0.1);
    color: var(--text-primary);
    box-shadow: 0 8px 24px rgba(11, 30, 54, 0.1);
  }

  .social-item-wrapper:hover .social-tooltip {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
  }
</style>
