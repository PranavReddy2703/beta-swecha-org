---
// src/components/projects/FeaturedProjectsCarousel.astro
interface FeaturedProject {
  title: string;
  description: string;
  imageLabel: string;
  image?: string;
  link: string;
}

interface Props {
  projects: FeaturedProject[];
}

const { projects } = Astro.props;
---

<section class="py-12 bg-canvas-base border-b border-structural-borders/20 relative">
  <div class="container mx-auto px-4 mb-8">
    <h2 class="text-2xl md:text-3xl font-extrabold text-white flex items-center gap-3">
      <span class="w-1.5 h-6 bg-primary-brand rounded-full shadow-[0_0_10px_rgba(0,212,255,0.8)]"></span>
      Featured Projects
    </h2>
  </div>

  <!-- Carousel Container with CSS Scroll Snap -->
  <div class="w-full overflow-x-auto pb-8 snap-x snap-mandatory hide-scrollbar">
    <div class="flex gap-6 px-4 md:px-8 w-max">
      {projects.map((project, index) => (
        <a 
          href={project.link} 
          class="group relative flex-none w-[calc(100vw-2rem)] md:w-[calc(100vw-4rem)] max-w-6xl h-[400px] md:h-[500px] snap-center snap-always bg-secondary-bg border border-structural-borders rounded-2xl overflow-hidden transition-all duration-500 hover:border-primary-brand/60 hover:shadow-[0_0_30px_-5px_rgba(0,212,255,0.2)]"
        >
          <!-- Background Image/Pattern Layer -->
          <div class="absolute inset-0 bg-canvas-base">
            {project.image ? (
              <img src={project.image} alt={project.title} class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:opacity-80 transition-opacity duration-500" />
            ) : null}
            <div class="absolute inset-0 bg-gradient-to-t from-primary-brand/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-0"></div>
            <!-- Tech lines decoration -->
            <div class="absolute top-0 left-0 w-full h-full pointer-events-none opacity-20 z-0">
               <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
                  <defs>
                    <pattern id={`gridPattern-${index}`} width="60" height="60" patternUnits="userSpaceOnUse">
                      <path d="M 60 0 L 0 0 0 60" fill="none" stroke="currentColor" stroke-width="0.5" class="text-primary-brand"/>
                    </pattern>
                  </defs>
                  <rect width="100%" height="100%" fill={`url(#gridPattern-${index})`} />
               </svg>
            </div>
            
            {!project.image && (
              <span class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 text-primary-brand/20 font-mono text-2xl md:text-4xl tracking-widest uppercase z-10 pointer-events-none">
                [ {project.imageLabel} ]
              </span>
            )}
          </div>

          <!-- Gradient Overlay (black shade gradient from bottom to half) -->
          <div class="absolute inset-0 bg-gradient-to-t from-black via-black/80 to-transparent z-10"></div>

          <!-- Content Overlaid on Top -->
          <div class="absolute bottom-0 left-0 w-full p-6 md:p-12 z-20">
            <span class="inline-block px-3 py-1 mb-4 text-xs font-bold uppercase tracking-widest text-black bg-primary-brand rounded-full shadow-[0_0_15px_rgba(0,212,255,0.6)]">
              Featured Project
            </span>
            <h3 class="text-2xl md:text-4xl lg:text-5xl font-extrabold text-white mb-4 group-hover:text-primary-brand transition-colors duration-300">
              {project.title}
            </h3>
            <p class="text-base md:text-lg lg:text-xl text-slate-300 leading-relaxed max-w-3xl">
              {project.description}
            </p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  /* Hide scrollbar for Chrome, Safari and Opera */
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  /* Hide scrollbar for IE, Edge and Firefox */
  .hide-scrollbar {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }
</style>
