---
// src/components/projects/FeaturedProjectsCarousel.astro
import FeaturedProjectCard from '../molecules/FeaturedProjectCard.astro';

interface FeaturedProject {
  title: string;
  description: string;
  imageLabel: string;
  image?: string;
  link: string;
}

interface Props {
  projects: FeaturedProject[];
}

const { projects } = Astro.props;
---

<section class="py-12 border-b border-structural-borders/20 relative group/carousel">
  <div class="container mx-auto px-4 mb-8">
    <h2 class="text-2xl md:text-3xl font-extrabold text-white flex items-center gap-3">
      <span class="w-1.5 h-6 bg-secondary-accent rounded-full shadow-[0_0_10px_rgba(77,255,184,0.8)]"></span>
      Featured Projects
    </h2>
  </div>

  <!-- Centered Carousel Wrapper matching page grid alignment -->
  <div class="container mx-auto px-4 max-w-7xl relative">
    
    <!-- Floating Prev Button (Left side, only visible on hover) -->
    <button 
      id="featured-prev-btn"
      class="absolute top-[200px] md:top-[250px] -translate-y-1/2 z-30 hidden md:flex items-center justify-center p-2 text-text-muted/70 hover:text-secondary-accent transition-all duration-300 opacity-0 group-hover/carousel:opacity-100 cursor-pointer group/btn"
      aria-label="Previous project"
    >
      <svg class="h-10 w-10 md:h-12 md:w-12 transition-all duration-300 group-hover/btn:scale-110 filter drop-shadow-[0_0_8px_rgba(77,255,184,0)] group-hover/btn:drop-shadow-[0_0_8px_rgba(77,255,184,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
    </button>

    <!-- Floating Next Button (Right side, only visible on hover) -->
    <button 
      id="featured-next-btn"
      class="absolute top-[200px] md:top-[250px] -translate-y-1/2 z-30 hidden md:flex items-center justify-center p-2 text-text-muted/70 hover:text-secondary-accent transition-all duration-300 opacity-0 group-hover/carousel:opacity-100 cursor-pointer group/btn"
      aria-label="Next project"
    >
      <svg class="h-10 w-10 md:h-12 md:w-12 transition-all duration-300 group-hover/btn:scale-110 filter drop-shadow-[0_0_8px_rgba(77,255,184,0)] group-hover/btn:drop-shadow-[0_0_8px_rgba(77,255,184,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </button>

    <!-- Scroll Container -->
    <div class="projects-carousel-container w-full overflow-x-auto pb-6 snap-x snap-mandatory hide-scrollbar">
      <div class="projects-scroll-track flex gap-6 w-max">
        {projects.map((project) => (
          <FeaturedProjectCard
            title={project.title}
            description={project.description}
            imageLabel={project.imageLabel}
            image={project.image}
            link={project.link}
          />
        ))}
      </div>
    </div>

    <!-- Glowing Digital Bar Indicators -->
    <div class="flex items-center justify-center gap-2 mt-4 relative z-30 select-none">
      {projects.map((_, index) => (
        <button
          type="button"
          data-project-dot={index}
          class={`h-1 rounded-sm transition-all duration-300 cursor-pointer ${
            index === 0 ? 'bg-secondary-accent w-8 shadow-[0_0_8px_rgba(77,255,184,0.6)]' : 'bg-text-muted/30 hover:bg-text-muted/60 w-3'
          }`}
          aria-label={`Go to featured project ${index + 1}`}
        />
      ))}
    </div>
  </div>
</section>

<script>
  function initProjectsCarousel() {
    const carousel = document.querySelector('.projects-carousel-container');
    const track = carousel?.querySelector('.projects-scroll-track');
    const cards = track?.querySelectorAll('a');
    const dots = document.querySelectorAll('button[data-project-dot]');
    const prevBtn = document.getElementById('featured-prev-btn');
    const nextBtn = document.getElementById('featured-next-btn');

    if (!carousel || !cards || cards.length === 0) return;

    let currentIdx = 0;
    const totalCards = cards.length;
    let autoplayInterval: any = null;

    function scrollToCard(index: number) {
      if (index < 0) {
        currentIdx = totalCards - 1;
      } else if (index >= totalCards) {
        currentIdx = 0;
      } else {
        currentIdx = index;
      }

      const card = cards[currentIdx] as HTMLElement;
      if (card) {
        const targetScrollLeft = card.offsetLeft - (carousel.clientWidth - card.clientWidth) / 2;
        carousel.scrollTo({
          left: targetScrollLeft,
          behavior: 'smooth'
        });
      }
      updateDots();
    }

    function updateDots() {
      dots.forEach((dot, idx) => {
        if (idx === currentIdx) {
          dot.classList.remove('bg-text-muted/30', 'hover:bg-text-muted/60', 'w-3');
          dot.classList.add('bg-secondary-accent', 'w-8', 'shadow-[0_0_8px_rgba(77,255,184,0.6)]');
        } else {
          dot.classList.remove('bg-secondary-accent', 'w-8', 'shadow-[0_0_8px_rgba(77,255,184,0.6)]');
          dot.classList.add('bg-text-muted/30', 'hover:bg-text-muted/60', 'w-3');
        }
      });
    }

    function syncIndexOnScroll() {
      const scrollLeft = carousel.scrollLeft;
      const containerCenter = scrollLeft + carousel.clientWidth / 2;
      
      let closestIdx = 0;
      let minDiff = Infinity;

      cards.forEach((card, idx) => {
        const cardCenter = (card as HTMLElement).offsetLeft + (card as HTMLElement).clientWidth / 2;
        const diff = Math.abs(cardCenter - containerCenter);
        if (diff < minDiff) {
          minDiff = diff;
          closestIdx = idx;
        }
      });

      if (closestIdx !== currentIdx) {
        currentIdx = closestIdx;
        updateDots();
      }
    }

    // Scroll listener with a debounce to prevent stutter
    let scrollTimeout: any;
    carousel.addEventListener('scroll', () => {
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(syncIndexOnScroll, 100);
    });

    // Autoplay Cycle (every 4 seconds)
    function startAutoplay() {
      stopAutoplay();
      autoplayInterval = setInterval(() => {
        scrollToCard(currentIdx + 1);
      }, 4000);
    }

    function stopAutoplay() {
      if (autoplayInterval) {
        clearInterval(autoplayInterval);
      }
    }

    // Control triggers
    prevBtn?.addEventListener('click', () => {
      stopAutoplay();
      scrollToCard(currentIdx - 1);
      startAutoplay();
    });

    nextBtn?.addEventListener('click', () => {
      stopAutoplay();
      scrollToCard(currentIdx + 1);
      startAutoplay();
    });

    dots.forEach((dot, idx) => {
      dot.addEventListener('click', () => {
        stopAutoplay();
        scrollToCard(idx);
        startAutoplay();
      });
    });

    // Touch / interaction listeners to pause autoplay
    carousel.addEventListener('touchstart', stopAutoplay, { passive: true });
    carousel.addEventListener('touchend', startAutoplay, { passive: true });

    // Initial activation
    startAutoplay();

    // Stop autoplay when tab is inactive
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        stopAutoplay();
      } else {
        startAutoplay();
      }
    });
  }

  // Hook into Astro load lifecycle
  document.addEventListener('DOMContentLoaded', initProjectsCarousel);
  initProjectsCarousel();
</script>

<style>
  /* Hide scrollbar for Chrome, Safari and Opera */
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  /* Hide scrollbar for IE, Edge and Firefox */
  .hide-scrollbar {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }

  /* Responsive positioning for floating arrows to keep them away from the cards but on-screen */
  #featured-prev-btn {
    left: 0.5rem;
  }
  #featured-next-btn {
    right: 0.5rem;
  }

  @media (min-width: 1360px) {
    #featured-prev-btn {
      left: -2.5rem;
    }
    #featured-next-btn {
      right: -2.5rem;
    }
  }

  @media (min-width: 1440px) {
    #featured-prev-btn {
      left: -5rem;
    }
    #featured-next-btn {
      right: -5rem;
    }
  }

  @media (min-width: 1600px) {
    #featured-prev-btn {
      left: -7rem;
    }
    #featured-next-btn {
      right: -7rem;
    }
  }
</style>
