---
// src/components/events/FeaturedEvent.astro
import Button from '../atoms/Button.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';

interface Props {
  event: {
    slug: string;
    title: string;
    subtitle: string;
    shortDescription: string;
    image: string;
    date: string;
    venue: string;
    registrationLink: string;
    category: string;
  };
}

const { event } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<div class="group relative rounded-3xl border border-structural-borders/60 bg-card-bg/25 backdrop-blur-md overflow-hidden shadow-xl hover:border-primary-brand/30 transition-all duration-300">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-0">
    
    <!-- Cover Image with slight zoom effect on hover -->
    <div class="lg:col-span-7 relative h-64 sm:h-80 lg:h-auto overflow-hidden">
      <img 
        src={event.image} 
        alt={event.title} 
        class="w-full h-full object-cover object-center group-hover:scale-[1.015] transition-transform duration-700"
      />
      <!-- Gradient overlay for smooth transition into text content -->
      <div class="absolute inset-0 bg-gradient-to-t lg:bg-gradient-to-r from-canvas-base via-transparent to-transparent opacity-90"></div>
    </div>

    <!-- Content Area -->
    <div class="lg:col-span-5 p-8 sm:p-10 lg:p-12 flex flex-col justify-between space-y-6">
      <div class="space-y-4">
        <!-- Featured & Category Badges -->
        <div class="flex flex-wrap gap-2">
          <span class="inline-flex px-3 py-1 text-xs font-bold uppercase tracking-wider text-[#080B10] bg-primary-brand rounded-full shadow-[0_0_12px_rgba(0,212,255,0.2)] select-none">
            Featured
          </span>
          <span class="inline-flex px-3 py-1 text-xs font-bold uppercase tracking-wider text-secondary-accent bg-secondary-accent/15 border border-secondary-accent/30 rounded-full select-none">
            {event.category}
          </span>
        </div>
        
        <div class="space-y-1.5">
          <h2 class="text-2xl sm:text-3xl font-black text-text-main group-hover:text-primary-brand transition-colors duration-200">
            {event.title}
          </h2>
          <p class="text-sm font-semibold text-secondary-accent">
            {event.subtitle}
          </p>
        </div>
        
        <p class="text-sm sm:text-base text-text-muted leading-relaxed font-medium">
          {event.shortDescription}
        </p>

        <!-- Parameters -->
        <div class="flex flex-wrap gap-x-6 gap-y-2 text-xs font-bold uppercase text-text-muted pt-2 border-t border-structural-borders/20">
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-primary-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 002-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            {event.date}
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-primary-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            </svg>
            {event.venue}
          </span>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap gap-4 pt-2">
        <Button href={translatePath(`/events/${event.slug}#register-section`)} label={t('events.btn.register')} variant="primary" />
        <Button href={translatePath(`/events/${event.slug}`)} label={t('events.btn.viewEvent')} variant="secondary" />
      </div>
    </div>

  </div>
</div>
