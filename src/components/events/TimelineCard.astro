---
// src/components/events/TimelineCard.astro
import { getLangFromUrl, useTranslatedPath } from '../../i18n/utils';

interface Props {
  event: {
    slug: string;
    title: string;
    shortDescription: string;
    image: string;
    date: string;
    venue: string;
    category: string;
  };
  class?: string;
}

const { event, class: className = '' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);

// Specific design colors for each event category type
const getCategoryStyles = (category: string) => {
  const normalized = category.toLowerCase();
  if (normalized === 'ai') return 'bg-cyan-500/10 text-cyan-400 border-cyan-500/20';
  if (normalized === 'workshop') return 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20';
  if (normalized === 'hackathon') return 'bg-purple-500/10 text-purple-400 border-purple-500/20';
  if (normalized === 'meetup') return 'bg-amber-500/10 text-amber-400 border-amber-500/20';
  if (normalized === 'community') return 'bg-indigo-500/10 text-indigo-400 border-indigo-500/20';
  return 'bg-teal-500/10 text-teal-400 border-teal-500/20'; // open source default
};

const badgeClasses = getCategoryStyles(event.category);
---

<div class={`group flex flex-col w-full md:max-w-[460px] rounded-2xl border border-structural-borders/85 bg-card-bg/25 backdrop-blur-sm overflow-hidden hover:border-primary-brand/35 hover:-translate-y-1 hover:shadow-[0_12px_30px_rgba(0,212,255,0.03)] transition-all duration-300 ${className}`}>
  <!-- Cover Image with scale transition -->
  <div class="relative h-44 sm:h-48 overflow-hidden">
    <img 
      src={event.image} 
      alt={event.title} 
      class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-500"
    />
    <!-- Category Badge -->
    <div class="absolute top-4 left-4">
      <span class={`px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider rounded-full border ${badgeClasses}`}>
        {event.category}
      </span>
    </div>
  </div>

  <!-- Body Content -->
  <div class="p-6 md:p-8 flex flex-col justify-between flex-grow space-y-4">
    <div class="space-y-2.5">
      <span class="text-xs font-semibold text-secondary-accent uppercase block">
        {event.date}
      </span>
      <h3 class="text-lg md:text-xl font-bold text-text-main leading-tight group-hover:text-primary-brand transition-colors duration-200">
        {event.title}
      </h3>
      <p class="text-sm text-text-muted leading-relaxed font-medium line-clamp-3">
        {event.shortDescription}
      </p>
    </div>

    <!-- Footer Parameters and Action -->
    <div class="pt-4 border-t border-structural-borders/20 flex items-center justify-between text-xs font-semibold text-text-muted">
      <!-- Venue -->
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-primary-brand/70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
        </svg>
        {event.venue}
      </span>
      
      <!-- Link with arrow shift hover -->
      <a 
        href={translatePath(`/events/${event.slug}`)} 
        class="inline-flex items-center gap-1 text-primary-brand hover:text-hover-brand transition-all cursor-pointer font-bold"
      >
        View Event
        <svg class="w-3.5 h-3.5 transform group-hover:translate-x-0.5 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</div>
