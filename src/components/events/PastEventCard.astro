---
// src/components/events/PastEventCard.astro
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';

interface Props {
  event: {
    slug: string;
    title: string;
    image: string;
    date: string;
    venue: string;
  };
}

const { event } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<div class="group flex flex-col h-full rounded-2xl border border-structural-borders/50 bg-secondary-bg/40 overflow-hidden hover:border-secondary-accent/35 transition-all duration-300 shadow-md">
  
  <!-- Thumbnail with grayscale effect transitioning on hover -->
  <div class="relative h-36 overflow-hidden filter grayscale brightness-75 group-hover:grayscale-0 group-hover:brightness-90 transition-all duration-500">
    <img 
      src={event.image} 
      alt={event.title} 
      class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-500"
    />
  </div>
  
  <!-- Body Details -->
  <div class="p-5 flex flex-col justify-between flex-grow space-y-4">
    <div class="space-y-1">
      <span class="text-[10px] font-bold text-secondary-accent uppercase block">
        {event.date}
      </span>
      <h3 class="text-base font-bold text-text-main line-clamp-1 group-hover:text-secondary-accent transition-colors duration-200">
        {event.title}
      </h3>
    </div>

    <!-- Footer link -->
    <div class="flex items-center justify-between pt-2 border-t border-structural-borders/20">
      <span class="text-[11px] text-text-muted font-bold tracking-wide">{event.venue}</span>
      <a 
        href={translatePath(`/events/${event.slug}`)} 
        class="text-xs font-bold text-secondary-accent hover:text-emerald-400 inline-flex items-center gap-1 transition-colors cursor-pointer"
      >
        {t('events.btn.viewSummary')}
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>

</div>
