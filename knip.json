    "src/components/molecules/EventTimelineCard.astro",
    "src/components/types/index.ts",
    "src/i18n/ui.ts"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "@lhci/cli",
    "@secretlint/secretlint-rule-preset-recommend",
